---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConsultationCTA from '../../components/ConsultationCTA.astro';

const overseasServices = [
  {
    title: "University & Course Shortlisting",
    desc: "Data-driven matching based on your academic profile, GRE/IELTS scores, budget, location preferences, and post-study work visa opportunities."
  },
  {
    title: "SOP & LOR Editorial Guidance",
    desc: "Personalized reviews of your Statement of Purpose (SOP), Letters of Recommendation (LORs), and CV by admission specialists who know what university committees look for."
  },
  {
    title: "Scholarship & Financial Aid Strategy",
    desc: "Discover merit-based scholarships, graduate assistantships, and low-interest student education loan assistance with leading banking partners."
  },
  {
    title: "Visa Filing & Mock Interviews",
    desc: "Complete assistance with financial documentation, visa forms (DS-160, CAS, VFS), and rigorous mock visa interview preparation."
  },
  {
    title: "Pre-Departure & Forex Assistance",
    desc: "Guidance on student accommodation, medical insurance, international SIM cards, forex cards, and pre-departure cultural orientation."
  },
  {
    title: "Post-Arrival Community Network",
    desc: "Connect with our established alumni network in the US, UK, Canada, Germany, and Ireland for on-ground housing and part-time job guidance."
  }
];

const countries = [
  { name: "United States", flag: "🇺🇸", desc: "Top STEM OPT programs & Ivy League admissions" },
  { name: "United Kingdom", flag: "🇬🇧", desc: "1-year Masters & 2-year Graduate Route visa" },
  { name: "Canada", flag: "🇨🇦", desc: "PGWP work permits & high quality of life" },
  { name: "Germany", flag: "🇩🇪", desc: "Tuition-free public universities & engineering hubs" },
  { name: "Australia", flag: "🇦🇺", desc: "World-class Group of Eight universities" },
  { name: "Ireland", flag: "🇮🇪", desc: "European tech capital & generous stay-back option" }
];
---

<BaseLayout 
  title="Overseas Education Consulting | Knowletive" 
  description="End-to-end overseas education guidance across 15+ countries: university shortlisting, SOP review, scholarships, and visa processing at Knowletive."
>
  <!-- Hero -->
  <section class="relative page-header-spacing pb-14 md:pb-20 bg-[#0B1F3A] text-white overflow-hidden border-b border-white/10">
    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
      <div class="absolute inset-0" style="background-image: radial-gradient(#0878E8 1px, transparent 1px); background-size: 30px 30px;"></div>
    </div>

    <div class="container-custom relative z-10 text-center max-w-4xl mx-auto">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-blue-200 mb-6 bg-white/10 px-4 py-1.5 rounded-full backdrop-blur-sm">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/services" class="hover:text-white transition-colors">Services</a>
        <span>/</span>
        <span class="text-[#0878E8]">Overseas Education</span>
      </nav>

      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#0878E8]/20 border border-[#0878E8]/30 text-blue-200 font-bold text-xs tracking-widest uppercase mb-6 mx-auto">
        Global Admissions
      </div>

      <h1 class="fluid-hero font-manrope font-extrabold text-white mb-6">
        Study Abroad with Confidence.<br/>
        <span class="text-gradient-orange">Top Universities. Global Careers.</span>
      </h1>

      <p class="text-blue-100 text-lg md:text-xl max-w-2xl mx-auto leading-relaxed mb-10">
        From profile assessment and university selection to visa approval and pre-departure briefings, we make your dream of studying abroad a structured reality.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact" class="btn-primary w-full sm:w-auto px-8 py-4">Book Free Overseas Counseling</a>
        <a href="tel:+919970600116" class="btn-secondary w-full sm:w-auto px-8 py-4 flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          Speak with Study Abroad Expert
        </a>
      </div>
    </div>
  </section>

  <!-- Popular Study Destinations -->
  <section class="py-16 bg-white border-b border-gray-100">
    <div class="container-custom">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl md:text-3xl font-manrope font-bold text-[#0B1F3A]">Top Study Destinations</h2>
        <p class="text-[#64748B] text-sm mt-2">Explore premier global study hubs with high graduate employability.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {countries.map(c => (
          <div class="p-6 rounded-2xl bg-gray-50 border border-gray-200 hover:border-[#0878E8] transition-colors">
            <div class="text-3xl mb-3">{c.flag}</div>
            <h3 class="font-bold text-lg text-[#0B1F3A] mb-1">{c.name}</h3>
            <p class="text-xs text-[#64748B]">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="section-padding bg-[#F7F9FC]">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#0878E8]/10 text-[#0878E8] font-bold text-xs tracking-widest uppercase mb-4">
          End-to-End Support
        </div>
        <h2 class="fluid-h2 text-[#0B1F3A] mb-4">Our Step-by-Step Global Process</h2>
        <p class="text-[#64748B] text-base md:text-lg">We manage the complexities so you can focus on your academic journey.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {overseasServices.map((srv, idx) => (
          <div class="card-premium border border-gray-200 flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-blue-50 text-[#0878E8] font-manrope font-extrabold text-lg flex items-center justify-center mb-6">
                0{idx + 1}
              </div>
              <h3 class="text-xl font-bold text-[#0B1F3A] mb-3">{srv.title}</h3>
              <p class="text-[#64748B] text-sm leading-relaxed mb-6">{srv.desc}</p>
            </div>
            <a href="/contact" class="text-[#0878E8] font-semibold text-sm flex items-center gap-1 hover:gap-2 transition-all">
              Consult Counselor →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ConsultationCTA />
</BaseLayout>
