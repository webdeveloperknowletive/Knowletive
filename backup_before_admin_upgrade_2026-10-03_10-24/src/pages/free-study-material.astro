---
import BaseLayout from '../layouts/BaseLayout.astro';
import EbookCTA from '../components/EbookCTA.astro';

const pageTitle = "Free Study Material & Resources | Knowletive";
const pageDescription = "Access free study materials, cheat sheets, interview questions, and our comprehensive career guide to accelerate your professional growth.";

const categories = [
  "Data Analysis",
  "Data Science",
  "MERN Stack",
  "Java",
  "Cloud & DevOps",
  "Banking",
  "Digital Marketing",
  "Interview Preparation",
  "Aptitude & Career"
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="relative bg-[#0B1F3A] pt-32 pb-20 overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
      <div class="absolute inset-0" style="background-image: radial-gradient(#F47A16 1px, transparent 1px); background-size: 30px 30px;"></div>
    </div>
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-[#0878E8]/20 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="container-custom relative z-10 text-center max-w-4xl mx-auto">
      <nav aria-label="Breadcrumb" class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-blue-200 mb-6 bg-white/10 px-4 py-1.5 rounded-full backdrop-blur-sm">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">Free Study Material</span>
      </nav>

      <h1 class="fluid-hero font-manrope font-extrabold text-white mb-6">
        Free Learning <br/>
        <span class="text-gradient-orange">Resources & Guides</span>
      </h1>

      <p class="text-blue-100/90 text-lg md:text-xl max-w-3xl mx-auto leading-relaxed mb-10">
        Download high-quality study materials, cheat sheets, and interview prep guides to master in-demand skills and accelerate your career.
      </p>
    </div>
  </section>

  <!-- Career Guide Ebook -->
  <div class="bg-[#F7F9FC]">
    <EbookCTA />
  </div>

  <!-- Resource Library Grid -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#0878E8]/10 text-[#0878E8] font-bold text-xs tracking-widest uppercase mb-4">
          Library
        </div>
        <h2 class="fluid-h2 text-[#0B1F3A] mb-4">Browse by <span class="text-[#0878E8]">Category</span></h2>
        <p class="text-[#64748B] text-base md:text-lg">
          Select a subject to find related PDFs, notes, and practice exercises.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {categories.map((category) => (
          <div class="bg-gray-50 border border-gray-100 rounded-2xl p-6 hover:shadow-md transition-shadow group relative overflow-hidden">
            <h3 class="text-lg font-bold text-[#0B1F3A] mb-2">{category}</h3>
            <p class="text-sm text-[#64748B] mb-4">Check back soon for latest notes, interview questions, and cheat sheets.</p>
            <div class="text-[#0878E8] font-semibold text-sm flex items-center gap-1 group-hover:gap-2 transition-all">
              Coming Soon <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </div>
          </div>
        ))}
      </div>
      
      <!-- CET & Legacy Links if needed -->
      <div class="mt-16 bg-[#0B1F3A] text-white rounded-3xl p-8 md:p-12 text-center shadow-xl">
        <h3 class="text-2xl font-bold font-manrope mb-4">Looking for CET 2026 Resources?</h3>
        <p class="text-blue-200 mb-8 max-w-2xl mx-auto">We still have all the documents and information required for CET 2026 admissions.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/cet" class="btn-primary px-8 py-3 w-full sm:w-auto">View CET 2026 Information</a>
          <a href="/cet-documents" class="bg-white/10 hover:bg-white/20 text-white px-8 py-3 rounded-xl font-bold transition-colors w-full sm:w-auto border border-white/10">Download Required Documents</a>
        </div>
      </div>
      
    </div>
  </section>

</BaseLayout>
