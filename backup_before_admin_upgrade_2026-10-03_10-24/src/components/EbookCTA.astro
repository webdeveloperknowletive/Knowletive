---
---
<section class="py-0 relative my-8 md:my-14">
  <div class="container-custom">
    <div class="bg-gradient-to-br from-[#0B1F3A] to-[#072B6F] rounded-3xl overflow-hidden shadow-2xl border border-[#0878E8]/20 relative">
      
      <!-- Background glow -->
      <div class="absolute top-[-20%] right-[-10%] w-[500px] h-[500px] bg-[#0878E8]/20 rounded-full blur-[100px] pointer-events-none"></div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 p-8 sm:p-10 md:p-16 items-center relative z-10">
        
        <!-- Left Content -->
        <div>
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#F47A16]/20 text-[#F47A16] font-bold text-xs tracking-widest uppercase mb-6 border border-[#F47A16]/30">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            Free Career Guide
          </div>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-manrope font-extrabold text-white mb-4 leading-tight">
            Make Smarter<br/>
            <span class="text-gradient-orange">Career Decisions.</span>
          </h2>
          <p class="text-blue-100 text-base md:text-lg mb-8 max-w-md leading-relaxed">
            Download Knowletive's comprehensive 7-page guide covering technical roadmaps, internship frameworks, overseas pathways, and placement strategies.
          </p>
          
          <div id="ebook-success" class="hidden p-6 rounded-2xl bg-white/10 border border-green-400/40 text-white space-y-3 max-w-md">
            <div class="flex items-center gap-3 text-green-400 font-bold text-lg">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <span>Download Ready!</span>
            </div>
            <p class="text-blue-100 text-sm">
              Your free copy of the Knowletive Career & Services Guide is downloading now.
            </p>
            <a 
              href="/downloads/Knowletive_Career_Guide.pdf" 
              download 
              class="btn-primary inline-flex items-center justify-center gap-2 w-full py-3 text-sm font-bold shadow-lg"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
              Click Here If Download Didn't Start
            </a>
          </div>

          <form class="space-y-4 max-w-sm" id="ebook-form">
            <div>
              <label for="ebook-name" class="sr-only">Full Name</label>
              <input type="text" id="ebook-name" name="name" required placeholder="Full Name" class="w-full px-5 py-3.5 bg-white/5 border border-white/10 rounded-xl text-white placeholder-blue-200/50 focus:outline-none focus:border-[#F47A16] focus:bg-white/10 transition-colors" autocomplete="name" />
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="ebook-email" class="sr-only">Email Address</label>
                <input type="email" id="ebook-email" name="email" required placeholder="Email Address" class="w-full px-5 py-3.5 bg-white/5 border border-white/10 rounded-xl text-white placeholder-blue-200/50 focus:outline-none focus:border-[#F47A16] focus:bg-white/10 transition-colors" autocomplete="email" />
              </div>
              <div>
                <label for="ebook-phone" class="sr-only">Phone Number</label>
                <input type="tel" id="ebook-phone" name="phone" required placeholder="Phone Number" class="w-full px-5 py-3.5 bg-white/5 border border-white/10 rounded-xl text-white placeholder-blue-200/50 focus:outline-none focus:border-[#F47A16] focus:bg-white/10 transition-colors" autocomplete="tel" />
              </div>
            </div>
            
            <p id="ebook-error" class="text-xs text-red-400 hidden"></p>

            <button type="submit" id="ebook-submit" class="btn-primary w-full justify-center mt-2 group py-3.5">
              <span>Download Free eBook</span>
              <svg class="w-5 h-5 group-hover:translate-y-1 transition-transform ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            </button>
            <p class="text-xs text-blue-200/50 text-center mt-3">We respect your privacy. Instant PDF access.</p>
          </form>
        </div>

        <!-- Right Visual -->
        <div class="relative flex justify-center lg:justify-end">
          <div class="w-full max-w-[320px] aspect-[3/4] bg-white rounded-r-3xl rounded-l-md shadow-2xl rotate-3 hover:rotate-0 transition-transform duration-500 border border-gray-200 p-2 relative">
             <div class="absolute inset-y-0 left-0 w-6 bg-gradient-to-r from-gray-200 to-transparent rounded-l-md opacity-50 z-20 pointer-events-none"></div>
             
             <div class="w-full h-full bg-[#072B6F] rounded-r-2xl rounded-l-sm flex flex-col items-center justify-between p-6 text-center text-white relative overflow-hidden">
                <div class="w-full text-left">
                  <span class="text-xs font-bold tracking-widest text-[#F47A16] uppercase">Knowletive Press</span>
                </div>

                <div>
                  <div class="w-14 h-14 bg-white/10 rounded-2xl flex items-center justify-center mb-4 mx-auto border border-white/20">
                     <svg class="w-7 h-7 text-[#F47A16]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                  </div>
                  <h3 class="font-manrope font-extrabold text-2xl mb-2 text-white">The Ultimate Career & Services Guide</h3>
                  <p class="text-blue-200 text-xs">Training Minds. Placing Talents.</p>
                </div>
                
                <div class="w-full border-t border-white/10 pt-4 flex items-center justify-between text-xs text-blue-200/80">
                  <span>Edition 2026</span>
                  <span class="text-green-400 font-semibold">Free Edition</span>
                </div>
             </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  const ebForm = document.getElementById('ebook-form') as HTMLFormElement | null;
  const ebSuccess = document.getElementById('ebook-success') as HTMLDivElement | null;
  const ebError = document.getElementById('ebook-error') as HTMLParagraphElement | null;
  const ebSubmit = document.getElementById('ebook-submit') as HTMLButtonElement | null;

  if (ebForm && ebSuccess && ebError && ebSubmit) {
    ebForm.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = (document.getElementById('ebook-name') as HTMLInputElement)?.value.trim();
      const email = (document.getElementById('ebook-email') as HTMLInputElement)?.value.trim();
      const phone = (document.getElementById('ebook-phone') as HTMLInputElement)?.value.trim();

      if (!name || !email || !phone) {
        ebError.textContent = 'Please fill out all fields.';
        ebError.classList.remove('hidden');
        return;
      }

      if (!email.includes('@') || !email.includes('.')) {
        ebError.textContent = 'Please enter a valid email address.';
        ebError.classList.remove('hidden');
        return;
      }

      const digitsOnly = phone.replace(/\D/g, '');
      if (digitsOnly.length < 7) {
        ebError.textContent = 'Please enter a valid phone number.';
        ebError.classList.remove('hidden');
        return;
      }

      ebError.classList.add('hidden');
      ebSubmit.disabled = true;
      ebSubmit.textContent = 'Preparing Download...';

      setTimeout(() => {
        // Hide form, show success
        ebForm.classList.add('hidden');
        ebSuccess.classList.remove('hidden');

        // Automatically trigger PDF download
        const downloadLink = document.createElement('a');
        downloadLink.href = '/downloads/Knowletive_Career_Guide.pdf';
        downloadLink.download = 'Knowletive_Career_Guide.pdf';
        document.body.appendChild(downloadLink);
        downloadLink.click();
        document.body.removeChild(downloadLink);
      }, 600);
    });
  }
</script>
