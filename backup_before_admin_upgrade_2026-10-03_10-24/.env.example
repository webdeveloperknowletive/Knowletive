# Knowletive Environment Variables
# Copy this file to .env and replace the values with your production credentials

# Web3Forms API Key for Contact Form submissions
# Obtain your free or pro access key from https://web3forms.com
PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here

# Site URL for canonical and metadata generation
PUBLIC_SITE_URL=https://knowletive.com
