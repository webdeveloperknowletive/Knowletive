---
---
<section id="pep" class="section-padding bg-[#072B6F] relative overflow-hidden text-white border-y border-white/10">
  <!-- Accents -->
  <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-[#0878E8]/10 rounded-full blur-[120px] -z-10 translate-x-1/3 -translate-y-1/3"></div>
  <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-[#F47A16]/10 rounded-full blur-[100px] -z-10 -translate-x-1/3 translate-y-1/3"></div>

  <div class="container-custom relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <!-- Content Left -->
      <div>
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#F47A16]/20 border border-[#F47A16]/30 text-[#F47A16] font-bold text-xs tracking-widest uppercase mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-[#F47A16] animate-pulse"></span>
          Flagship Program
        </div>
        
        <h2 class="fluid-h2 text-white mb-6">
          Professional Enhancement<br/>
          <span class="text-gradient-orange">Program (PEP)</span>
        </h2>
        
        <p class="text-lg text-blue-100 mb-10 leading-relaxed max-w-xl">
          A career acceleration program combining structured professional training, real-world internship exposure, and personalized mentorship to make you career-ready from day one.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center gap-4">
          <a href="/internship-jobs" class="btn-primary w-full sm:w-auto">Explore Programs & Jobs</a>
          <a href="/contact" class="btn-outline text-white border-white/20 hover:border-white hover:text-white w-full sm:w-auto">Talk to an Advisor</a>
        </div>
      </div>
      
      <!-- Stages Right -->
      <div class="relative">
        <div class="absolute left-6 md:left-[3.25rem] top-8 bottom-8 w-px bg-gradient-to-b from-[#F47A16] to-[#0878E8] opacity-50 z-0 hidden sm:block"></div>
        
        <div class="flex flex-col gap-6 relative z-10">
          
          <!-- Stage 1 -->
          <div class="flex items-start gap-4 sm:gap-6 group">
            <div class="w-12 h-12 sm:w-14 sm:h-14 shrink-0 rounded-full bg-[#0B1F3A] border-2 border-[#F47A16] flex items-center justify-center text-[#F47A16] font-bold text-lg shadow-[0_0_15px_rgba(244,122,22,0.3)] group-hover:scale-110 group-hover:bg-[#F47A16] group-hover:text-white transition-all duration-300">
              01
            </div>
            <div class="bg-white/5 border border-white/10 rounded-2xl p-5 sm:p-6 hover:bg-white/10 transition-colors flex-1">
              <h4 class="text-xl font-bold mb-2 text-white">Industry-Aligned Skill Training</h4>
              <p class="text-blue-200/80 text-sm leading-relaxed">Master the exact technical and soft skills demanded by top employers in today's market.</p>
            </div>
          </div>
          
          <!-- Stage 2 -->
          <div class="flex items-start gap-4 sm:gap-6 group">
            <div class="w-12 h-12 sm:w-14 sm:h-14 shrink-0 rounded-full bg-[#0B1F3A] border-2 border-[#F47A16] flex items-center justify-center text-[#F47A16] font-bold text-lg group-hover:scale-110 group-hover:bg-[#F47A16] group-hover:text-white transition-all duration-300">
              02
            </div>
            <div class="bg-white/5 border border-white/10 rounded-2xl p-5 sm:p-6 hover:bg-white/10 transition-colors flex-1">
              <h4 class="text-xl font-bold mb-2 text-white">Internship Experience</h4>
              <p class="text-blue-200/80 text-sm leading-relaxed">Gain hands-on exposure working on live projects and collaborating with experienced professionals.</p>
            </div>
          </div>
          
          <!-- Stage 3 -->
          <div class="flex items-start gap-4 sm:gap-6 group">
            <div class="w-12 h-12 sm:w-14 sm:h-14 shrink-0 rounded-full bg-[#0B1F3A] border-2 border-[#0878E8] flex items-center justify-center text-[#0878E8] font-bold text-lg group-hover:scale-110 group-hover:bg-[#0878E8] group-hover:text-white transition-all duration-300">
              03
            </div>
            <div class="bg-white/5 border border-white/10 rounded-2xl p-5 sm:p-6 hover:bg-white/10 transition-colors flex-1">
              <h4 class="text-xl font-bold mb-2 text-white">1-on-1 Expert Mentorship</h4>
              <p class="text-blue-200/80 text-sm leading-relaxed">Receive personalized guidance and feedback from industry veterans throughout your journey.</p>
            </div>
          </div>
          
          <!-- Stage 4 -->
          <div class="flex items-start gap-4 sm:gap-6 group">
            <div class="w-12 h-12 sm:w-14 sm:h-14 shrink-0 rounded-full bg-[#0B1F3A] border-2 border-[#0878E8] flex items-center justify-center text-[#0878E8] font-bold text-lg shadow-[0_0_15px_rgba(8,120,232,0.3)] group-hover:scale-110 group-hover:bg-[#0878E8] group-hover:text-white transition-all duration-300">
              04
            </div>
            <div class="bg-white/5 border border-white/10 rounded-2xl p-5 sm:p-6 hover:bg-white/10 transition-colors flex-1">
              <h4 class="text-xl font-bold mb-2 text-white">Certification & Career Readiness</h4>
              <p class="text-blue-200/80 text-sm leading-relaxed">Earn recognized certifications and step into the professional world with confidence and a strong portfolio.</p>
            </div>
          </div>

        </div>
      </div>
      
    </div>
  </div>
</section>
