---
---
<section id="services" class="section-padding bg-gray-50 relative">
  <!-- Dynamic Service Marquee -->
  <div class="w-full overflow-hidden bg-[#072B6F] py-4 mb-20">
    <div class="flex whitespace-nowrap animate-[marquee_30s_linear_infinite]">
      <div class="flex items-center gap-8 px-4 text-white/90 font-manrope font-semibold tracking-wider uppercase text-sm">
        <span>Career Guidance</span><span class="text-[#F47A16]">•</span>
        <span>Data Science</span><span class="text-[#F47A16]">•</span>
        <span>AI & ML</span><span class="text-[#F47A16]">•</span>
        <span>Data Analytics</span><span class="text-[#F47A16]">•</span>
        <span>MERN Stack</span><span class="text-[#F47A16]">•</span>
        <span>Java Full Stack</span><span class="text-[#F47A16]">•</span>
        <span>Overseas Education</span><span class="text-[#F47A16]">•</span>
        <span>PEP Program</span><span class="text-[#F47A16]">•</span>
        <span>Internship Support</span><span class="text-[#F47A16]">•</span>
        <span>Placement Assistance</span><span class="text-[#F47A16]">•</span>
        <span>Business Consultation</span><span class="text-[#F47A16]">•</span>
        <!-- Duplicated for seamless loop -->
        <span>Career Guidance</span><span class="text-[#F47A16]">•</span>
        <span>Data Science</span><span class="text-[#F47A16]">•</span>
        <span>AI & ML</span><span class="text-[#F47A16]">•</span>
        <span>Data Analytics</span><span class="text-[#F47A16]">•</span>
        <span>MERN Stack</span><span class="text-[#F47A16]">•</span>
        <span>Java Full Stack</span><span class="text-[#F47A16]">•</span>
        <span>Overseas Education</span><span class="text-[#F47A16]">•</span>
        <span>PEP Program</span><span class="text-[#F47A16]">•</span>
        <span>Internship Support</span><span class="text-[#F47A16]">•</span>
        <span>Placement Assistance</span><span class="text-[#F47A16]">•</span>
        <span>Business Consultation</span>
      </div>
    </div>
  </div>

  <div class="container-custom">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-full bg-[#0878E8]/10 text-[#0878E8] font-bold text-xs tracking-widest uppercase mb-4 border border-[#0878E8]/20">
        Our Expertise
      </div>
      <h2 class="fluid-h2 mb-4">
        More Than Training.<br/>
        <span class="text-gradient">A Complete Career Growth Ecosystem.</span>
      </h2>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Card 1: Large -->
      <a href="/services/career-admission-counselling" class="card-premium group lg:col-span-2 lg:row-span-2 bg-[#0B1F3A] border-none text-white overflow-hidden relative min-h-[400px]">
        <div class="absolute inset-0 bg-gradient-to-br from-[#0878E8]/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative z-10 h-full flex flex-col justify-between">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center mb-6 text-[#0878E8] group-hover:scale-110 transition-transform duration-300">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
            <h3 class="text-2xl md:text-3xl font-manrope font-bold text-white mb-4">01 Career Guidance</h3>
            <p class="text-gray-300 text-lg max-w-md leading-relaxed">
              Personalized counseling to discover the right path. Aptitude assessments, goal-setting, and a clear roadmap tailored to your unique strengths and ambitions.
            </p>
          </div>
          <div class="flex items-center gap-2 text-[#F47A16] font-semibold mt-8 group-hover:gap-4 transition-all">
            Learn More <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </div>
        </div>
      </a>

      <!-- Card 2 -->
      <a href="/services" class="card-premium group relative min-h-[200px] flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-orange-50 flex items-center justify-center mb-4 text-[#F47A16] group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">02 Business Edu. Consulting</h3>
          <p class="text-sm text-[#64748B] leading-relaxed mb-6">
            Expert guidance for MBA, executive programs, and business certifications aligned with your goals.
          </p>
        </div>
        <div class="flex items-center gap-2 text-[#0878E8] font-semibold text-sm group-hover:gap-3 transition-all">
          Learn More <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </div>
      </a>

      <!-- Card 3 -->
      <a href="/services/overseas-education" class="card-premium group relative min-h-[200px] flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center mb-4 text-[#0878E8] group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">03 Overseas Education</h3>
          <p class="text-sm text-[#64748B] leading-relaxed mb-6">
            End-to-end support across 15+ countries—from university shortlisting to visa and post-arrival help.
          </p>
        </div>
        <div class="flex items-center gap-2 text-[#0878E8] font-semibold text-sm group-hover:gap-3 transition-all">
          Learn More <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </div>
      </a>

      <!-- Card 4 -->
      <a href="/contact" class="card-premium group relative min-h-[200px] flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-green-50 flex items-center justify-center mb-4 text-green-600 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">04 Education Guidance</h3>
          <p class="text-sm text-[#64748B] leading-relaxed mb-6">
            Academic counseling for all levels. Get matched with the right course and scholarship.
          </p>
        </div>
        <div class="flex items-center gap-2 text-green-600 font-semibold text-sm group-hover:gap-3 transition-all">
          Learn More <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </div>
      </a>

      <!-- Card 5 -->
      <a href="/contact" class="card-premium group relative min-h-[200px] flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-purple-50 flex items-center justify-center mb-4 text-purple-600 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">05 Admission Counseling</h3>
          <p class="text-sm text-[#64748B] leading-relaxed mb-6">
            SOP writing, interview prep, and application strategy for top institutions worldwide.
          </p>
        </div>
        <div class="flex items-center gap-2 text-purple-600 font-semibold text-sm group-hover:gap-3 transition-all">
          Learn More <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </div>
      </a>

      <!-- Card 6 -->
      <a href="/services" class="card-premium group relative min-h-[200px] flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-red-50 flex items-center justify-center mb-4 text-red-500 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">06 Business Consultation</h3>
          <p class="text-sm text-[#64748B] leading-relaxed mb-6">
            Strategic consulting for startups and enterprises—business planning, market entry, and growth.
          </p>
        </div>
        <div class="flex items-center gap-2 text-red-500 font-semibold text-sm group-hover:gap-3 transition-all">
          Learn More <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </div>
      </a>

    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-\[marquee_30s_linear_infinite\] {
      animation: none;
    }
  }
</style>
