---
---
<section id="hero" class="relative page-header-spacing overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute inset-0 z-0">
    <!-- Grid Pattern -->
    <div class="absolute inset-0" style="background-image: linear-gradient(rgba(7, 43, 111, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(7, 43, 111, 0.03) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);"></div>
    
    <!-- Orbs -->
    <div class="absolute top-[-20%] left-[-10%] w-[600px] h-[600px] rounded-full bg-[#0878E8]/10 blur-[100px]"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[500px] h-[500px] rounded-full bg-[#F47A16]/10 blur-[100px]"></div>
  </div>

  <div class="container-custom relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-8 items-center">
      
      <!-- Content Left -->
      <div class="flex flex-col items-start max-w-2xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#F47A16]/10 border border-[#F47A16]/20 text-[#F47A16] font-bold text-xs tracking-widest uppercase mb-5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#F47A16] animate-pulse"></span>
          Your Growth Partner Since Day One
        </div>
        
        <h1 class="font-manrope font-extrabold text-[#0B1F3A] mb-4 text-[clamp(38px,5vw,78px)] leading-[1.05] tracking-tight">
          <span class="block md:whitespace-nowrap">Guiding Careers.</span>
          <span class="block md:whitespace-nowrap text-gradient-orange">Shaping Futures.</span>
          <span class="block md:whitespace-nowrap">Growing Business.</span>
        </h1>
        
        <p class="text-lg md:text-xl text-[#64748B] mb-8 leading-relaxed max-w-[540px]">
          Industry-relevant training, expert career guidance, overseas education support and business consulting designed to turn ambition into real-world success.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
          <a href="/#courses" class="btn-primary w-full sm:w-auto text-center justify-center min-h-[48px] flex items-center px-8">Explore Programs</a>
          <a href="/contact" class="btn-secondary w-full sm:w-auto text-center justify-center min-h-[48px] flex items-center px-8">Free Consultation</a>
        </div>
        
        <div class="mt-6 flex items-center gap-2">
          <a href="/#placements" class="text-sm font-semibold text-[#0B1F3A] hover:text-[#0878E8] flex items-center gap-1 transition-colors">
            View Our Success Stories 
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </div>
      </div>
      
      <!-- Visual Right -->
      <!-- Visual Right -->
      <div class="relative w-full flex flex-col gap-6 mt-8 lg:mt-0">
        <div class="relative w-full aspect-[4/3] sm:aspect-[16/9] lg:h-[520px] lg:aspect-auto rounded-3xl overflow-hidden shadow-2xl z-10 border border-white/50">
          <img src="/images/hero-students.jpg" alt="Students learning and collaborating at Knowletive" width="600" height="600" fetchpriority="high" class="w-full h-full object-cover object-center block" />
        </div>
        
        <!-- Floating Cards (Mobile Stacked, Desktop Absolute) -->
        <div class="flex flex-col sm:flex-row gap-4 lg:block w-full">
          <!-- Stat 1 -->
          <div class="lg:absolute lg:-left-8 lg:top-4 bg-white p-4 lg:p-5 rounded-2xl shadow-xl border border-gray-100 z-20 flex items-center gap-4 lg:animate-[bounce_5s_ease-in-out_infinite] w-full lg:w-auto">
            <div class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center text-[#0878E8] shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            </div>
            <div>
              <p class="text-2xl font-manrope font-bold text-[#0B1F3A] leading-tight">5,000+</p>
              <p class="text-[11px] text-[#64748B] font-bold uppercase tracking-wider mt-0.5">Students Guided</p>
            </div>
          </div>

          <!-- Stat 2 -->
          <div class="lg:absolute lg:-right-8 lg:bottom-10 bg-white p-4 lg:p-5 rounded-2xl shadow-xl border border-gray-100 z-20 flex items-center gap-4 lg:animate-[bounce_6s_ease-in-out_infinite] lg:[animation-delay:1s] w-full lg:w-auto">
            <div class="w-12 h-12 rounded-xl bg-orange-50 flex items-center justify-center text-[#F47A16] shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div>
              <p class="text-2xl font-manrope font-bold text-[#0B1F3A] leading-tight">1,200+</p>
              <p class="text-[11px] text-[#64748B] font-bold uppercase tracking-wider mt-0.5">Placements</p>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<!-- Trust Strip -->
<div class="border-y border-gray-200 bg-white py-6 overflow-hidden relative">
  <div class="container-custom">
    <div class="flex items-center justify-between gap-6 overflow-x-auto pb-2 md:pb-0 scrollbar-hide md:flex-wrap">
      <div class="flex items-center gap-3 shrink-0">
        <div class="w-10 h-10 rounded-full bg-[#0878E8]/10 flex items-center justify-center text-[#0878E8]"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
        <span class="font-semibold text-sm text-[#0B1F3A]">Industry-focused curriculum</span>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <div class="w-10 h-10 rounded-full bg-[#0878E8]/10 flex items-center justify-center text-[#0878E8]"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg></div>
        <span class="font-semibold text-sm text-[#0B1F3A]">Experienced trainers</span>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <div class="w-10 h-10 rounded-full bg-[#0878E8]/10 flex items-center justify-center text-[#0878E8]"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg></div>
        <span class="font-semibold text-sm text-[#0B1F3A]">Placement assistance</span>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <div class="w-10 h-10 rounded-full bg-[#0878E8]/10 flex items-center justify-center text-[#0878E8]"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg></div>
        <span class="font-semibold text-sm text-[#0B1F3A]">Certifications</span>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <div class="w-10 h-10 rounded-full bg-[#0878E8]/10 flex items-center justify-center text-[#0878E8]"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg></div>
        <span class="font-semibold text-sm text-[#0B1F3A]">Lifetime guidance</span>
      </div>
    </div>
  </div>
</div>

<style>
  .scrollbar-hide::-webkit-scrollbar {
      display: none;
  }
  .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
  }
</style>
