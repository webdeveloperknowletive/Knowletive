---
// ============================================================
// /admin/media
// Media Library - Upload, Preview & File Asset Management
// ============================================================

import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../lib/db';

const mediaList = await db.getMedia();
---

<AdminLayout title="Media Library" activeNav="media">
  
  <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <h2 class="text-lg font-bold font-manrope text-[#0B1F3A]">Uploaded Media Assets</h2>
      <p class="text-xs text-[#64748B]">Manage course thumbnails, event photographs, documents, and videos.</p>
    </div>
    
    <button 
      id="open-upload-modal"
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#0878E8] hover:bg-[#0764c2] text-white text-xs font-bold transition-all shadow-sm cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
      Upload File
    </button>
  </div>

  <!-- Media Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
    {mediaList.map(item => (
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-3 flex flex-col justify-between group">
        <div>
          <div class="aspect-square rounded-xl bg-gray-50 border border-gray-100 overflow-hidden flex items-center justify-center relative mb-2">
            {item.type === 'image' || item.type === 'poster' ? (
              <img src={item.file_url} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
            ) : item.type === 'video' ? (
              <div class="text-[#0878E8] flex flex-col items-center">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                <span class="text-[10px] font-bold mt-1">MP4 Video</span>
              </div>
            ) : (
              <div class="text-gray-500 flex flex-col items-center">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                <span class="text-[10px] font-bold mt-1">Document</span>
              </div>
            )}
          </div>
          <p class="text-xs font-bold text-[#0B1F3A] truncate" title={item.title}>{item.title}</p>
          <span class="text-[10px] text-gray-400 block">{(item.file_size / 1024).toFixed(0)} KB · {item.type}</span>
        </div>

        <div class="pt-2 border-t border-gray-50 flex items-center justify-between gap-1 mt-2">
          <button 
            data-url={item.file_url} 
            class="copy-url-btn text-[11px] font-bold text-[#0878E8] hover:underline"
          >
            Copy URL
          </button>
          <button 
            data-delete-media-id={item.id} 
            class="delete-media-btn p-1 text-red-400 hover:text-red-600 transition-colors"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
          </button>
        </div>
      </div>
    ))}

    {mediaList.length === 0 && (
      <div class="col-span-full p-16 text-center text-sm text-gray-400 bg-white rounded-2xl border border-gray-100">
        No files uploaded to the media library yet.
      </div>
    )}
  </div>

  <!-- Upload Modal -->
  <div id="upload-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 md:p-8 w-full max-w-md shadow-2xl">
      <h3 class="text-lg font-bold font-manrope text-[#0B1F3A] mb-4">Upload Media File</h3>
      
      <form id="upload-form" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Title / Caption *</label>
          <input type="text" id="upload-title" required placeholder="e.g. Pune Campus Drive Poster" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Select File (Image, Video, Document)</label>
          <input type="file" id="upload-file" required class="w-full text-xs text-gray-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-[#0878E8] hover:file:bg-blue-100" />
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button type="button" id="close-upload-modal" class="px-4 py-2 border border-gray-200 text-xs font-semibold rounded-xl hover:bg-gray-50">Cancel</button>
          <button type="submit" id="upload-submit-btn" class="px-5 py-2 bg-[#0878E8] hover:bg-[#0764c2] text-white text-xs font-bold rounded-xl">Upload Now</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const modal = document.getElementById('upload-modal');
    document.getElementById('open-upload-modal')?.addEventListener('click', () => modal?.classList.remove('hidden'));
    document.getElementById('close-upload-modal')?.addEventListener('click', () => modal?.classList.add('hidden'));

    document.getElementById('upload-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = (document.getElementById('upload-title') as HTMLInputElement).value;
      const file = (document.getElementById('upload-file') as HTMLInputElement).files?.[0];
      const btn = document.getElementById('upload-submit-btn') as HTMLButtonElement;

      if (!file) return;

      btn.disabled = true;
      btn.textContent = 'Uploading...';

      const formData = new FormData();
      formData.append('title', title);
      formData.append('file', file);

      try {
        const res = await fetch('/api/admin/media', { method: 'POST', body: formData });
        if (res.ok) window.location.reload();
        else alert('Failed to upload file.');
      } catch {
        alert('Network error uploading file.');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Upload Now';
      }
    });

    document.querySelectorAll('.copy-url-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const url = (e.currentTarget as HTMLElement).dataset.url || '';
        navigator.clipboard.writeText(url);
        alert(`Copied URL: ${url}`);
      });
    });

    document.querySelectorAll('.delete-media-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.deleteMediaId;
        if (!confirm('Are you sure you want to delete this media file?')) return;
        try {
          const res = await fetch(`/api/admin/media?id=${id}`, { method: 'DELETE' });
          if (res.ok) window.location.reload();
        } catch {
          alert('Error deleting media item.');
        }
      });
    });
  </script>

</AdminLayout>
