---
// ============================================================
// /admin
// Admin Dashboard Overview & KPI Metrics
// ============================================================

import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../lib/db';

const stats = await db.getDashboardStats();
const recentCandidates = (await db.getCandidates()).slice(0, 6);
const recentLeads = (await db.getLeads()).slice(0, 6);
const roles = await db.getJobRoles();
const roleMap = new Map(roles.map(r => [r.id, r.role_name]));
---

<AdminLayout title="Operations Overview" activeNav="dashboard">
  
  <!-- KPI Grid -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-8">
    
    <!-- Total Resumes -->
    <div class="bg-white p-5 md:p-6 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between text-[#64748B] mb-2">
        <span class="text-xs font-bold uppercase tracking-wider">Total Resumes</span>
        <div class="w-8 h-8 rounded-lg bg-blue-50 text-[#0878E8] flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        </div>
      </div>
      <div>
        <p class="text-3xl font-extrabold font-manrope text-[#0B1F3A]">{stats.totalResumes}</p>
        <p class="text-xs text-green-600 font-semibold mt-1 flex items-center gap-1">
          <span>+{stats.newResumesToday} today</span>
          <span class="text-gray-400">· {stats.applicationsThisWeek} this week</span>
        </p>
      </div>
    </div>

    <!-- Total Inquiries & Leads -->
    <div class="bg-white p-5 md:p-6 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between text-[#64748B] mb-2">
        <span class="text-xs font-bold uppercase tracking-wider">Total Leads</span>
        <div class="w-8 h-8 rounded-lg bg-orange-50 text-[#F47A16] flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        </div>
      </div>
      <div>
        <p class="text-3xl font-extrabold font-manrope text-[#0B1F3A]">{stats.totalLeads}</p>
        <p class="text-xs text-[#64748B] mt-1">{stats.courseInquiries} Courses · {stats.ebookLeads} eBooks</p>
      </div>
    </div>

    <!-- Candidate Pipeline -->
    <div class="bg-white p-5 md:p-6 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between text-[#64748B] mb-2">
        <span class="text-xs font-bold uppercase tracking-wider">Shortlisted / Selected</span>
        <div class="w-8 h-8 rounded-lg bg-green-50 text-green-600 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
      </div>
      <div>
        <p class="text-3xl font-extrabold font-manrope text-green-600">{stats.shortlisted + stats.selected}</p>
        <p class="text-xs text-[#64748B] mt-1">{stats.shortlisted} Shortlisted · {stats.selected} Selected</p>
      </div>
    </div>

    <!-- Needs Review -->
    <div class="bg-white p-5 md:p-6 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between text-[#64748B] mb-2">
        <span class="text-xs font-bold uppercase tracking-wider">Needs Review</span>
        <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        </div>
      </div>
      <div>
        <p class="text-3xl font-extrabold font-manrope text-amber-600">{stats.needsReview}</p>
        <p class="text-xs text-[#64748B] mt-1">Under match threshold or pending review</p>
      </div>
    </div>

  </div>

  <!-- Detailed Metric Breakdowns -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    
    <!-- Lead Breakdown -->
    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
      <h2 class="text-sm font-bold uppercase tracking-wider text-[#0B1F3A] mb-4">Lead Types Breakdown</h2>
      <div class="space-y-3">
        <div class="flex items-center justify-between text-xs">
          <span class="text-[#64748B]">Course Inquiries</span>
          <span class="font-bold text-[#0B1F3A]">{stats.courseInquiries}</span>
        </div>
        <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden">
          <div class="bg-[#0878E8] h-full rounded-full" style={`width: ${stats.totalLeads ? (stats.courseInquiries / stats.totalLeads) * 100 : 0}%`}></div>
        </div>

        <div class="flex items-center justify-between text-xs">
          <span class="text-[#64748B]">Career Counseling</span>
          <span class="font-bold text-[#0B1F3A]">{stats.counselingLeads}</span>
        </div>
        <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden">
          <div class="bg-[#F47A16] h-full rounded-full" style={`width: ${stats.totalLeads ? (stats.counselingLeads / stats.totalLeads) * 100 : 0}%`}></div>
        </div>

        <div class="flex items-center justify-between text-xs">
          <span class="text-[#64748B]">eBook Downloads</span>
          <span class="font-bold text-[#0B1F3A]">{stats.ebookLeads}</span>
        </div>
        <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden">
          <div class="bg-purple-600 h-full rounded-full" style={`width: ${stats.totalLeads ? (stats.ebookLeads / stats.totalLeads) * 100 : 0}%`}></div>
        </div>

        <div class="flex items-center justify-between text-xs">
          <span class="text-[#64748B]">Job / Internship Applications</span>
          <span class="font-bold text-[#0B1F3A]">{stats.jobApplications + stats.internshipApplications}</span>
        </div>
        <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden">
          <div class="bg-emerald-500 h-full rounded-full" style={`width: ${stats.totalLeads ? ((stats.jobApplications + stats.internshipApplications) / stats.totalLeads) * 100 : 0}%`}></div>
        </div>
      </div>
    </div>

    <!-- Candidate Status Distribution -->
    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
      <h2 class="text-sm font-bold uppercase tracking-wider text-[#0B1F3A] mb-4">Candidate Status</h2>
      <div class="grid grid-cols-2 gap-3 text-center">
        <div class="p-3 bg-blue-50/60 rounded-xl">
          <p class="text-xl font-bold text-[#0878E8]">{stats.totalResumes}</p>
          <p class="text-[11px] font-semibold text-gray-500 uppercase mt-0.5">Applied</p>
        </div>
        <div class="p-3 bg-amber-50/60 rounded-xl">
          <p class="text-xl font-bold text-amber-600">{stats.needsReview}</p>
          <p class="text-[11px] font-semibold text-gray-500 uppercase mt-0.5">Needs Review</p>
        </div>
        <div class="p-3 bg-emerald-50/60 rounded-xl">
          <p class="text-xl font-bold text-emerald-600">{stats.shortlisted}</p>
          <p class="text-[11px] font-semibold text-gray-500 uppercase mt-0.5">Shortlisted</p>
        </div>
        <div class="p-3 bg-red-50/60 rounded-xl">
          <p class="text-xl font-bold text-red-600">{stats.rejected}</p>
          <p class="text-[11px] font-semibold text-gray-500 uppercase mt-0.5">Rejected</p>
        </div>
      </div>
      <div class="mt-4 pt-4 border-t border-gray-100 flex items-center justify-between text-xs text-[#64748B]">
        <span>Active Jobs: <strong>{stats.activeJobs}</strong></span>
        <span>Active Internships: <strong>{stats.activeInternships}</strong></span>
      </div>
    </div>

    <!-- Quick Operations -->
    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between">
      <h2 class="text-sm font-bold uppercase tracking-wider text-[#0B1F3A] mb-4">Quick Operations</h2>
      <div class="space-y-2">
        <a href="/admin/exports" class="w-full flex items-center justify-between px-4 py-2.5 rounded-xl border border-gray-200 hover:border-[#0878E8] hover:bg-blue-50/30 text-xs font-semibold text-[#0B1F3A] transition-all">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#0878E8]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            Export All Candidates (Excel)
          </span>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>

        <a href="/admin/roles" class="w-full flex items-center justify-between px-4 py-2.5 rounded-xl border border-gray-200 hover:border-[#0878E8] hover:bg-blue-50/30 text-xs font-semibold text-[#0B1F3A] transition-all">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#F47A16]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
            Manage Role Keywords & Weights
          </span>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>

        <a href="/admin/testimonials" class="w-full flex items-center justify-between px-4 py-2.5 rounded-xl border border-gray-200 hover:border-[#0878E8] hover:bg-blue-50/30 text-xs font-semibold text-[#0B1F3A] transition-all">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            Publish New Video Testimonial
          </span>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
      </div>

      <div class="mt-4 p-3 rounded-xl bg-slate-50 border border-gray-100 flex items-center gap-2 text-xs text-[#64748B]">
        <svg class="w-4 h-4 text-[#0878E8] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>Deterministic keyword matching scores are computed upon resume upload.</span>
      </div>
    </div>

  </div>

  <!-- Recent Candidates Table -->
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden mb-8">
    <div class="p-6 border-b border-gray-100 flex items-center justify-between flex-wrap gap-4">
      <div>
        <h2 class="text-base font-bold font-manrope text-[#0B1F3A]">Recently Processed Resumes</h2>
        <p class="text-xs text-[#64748B]">Candidates evaluated with role keyword matching</p>
      </div>
      <a href="/admin/resumes" class="text-xs font-bold text-[#0878E8] hover:underline flex items-center gap-1">
        View All Resumes
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>
    </div>

    {recentCandidates.length === 0 ? (
      <div class="p-12 text-center text-[#64748B] text-sm">
        <p>No resumes uploaded yet.</p>
        <p class="text-xs text-gray-400 mt-1">Uploaded resumes from public careers/internship forms will appear here with extracted keywords.</p>
      </div>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-[#F7F9FC] text-[#64748B] text-[11px] font-bold uppercase tracking-wider border-b border-gray-100">
            <tr>
              <th class="py-3 px-6">Candidate</th>
              <th class="py-3 px-6">Matched Role</th>
              <th class="py-3 px-6">Keyword Match</th>
              <th class="py-3 px-6">Experience / Education</th>
              <th class="py-3 px-6">Status</th>
              <th class="py-3 px-6 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {recentCandidates.map((c) => {
              const roleTitle = (c.assigned_role_id && roleMap.get(c.assigned_role_id)) || 'Needs Review';
              return (
                <tr class="hover:bg-gray-50/50 transition-colors">
                  <td class="py-4 px-6">
                    <a href={`/admin/candidates/${c.id}`} class="font-bold text-[#0B1F3A] hover:text-[#0878E8] transition-colors block">
                      {c.full_name}
                    </a>
                    <span class="text-xs text-gray-500 block">{c.email}</span>
                  </td>
                  <td class="py-4 px-6">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-[#0878E8] border border-blue-100">
                      {roleTitle}
                    </span>
                  </td>
                  <td class="py-4 px-6">
                    <div class="flex items-center gap-2">
                      <div class="w-16 bg-gray-100 h-2 rounded-full overflow-hidden">
                        <div 
                          class={`h-full rounded-full ${c.match_score >= 60 ? 'bg-green-500' : c.match_score >= 40 ? 'bg-[#0878E8]' : 'bg-amber-500'}`} 
                          style={`width: ${c.match_score}%`}
                        ></div>
                      </div>
                      <span class="text-xs font-bold text-[#0B1F3A]">{c.match_score}%</span>
                    </div>
                  </td>
                  <td class="py-4 px-6 text-xs text-[#64748B]">
                    <span class="block text-[#0B1F3A] font-medium">{c.years_experience !== undefined ? `${c.years_experience} Yrs` : 'Fresher'}</span>
                    <span class="block truncate max-w-[180px]">{c.degree || c.college || 'N/A'}</span>
                  </td>
                  <td class="py-4 px-6">
                    <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${
                      c.status === 'Shortlisted' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' :
                      c.status === 'Selected' ? 'bg-green-50 text-green-700 border border-green-200' :
                      c.status === 'Rejected' ? 'bg-red-50 text-red-700 border border-red-200' :
                      'bg-amber-50 text-amber-700 border border-amber-200'
                    }`}>
                      {c.status}
                    </span>
                  </td>
                  <td class="py-4 px-6 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <a href={`/admin/candidates/${c.id}`} class="p-1.5 rounded-lg border border-gray-200 text-gray-600 hover:text-[#0878E8] hover:border-[#0878E8] transition-colors" title="View Candidate Profile">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                      </a>
                      <a href={c.resume_file_url} target="_blank" class="p-1.5 rounded-lg border border-gray-200 text-gray-600 hover:text-[#0878E8] hover:border-[#0878E8] transition-colors" title="Download Resume">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                      </a>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>

  <!-- Recent Leads Table -->
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
    <div class="p-6 border-b border-gray-100 flex items-center justify-between flex-wrap gap-4">
      <div>
        <h2 class="text-base font-bold font-manrope text-[#0B1F3A]">Recent Public Leads & Inquiries</h2>
        <p class="text-xs text-[#64748B]">Submissions from contact, courses, counseling, and eBook forms</p>
      </div>
      <a href="/admin/leads" class="text-xs font-bold text-[#0878E8] hover:underline flex items-center gap-1">
        View All Leads
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>
    </div>

    {recentLeads.length === 0 ? (
      <div class="p-12 text-center text-[#64748B] text-sm">
        <p>No leads received yet.</p>
      </div>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-[#F7F9FC] text-[#64748B] text-[11px] font-bold uppercase tracking-wider border-b border-gray-100">
            <tr>
              <th class="py-3 px-6">Name</th>
              <th class="py-3 px-6">Lead Type</th>
              <th class="py-3 px-6">Contact Details</th>
              <th class="py-3 px-6">Program / Goal</th>
              <th class="py-3 px-6">Status</th>
              <th class="py-3 px-6 text-right">Date</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {recentLeads.map((l) => (
              <tr class="hover:bg-gray-50/50 transition-colors">
                <td class="py-4 px-6 font-bold text-[#0B1F3A]">
                  {l.first_name} {l.last_name}
                </td>
                <td class="py-4 px-6">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-gray-100 text-[#0B1F3A]">
                    {l.lead_type}
                  </span>
                </td>
                <td class="py-4 px-6 text-xs text-[#64748B]">
                  <p class="text-[#0B1F3A] font-medium">{l.phone}</p>
                  <p>{l.email}</p>
                </td>
                <td class="py-4 px-6 text-xs text-[#64748B]">
                  <p class="font-medium text-[#0B1F3A] truncate max-w-xs">{l.course_interest || l.service_interest || l.opportunity_type || 'General'}</p>
                  <p class="truncate max-w-xs text-gray-400">{l.education || l.college || l.message || ''}</p>
                </td>
                <td class="py-4 px-6">
                  <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${
                    l.status === 'Converted' ? 'bg-green-50 text-green-700' :
                    l.status === 'Interested' ? 'bg-blue-50 text-blue-700' :
                    l.status === 'Contacted' ? 'bg-purple-50 text-purple-700' :
                    'bg-amber-50 text-amber-700'
                  }`}>
                    {l.status}
                  </span>
                </td>
                <td class="py-4 px-6 text-right text-xs text-[#64748B]">
                  {new Date(l.created_at).toLocaleDateString('en-IN')}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

</AdminLayout>
