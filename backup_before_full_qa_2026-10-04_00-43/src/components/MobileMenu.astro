<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('.mobile-link');
  let isOpen = false;

  function toggleMenu() {
    if (!menu || !btn) return;
    isOpen = !isOpen;
    btn.setAttribute('aria-expanded', String(isOpen));
    
    // Toggle Menu Visibility
    if (isOpen) {
      menu.classList.remove('translate-x-full');
      menu.classList.add('translate-x-0');
      document.body.style.overflow = 'hidden';
      
      // Animate Hamburger to X
      if (btn.children.length >= 3) {
        btn.children[0].classList.add('translate-y-2', 'rotate-45');
        btn.children[1].classList.add('opacity-0');
        btn.children[2].classList.add('-translate-y-2', '-rotate-45');
      }
    } else {
      menu.classList.add('translate-x-full');
      menu.classList.remove('translate-x-0');
      document.body.style.overflow = '';
      
      // Revert Hamburger
      if (btn.children.length >= 3) {
        btn.children[0].classList.remove('translate-y-2', 'rotate-45');
        btn.children[1].classList.remove('opacity-0');
        btn.children[2].classList.remove('-translate-y-2', '-rotate-45');
      }
    }
  }

  btn?.addEventListener('click', toggleMenu);
  
  // Close menu when clicking a link
  links.forEach(link => {
    link.addEventListener('click', () => {
      if (isOpen) toggleMenu();
    });
  });

  // Close menu on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      toggleMenu();
    }
  });
</script>
