---
---
<footer class="bg-[#0B1F3A] text-white pt-20 pb-8 border-t border-[#1a2d4c]">
  <div class="container-custom">
    <!-- Newsletter Strip -->
    <div class="bg-gradient-to-r from-[#072B6F] to-[#0878E8]/40 p-8 md:p-10 rounded-2xl mb-16 border border-white/10 flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="max-w-xl text-center lg:text-left">
        <h3 class="text-2xl font-bold font-manrope text-white mb-2">Subscribe to Career & Tech Updates</h3>
        <p class="text-blue-100 text-sm">Get weekly curated insights on hiring trends, placement drives, CET updates, and technical roadmaps.</p>
      </div>

      <form id="newsletter-form" class="w-full lg:w-auto flex-1 max-w-md">
        <div class="flex flex-col sm:flex-row gap-3">
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input 
            type="email" 
            id="newsletter-email" 
            name="email" 
            required 
            placeholder="Enter your email address" 
            class="flex-1 px-4 py-3 rounded-full bg-white/10 border border-white/20 text-white placeholder-blue-200/60 focus:outline-none focus:border-[#F47A16] focus:bg-white/15 transition-all text-sm"
          />
          <button 
            type="submit" 
            id="newsletter-submit" 
            class="btn-primary py-3 px-6 whitespace-nowrap shadow-lg shadow-[#F47A16]/20"
          >
            Subscribe
          </button>
        </div>
        <p id="newsletter-msg" class="text-xs mt-2 hidden transition-all"></p>
      </form>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 lg:gap-8 pb-16 border-b border-[#1a2d4c]">
      
      <!-- Col 1: Brand -->
      <div class="lg:col-span-2">
        <a href="/" class="inline-flex items-center mb-6" aria-label="Knowletive Home">
          <img src="/images/knowletive-logo-optimized.png" alt="Knowletive Logo" class="h-14 md:h-16 lg:h-[72px] w-auto object-contain drop-shadow-[0_0_15px_rgba(255,255,255,0.4)]" />
        </a>
        <p class="text-gray-400 text-sm leading-relaxed max-w-sm mb-6">
          Expert career guidance, practical training, overseas education consulting, and business growth strategies designed to turn ambition into real-world success.
        </p>

        <div class="text-xs text-gray-400 space-y-1 mb-6">
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#F47A16] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
            Baner, Pune, Maharashtra, India
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#F47A16] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <a href="tel:+919970600116" class="hover:text-white transition-colors">+91 99706 00116</a>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#F47A16] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <a href="mailto:info@knowletive.com" class="hover:text-white transition-colors">info@knowletive.com</a>
          </p>
        </div>

        <div class="flex items-center gap-4">
          <a href="https://facebook.com/knowletive" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-gray-400 hover:bg-[#F47A16] hover:text-white transition-colors" aria-label="Knowletive on Facebook"><span class="font-bold text-xs">FB</span></a>
          <a href="https://linkedin.com/company/knowletive" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-gray-400 hover:bg-[#F47A16] hover:text-white transition-colors" aria-label="Knowletive on LinkedIn"><span class="font-bold text-xs">IN</span></a>
          <a href="https://instagram.com/knowletive" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-gray-400 hover:bg-[#F47A16] hover:text-white transition-colors" aria-label="Knowletive on Instagram"><span class="font-bold text-xs">IG</span></a>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h4 class="font-manrope font-bold text-sm tracking-widest text-white uppercase mb-6">Navigation</h4>
        <ul class="flex flex-col gap-3">
          <li><a href="/services" class="text-gray-400 hover:text-white hover:pl-1 transition-all text-sm">Services</a></li>
          <li><a href="/courses" class="text-gray-400 hover:text-white hover:pl-1 transition-all text-sm">Courses</a></li>
          <li><a href="/placement-activities" class="text-gray-400 hover:text-white hover:pl-1 transition-all text-sm">Placement & Activities</a></li>
          <li><a href="/internship-jobs" class="text-gray-400 hover:text-white hover:pl-1 transition-all text-sm">Internship & Jobs</a></li>
          <li><a href="/free-study-material" class="text-gray-400 hover:text-white hover:pl-1 transition-all text-sm">Free Study Material</a></li>
          <li><a href="/contact" class="text-gray-400 hover:text-white hover:pl-1 transition-all text-sm">Contact</a></li>
        </ul>
      </div>

      <!-- Col 3: Courses -->
      <div>
        <h4 class="font-manrope font-bold text-sm tracking-widest text-white uppercase mb-6">Courses</h4>
        <ul class="flex flex-col gap-3">
          <li><a href="/courses/data-science-ai-ml" class="text-gray-400 hover:text-white hover:pl-1 transition-all text-sm">Data Science & AI/ML</a></li>
          <li><a href="/courses/data-analysis" class="text-gray-400 hover:text-white hover:pl-1 transition-all text-sm">Data Analysis</a></li>
          <li><a href="/courses/mern-stack" class="text-gray-400 hover:text-white hover:pl-1 transition-all text-sm">MERN Stack</a></li>
          <li><a href="/courses/java-full-stack" class="text-gray-400 hover:text-white hover:pl-1 transition-all text-sm">Java Full Stack</a></li>
          <li><a href="/courses/cloud-devops" class="text-gray-400 hover:text-white hover:pl-1 transition-all text-sm">Cloud & DevOps</a></li>
        </ul>
      </div>

      <!-- Col 4: Services -->
      <div>
        <h4 class="font-manrope font-bold text-sm tracking-widest text-white uppercase mb-6">Services</h4>
        <ul class="flex flex-col gap-3">
          <li><a href="/services/it-training-placement" class="text-gray-400 hover:text-white hover:pl-1 transition-all text-sm">IT Training & Placement</a></li>
          <li><a href="/services/industrial-internship" class="text-gray-400 hover:text-white hover:pl-1 transition-all text-sm">Industrial Internship</a></li>
          <li><a href="/services/it-projects-freshers" class="text-gray-400 hover:text-white hover:pl-1 transition-all text-sm">IT Projects for Freshers</a></li>
          <li><a href="/services/overseas-education" class="text-gray-400 hover:text-white hover:pl-1 transition-all text-sm">Overseas Education</a></li>
          <li><a href="/services/distance-learning" class="text-gray-400 hover:text-white hover:pl-1 transition-all text-sm">Distance Learning</a></li>
        </ul>
      </div>

    </div>

    <div class="flex flex-col md:flex-row items-center justify-between pt-8 gap-4">
      <p class="text-gray-500 text-sm">© {new Date().getFullYear()} Knowletive. All Rights Reserved.</p>
      <div class="flex items-center gap-6 text-sm text-gray-500">
        <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
        <a href="/sitemap-index.xml" class="hover:text-white transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<script>
  const nForm = document.getElementById('newsletter-form');
  const nEmail = document.getElementById('newsletter-email') as HTMLInputElement | null;
  const nSubmit = document.getElementById('newsletter-submit') as HTMLButtonElement | null;
  const nMsg = document.getElementById('newsletter-msg');

  if (nForm && nEmail && nSubmit && nMsg) {
    nForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = nEmail.value.trim();

      if (!val || !val.includes('@') || !val.includes('.')) {
        nMsg.textContent = 'Please enter a valid email address.';
        nMsg.className = 'text-xs mt-2 text-red-400 block';
        return;
      }

      nSubmit.disabled = true;
      nSubmit.textContent = 'Subscribing...';

      fetch('/api/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: val,
          first_name: 'Subscriber',
          phone: 'N/A',
          lead_type: 'Other',
          source: 'Newsletter Footer',
          message: 'Subscribed to weekly career and tech updates'
        })
      }).then(() => {
        nSubmit.disabled = false;
        nSubmit.textContent = 'Subscribed!';
        nMsg.textContent = 'Thank you! You are subscribed to Knowletive career updates.';
        nMsg.className = 'text-xs mt-2 text-green-400 block';
        nEmail.value = '';

        setTimeout(() => {
          nSubmit.textContent = 'Subscribe';
        }, 4000);
      }).catch(() => {
        nSubmit.disabled = false;
        nSubmit.textContent = 'Subscribe';
        nMsg.textContent = 'Subscription failed. Please try again.';
        nMsg.className = 'text-xs mt-2 text-red-400 block';
      });
    });
  }
</script>
