---
// ============================================================
// /admin/roles
// Job Roles & Weighted Keywords Management Console
// ============================================================

import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../lib/db';

const roles = await db.getJobRoles(false);
const allKeywords = await db.getAllKeywords(false);
---

<AdminLayout title="Job Roles & Keywords" activeNav="roles">
  
  <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <h2 class="text-lg font-bold font-manrope text-[#0B1F3A]">Configurable Role Matching Engine</h2>
      <p class="text-xs text-[#64748B]">Add or adjust role keywords and weights (1-10) to automatically score candidate resumes.</p>
    </div>
    
    <button 
      id="open-add-role-modal"
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#0878E8] hover:bg-[#0764c2] text-white text-xs font-bold transition-all shadow-sm cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
      Add New Job Role
    </button>
  </div>

  <!-- Role Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {roles.map(role => {
      const keywords = allKeywords.filter(k => k.job_role_id === role.id);
      return (
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 flex flex-col justify-between" id={`role-card-${role.id}`}>
          <div>
            <div class="flex items-start justify-between gap-4 mb-2">
              <div>
                <h3 class="text-base font-bold text-[#0B1F3A]">{role.role_name}</h3>
                <span class="text-xs text-gray-400 font-medium">{role.category} · Threshold: {role.match_threshold}%</span>
              </div>
              <div class="flex items-center gap-1">
                <button 
                  data-role-id={role.id} 
                  class="delete-role-btn p-1.5 rounded-lg border border-gray-100 text-red-500 hover:bg-red-50 transition-colors"
                  title="Delete Role"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                </button>
              </div>
            </div>

            <p class="text-xs text-[#64748B] mb-4 line-clamp-2">{role.description || 'No description provided.'}</p>

            <!-- Keywords List -->
            <div class="space-y-1 mb-4">
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#64748B] block mb-2">
                Keywords & Weights ({keywords.length})
              </span>
              
              <div class="flex flex-wrap gap-2 max-h-48 overflow-y-auto pr-1">
                {keywords.map(kw => (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-gray-50 border border-gray-200 text-[#0B1F3A]">
                    <span>{kw.keyword}</span>
                    <span class="text-[10px] font-extrabold text-[#0878E8] bg-blue-50 px-1.5 py-0.5 rounded border border-blue-100">[{kw.weight}]</span>
                    <button 
                      data-keyword-id={kw.id} 
                      class="delete-keyword-btn text-gray-400 hover:text-red-500 transition-colors ml-0.5"
                      title="Remove Keyword"
                    >
                      &times;
                    </button>
                  </span>
                ))}
                {keywords.length === 0 && (
                  <span class="text-xs text-gray-400 italic">No keywords assigned yet.</span>
                )}
              </div>
            </div>
          </div>

          <!-- Add Keyword Form -->
          <form class="add-keyword-form pt-4 border-t border-gray-100 flex items-center gap-2" data-role-id={role.id}>
            <input 
              type="text" 
              name="keyword" 
              required 
              placeholder="e.g. sql, power bi..." 
              class="flex-1 px-3 py-1.5 text-xs rounded-lg border border-gray-200 outline-none focus:border-[#0878E8]" 
            />
            <select name="weight" class="px-2 py-1.5 text-xs rounded-lg border border-gray-200 outline-none bg-white font-semibold text-[#0B1F3A]">
              <option value="5">Weight 5 (High)</option>
              <option value="4">Weight 4</option>
              <option value="3" selected>Weight 3 (Med)</option>
              <option value="2">Weight 2</option>
              <option value="1">Weight 1 (Low)</option>
            </select>
            <button type="submit" class="px-3 py-1.5 bg-gray-900 hover:bg-black text-white text-xs font-bold rounded-lg transition-colors whitespace-nowrap">
              + Add
            </button>
          </form>

        </div>
      );
    })}
  </div>

  <!-- Modal for Adding Role -->
  <div id="add-role-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 md:p-8 w-full max-w-md shadow-2xl">
      <h3 class="text-lg font-bold font-manrope text-[#0B1F3A] mb-4">Add New Job Role</h3>
      
      <form id="new-role-form" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Role Name *</label>
          <input type="text" id="new-role-name" required placeholder="e.g. Cybersecurity Analyst" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Category</label>
          <input type="text" id="new-role-category" placeholder="e.g. Security & Infrastructure" value="Technology" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Match Threshold (%)</label>
          <input type="number" id="new-role-threshold" value="40" min="10" max="90" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Role Description</label>
          <textarea id="new-role-desc" rows="2" placeholder="Brief outline of expectations and candidate profile..." class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]"></textarea>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button type="button" id="close-add-role-modal" class="px-4 py-2 border border-gray-200 text-xs font-semibold rounded-xl hover:bg-gray-50">Cancel</button>
          <button type="submit" class="px-5 py-2 bg-[#0878E8] hover:bg-[#0764c2] text-white text-xs font-bold rounded-xl">Save Role</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Modal toggle
    const modal = document.getElementById('add-role-modal');
    document.getElementById('open-add-role-modal')?.addEventListener('click', () => modal?.classList.remove('hidden'));
    document.getElementById('close-add-role-modal')?.addEventListener('click', () => modal?.classList.add('hidden'));

    // Create role
    document.getElementById('new-role-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const roleName = (document.getElementById('new-role-name') as HTMLInputElement).value;
      const category = (document.getElementById('new-role-category') as HTMLInputElement).value;
      const matchThreshold = (document.getElementById('new-role-threshold') as HTMLInputElement).value;
      const description = (document.getElementById('new-role-desc') as HTMLTextAreaElement).value;

      try {
        const res = await fetch('/api/admin/roles', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ roleName, category, matchThreshold, description })
        });
        if (res.ok) window.location.reload();
        else alert('Failed to create job role.');
      } catch {
        alert('Network error.');
      }
    });

    // Delete role
    document.querySelectorAll('.delete-role-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const roleId = (e.currentTarget as HTMLElement).dataset.roleId;
        if (!confirm('Are you sure you want to delete this job role and all its keywords?')) return;

        try {
          const res = await fetch(`/api/admin/roles?id=${roleId}`, { method: 'DELETE' });
          if (res.ok) window.location.reload();
        } catch {
          alert('Network error deleting role.');
        }
      });
    });

    // Add keyword to role
    document.querySelectorAll('.add-keyword-form').forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.target as HTMLFormElement;
        const jobRoleId = f.dataset.roleId;
        const keyword = (f.querySelector('input[name="keyword"]') as HTMLInputElement).value;
        const weight = (f.querySelector('select[name="weight"]') as HTMLSelectElement).value;

        try {
          const res = await fetch('/api/admin/keywords', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ jobRoleId, keyword, weight })
          });
          if (res.ok) window.location.reload();
          else alert('Failed to add keyword.');
        } catch {
          alert('Error adding keyword.');
        }
      });
    });

    // Delete keyword
    document.querySelectorAll('.delete-keyword-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const kwId = (e.currentTarget as HTMLElement).dataset.keywordId;
        try {
          const res = await fetch(`/api/admin/keywords?id=${kwId}`, { method: 'DELETE' });
          if (res.ok) window.location.reload();
        } catch {
          alert('Error removing keyword.');
        }
      });
    });
  </script>

</AdminLayout>
