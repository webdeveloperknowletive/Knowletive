---
// ============================================================
// /admin/internships
// Manage Internships with Dedicated Applicant Tracking
// ============================================================

import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../lib/db';

const [internships, roles, applications] = await Promise.all([
  db.getInternships(false),
  db.getJobRoles(false),
  db.getApplications({ type: 'internship' })
]);

const roleMap = new Map(roles.map(r => [r.id, r.role_name]));

// Map applicant counts per internship
const applicantsCountMap = new Map<string, number>();
applications.forEach(a => {
  if (a.internship_id) {
    applicantsCountMap.set(a.internship_id, (applicantsCountMap.get(a.internship_id) || 0) + 1);
  }
});
---

<AdminLayout title="Internship Opportunities" activeNav="internships">
  
  <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <h2 class="text-lg font-bold font-manrope text-[#0B1F3A]">Internship Openings</h2>
      <p class="text-xs text-[#64748B]">Published internships automatically display on the public Internship & Jobs page. Applicants are strictly tracked per internship.</p>
    </div>
    
    <button 
      id="open-add-internship-modal"
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#0878E8] hover:bg-[#0764c2] text-white text-xs font-bold transition-all shadow-sm cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
      Add Internship Program
    </button>
  </div>

  <!-- Internships List -->
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm whitespace-nowrap">
        <thead class="bg-[#F7F9FC] text-[#64748B] text-[11px] font-bold uppercase tracking-wider border-b border-gray-100">
          <tr>
            <th class="py-3 px-6">Program Title</th>
            <th class="py-3 px-6">Department</th>
            <th class="py-3 px-6">Role Domain</th>
            <th class="py-3 px-6">Location & Duration</th>
            <th class="py-3 px-6">Skills Covered</th>
            <th class="py-3 px-6">Applicants</th>
            <th class="py-3 px-6">Publish Status</th>
            <th class="py-3 px-6 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {internships.map(item => {
            const count = applicantsCountMap.get(item.id) || 0;
            return (
              <tr class="hover:bg-gray-50/60 transition-colors">
                <td class="py-4 px-6 font-bold text-[#0B1F3A]">
                  {item.title}
                </td>
                <td class="py-4 px-6 text-xs text-[#64748B]">
                  {item.department}
                </td>
                <td class="py-4 px-6 text-xs text-[#64748B]">
                  {(item.job_role_id && roleMap.get(item.job_role_id)) || 'General'}
                </td>
                <td class="py-4 px-6 text-xs">
                  <span class="font-semibold text-[#0B1F3A] block">{item.location}</span>
                  <span class="text-gray-400 block">{item.duration}</span>
                </td>
                <td class="py-4 px-6 text-xs">
                  <div class="flex flex-wrap gap-1 max-w-xs">
                    {item.skills_required && item.skills_required.map(s => (
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-gray-100 text-gray-700">
                        {s}
                      </span>
                    ))}
                  </div>
                </td>
                <!-- Applicants Column -->
                <td class="py-4 px-6 text-xs">
                  <button 
                    type="button"
                    data-view-internship-applicants={item.id}
                    data-internship-title={item.title}
                    class="view-intern-applicants-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-bold transition-all cursor-pointer border border-emerald-200"
                    title="View candidate applications for this internship"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                    <span>{count} {count === 1 ? 'Applicant' : 'Applicants'}</span>
                  </button>
                </td>
                <td class="py-4 px-6">
                  <button 
                    data-toggle-internship-id={item.id} 
                    data-current-active={item.is_active ? 'true' : 'false'}
                    class={`toggle-internship-btn inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold transition-colors cursor-pointer ${
                      item.is_active 
                        ? 'bg-green-50 text-green-700 border border-green-200 hover:bg-green-100' 
                        : 'bg-gray-100 text-gray-500 border border-gray-200 hover:bg-gray-200'
                    }`}
                  >
                    <span class={`w-1.5 h-1.5 rounded-full ${item.is_active ? 'bg-green-500' : 'bg-gray-400'}`}></span>
                    {item.is_active ? 'Published' : 'Draft'}
                  </button>
                </td>
                <td class="py-4 px-6 text-right">
                  <div class="inline-flex items-center gap-2">
                    <button 
                      type="button"
                      data-view-internship-applicants={item.id}
                      data-internship-title={item.title}
                      class="view-intern-applicants-btn p-1.5 rounded-lg border border-gray-200 text-[#0878E8] hover:bg-blue-50 transition-colors cursor-pointer"
                      title="View Applicants"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                    </button>
                    <button 
                      data-delete-internship-id={item.id} 
                      class="delete-internship-btn p-1.5 rounded-lg border border-gray-200 text-red-500 hover:bg-red-50 transition-colors cursor-pointer"
                      title="Delete Internship"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    </button>
                  </div>
                </td>
              </tr>
            );
          })}
          {internships.length === 0 && (
            <tr>
              <td colspan="8" class="p-12 text-center text-sm text-gray-400">
                No internship opportunities posted yet. Click "+ Add Internship Program" to add one.
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add Internship Modal -->
  <div id="add-internship-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 md:p-8 w-full max-w-lg shadow-2xl max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold font-manrope text-[#0B1F3A] mb-4">Post Internship Program</h3>
      
      <form id="new-internship-form" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Internship Title *</label>
          <input type="text" id="internship-title" required placeholder="e.g. Data Analytics & Business Intelligence Intern" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Target Job Role</label>
            <select id="internship-role-id" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none bg-white">
              <option value="">Select Domain Role</option>
              {roles.map(r => (
                <option value={r.id}>{r.role_name}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Department *</label>
            <input type="text" id="internship-department" required placeholder="e.g. Analytics Lab" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Location *</label>
            <input type="text" id="internship-location" required placeholder="e.g. Baner, Pune / Hybrid" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Duration</label>
            <input type="text" id="internship-duration" value="3-6 Months" placeholder="e.g. 3-6 Months" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Skills Covered (comma separated)</label>
          <input type="text" id="internship-skills" placeholder="Excel, SQL, Power BI, Python" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Program Description</label>
          <textarea id="internship-desc" rows="3" placeholder="Projects, mentorship, stipend/certification details..." class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]"></textarea>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button type="button" id="close-add-internship-modal" class="px-4 py-2 border border-gray-200 text-xs font-semibold rounded-xl hover:bg-gray-50 cursor-pointer">Cancel</button>
          <button type="submit" class="px-5 py-2 bg-[#0878E8] hover:bg-[#0764c2] text-white text-xs font-bold rounded-xl cursor-pointer">Publish Internship</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Dedicated Internship Applicants Modal -->
  <div id="internship-applicants-modal" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4 backdrop-blur-xs">
    <div class="bg-white rounded-3xl p-6 md:p-8 w-full max-w-5xl shadow-2xl max-h-[90vh] flex flex-col">
      <div class="flex items-center justify-between pb-4 border-b border-gray-100 mb-4">
        <div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200 mb-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Internship Applicants
          </div>
          <h3 id="internship-modal-title" class="text-xl font-bold font-manrope text-[#0B1F3A]">Applicants</h3>
        </div>
        <button type="button" id="close-applicants-modal" class="p-2 rounded-xl text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition-colors cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <div class="overflow-x-auto flex-1 border border-gray-100 rounded-2xl relative">
        <div id="applicants-loading" class="hidden p-8 text-center text-xs text-gray-500">
          Loading applicants...
        </div>
        <table id="applicants-table" class="w-full text-left text-sm whitespace-nowrap">
          <thead class="bg-[#F7F9FC] text-[#64748B] text-[11px] font-bold uppercase tracking-wider border-b border-gray-100">
            <tr>
              <th class="py-3 px-4">Candidate</th>
              <th class="py-3 px-4">Phone</th>
              <th class="py-3 px-4">Skills</th>
              <th class="py-3 px-4">Match %</th>
              <th class="py-3 px-4">Resume</th>
              <th class="py-3 px-4">Status</th>
              <th class="py-3 px-4">Applied Date</th>
            </tr>
          </thead>
          <tbody id="internship-applicants-tbody" class="divide-y divide-gray-100">
            <!-- Dynamically populated -->
          </tbody>
        </table>
        <div id="internship-applicants-empty" class="hidden p-12 text-center text-sm text-gray-400">
          <svg class="w-12 h-12 text-gray-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
          <p class="font-bold text-[#0B1F3A]">No applicants for this internship yet.</p>
          <p class="text-xs text-gray-400 mt-1">Candidates who apply via this internship card will appear here strictly separated from job applicants.</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    const modal = document.getElementById('add-internship-modal');
    document.getElementById('open-add-internship-modal')?.addEventListener('click', () => modal?.classList.remove('hidden'));
    document.getElementById('close-add-internship-modal')?.addEventListener('click', () => modal?.classList.add('hidden'));

    // Post internship
    document.getElementById('new-internship-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = (document.getElementById('internship-title') as HTMLInputElement).value;
      const jobRoleId = (document.getElementById('internship-role-id') as HTMLSelectElement).value;
      const department = (document.getElementById('internship-department') as HTMLInputElement).value;
      const location = (document.getElementById('internship-location') as HTMLInputElement).value;
      const duration = (document.getElementById('internship-duration') as HTMLInputElement).value;
      const skillsRequired = (document.getElementById('internship-skills') as HTMLInputElement).value.split(',').map(s => s.trim()).filter(Boolean);
      const description = (document.getElementById('internship-desc') as HTMLTextAreaElement).value;

      try {
        const res = await fetch('/api/admin/internships', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, jobRoleId, department, location, duration, skillsRequired, description, isActive: true })
        });
        if (res.ok) window.location.reload();
        else alert('Failed to create internship.');
      } catch {
        alert('Network error.');
      }
    });

    // Toggle active
    document.querySelectorAll('.toggle-internship-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = (e.currentTarget as HTMLElement);
        const id = target.dataset.toggleInternshipId;
        const currentActive = target.dataset.currentActive === 'true';

        try {
          const res = await fetch('/api/admin/internships', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, isActive: !currentActive })
          });
          if (res.ok) window.location.reload();
        } catch {
          alert('Network error.');
        }
      });
    });

    // Delete internship
    document.querySelectorAll('.delete-internship-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.deleteInternshipId;
        if (!confirm('Are you sure you want to delete this internship posting?')) return;

        try {
          const res = await fetch(`/api/admin/internships?id=${id}`, { method: 'DELETE' });
          if (res.ok) window.location.reload();
        } catch {
          alert('Error deleting internship.');
        }
      });
    });

    // View Applicants Modal
    const applicantsModal = document.getElementById('internship-applicants-modal');
    const applicantsTitle = document.getElementById('internship-modal-title');
    const applicantsTbody = document.getElementById('internship-applicants-tbody');
    const applicantsEmpty = document.getElementById('internship-applicants-empty');
    const applicantsLoading = document.getElementById('applicants-loading');
    const applicantsTable = document.getElementById('applicants-table');

    document.getElementById('close-applicants-modal')?.addEventListener('click', () => {
      applicantsModal?.classList.add('hidden');
    });

    document.querySelectorAll('.view-intern-applicants-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = (e.currentTarget as HTMLElement);
        const internshipId = target.getAttribute('data-view-internship-applicants') || '';
        const title = target.getAttribute('data-internship-title') || 'Internship';

        if (applicantsTitle) applicantsTitle.textContent = `Applicants for: ${title}`;
        if (applicantsTbody) applicantsTbody.innerHTML = '';
        applicantsEmpty?.classList.add('hidden');
        applicantsTable?.classList.remove('hidden');
        applicantsLoading?.classList.remove('hidden');
        applicantsModal?.classList.remove('hidden');

        try {
          const res = await fetch(`/api/admin/internships/${internshipId}/applications`);
          const data = await res.json();
          applicantsLoading?.classList.add('hidden');

          const apps = data.applications || [];
          if (apps.length === 0) {
            applicantsEmpty?.classList.remove('hidden');
            applicantsTable?.classList.add('hidden');
            return;
          }

          if (applicantsTbody) {
            applicantsTbody.innerHTML = apps.map((app: any) => {
              const cand = app.candidate || {};
              const skills = Array.isArray(app.skills || cand.skills) ? (app.skills || cand.skills) : [];
              const score = app.match_score || 0;
              const date = new Date(app.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

              return `
                <tr class="hover:bg-gray-50/70 transition-colors">
                  <td class="py-3 px-4">
                    <span class="font-bold text-[#0B1F3A] block">${cand.full_name || 'Applicant'}</span>
                    <span class="text-xs text-gray-500">${cand.email || ''}</span>
                  </td>
                  <td class="py-3 px-4 text-xs text-[#0B1F3A]">${cand.phone || 'N/A'}</td>
                  <td class="py-3 px-4 text-xs">
                    <div class="flex flex-wrap gap-1 max-w-[200px]">
                      ${skills.slice(0, 3).map((s: string) => `<span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-gray-100 text-gray-700">${s}</span>`).join('')}
                    </div>
                  </td>
                  <td class="py-3 px-4 text-xs font-bold text-emerald-700">${score}%</td>
                  <td class="py-3 px-4 text-xs">
                    <a href="${app.resume_url}" target="_blank" class="inline-flex items-center gap-1 text-[#0878E8] hover:underline font-semibold">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                      Resume
                    </a>
                  </td>
                  <td class="py-3 px-4 text-xs">
                    <select data-app-status-id="${app.id}" class="app-status-select px-2.5 py-1 text-xs rounded-lg border border-gray-200 outline-none font-semibold ${
                      app.status === 'Shortlisted' || app.status === 'Selected' ? 'text-green-700 bg-green-50' : 
                      app.status === 'Rejected' ? 'text-red-700 bg-red-50' : 'text-blue-700 bg-blue-50'
                    }">
                      <option value="New" ${app.status === 'New' ? 'selected' : ''}>New</option>
                      <option value="Needs Review" ${app.status === 'Needs Review' ? 'selected' : ''}>Needs Review</option>
                      <option value="Shortlisted" ${app.status === 'Shortlisted' ? 'selected' : ''}>Shortlisted</option>
                      <option value="Interviewing" ${app.status === 'Interviewing' ? 'selected' : ''}>Interviewing</option>
                      <option value="Selected" ${app.status === 'Selected' ? 'selected' : ''}>Selected</option>
                      <option value="Rejected" ${app.status === 'Rejected' ? 'selected' : ''}>Rejected</option>
                    </select>
                  </td>
                  <td class="py-3 px-4 text-xs text-gray-500">${date}</td>
                </tr>
              `;
            }).join('');

            // Attach status change listeners
            applicantsTbody.querySelectorAll('.app-status-select').forEach(sel => {
              sel.addEventListener('change', async (ev) => {
                const targetSel = ev.currentTarget as HTMLSelectElement;
                const appId = targetSel.dataset.appStatusId;
                const newStatus = targetSel.value;

                try {
                  const patchRes = await fetch('/api/admin/applications', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: appId, status: newStatus })
                  });
                  if (!patchRes.ok) {
                    alert('Failed to update status.');
                  }
                } catch {
                  alert('Network error while updating status.');
                }
              });
            });
          }
        } catch (err) {
          applicantsLoading?.classList.add('hidden');
          alert('Failed to load internship applicants.');
        }
      });
    });
  </script>

</AdminLayout>
