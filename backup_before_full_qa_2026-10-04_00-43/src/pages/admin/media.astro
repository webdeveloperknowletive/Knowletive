---
// ============================================================
// /admin/media
// Media Library - Upload, Preview, Category & Publishing Management
// ============================================================

import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../lib/db';

const mediaList = await db.getMedia();
---

<AdminLayout title="Media Library" activeNav="media">
  
  <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold font-manrope text-[#0B1F3A]">Media Library & Activities Gallery</h2>
      <p class="text-xs text-[#64748B]">Upload photos and videos that appear automatically in the public Activities Gallery, Testimonials, and Website sections.</p>
    </div>
    
    <button 
      id="open-upload-modal"
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#0878E8] hover:bg-[#0764c2] text-white text-xs font-bold transition-all shadow-sm cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
      Upload File
    </button>
  </div>

  <!-- Category Filter Pills -->
  <div class="flex flex-wrap gap-2 mb-6">
    <button class="filter-tab px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-[#0B1F3A] text-white" data-filter="all">All Media ({mediaList.length})</button>
    <button class="filter-tab px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-white border border-gray-200 text-gray-600 hover:bg-gray-50" data-filter="activities">Activities Gallery ({mediaList.filter(m => (m.category || '').toLowerCase().includes('activit')).length})</button>
    <button class="filter-tab px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-white border border-gray-200 text-gray-600 hover:bg-gray-50" data-filter="placements">Placements ({mediaList.filter(m => m.category === 'placements').length})</button>
    <button class="filter-tab px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-white border border-gray-200 text-gray-600 hover:bg-gray-50" data-filter="testimonials">Testimonials ({mediaList.filter(m => m.category === 'testimonials').length})</button>
    <button class="filter-tab px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-white border border-gray-200 text-gray-600 hover:bg-gray-50" data-filter="courses">Courses ({mediaList.filter(m => m.category === 'courses').length})</button>
    <button class="filter-tab px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-white border border-gray-200 text-gray-600 hover:bg-gray-50" data-filter="general">General ({mediaList.filter(m => !m.category || m.category === 'general').length})</button>
  </div>

  <!-- Media Grid -->
  <div id="media-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
    {mediaList.map(item => (
      <div 
        class="media-card bg-white rounded-2xl border border-gray-200/80 shadow-sm hover:shadow-md transition-all p-4 flex flex-col justify-between"
        data-category={(item.category || 'general').toLowerCase()}
        data-id={item.id}
      >
        <div>
          <!-- Thumbnail / Preview Area -->
          <div class="aspect-[4/5] rounded-xl bg-slate-50 border border-gray-100 overflow-hidden relative mb-3 flex items-center justify-center">
            {item.type === 'image' || item.type === 'poster' ? (
              <img src={item.file_url} alt={item.title} class="w-full h-full object-cover object-top" loading="lazy" />
            ) : item.type === 'video' ? (
              <div class="relative w-full h-full flex items-center justify-center bg-slate-950">
                <video src={item.file_url} class="w-full h-full object-cover object-top opacity-85" preload="metadata" muted playsinline></video>
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                  <div class="w-10 h-10 rounded-full bg-black/60 flex items-center justify-center text-white">
                    <svg class="w-5 h-5 ml-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path></svg>
                  </div>
                </div>
              </div>
            ) : (
              <div class="text-gray-400 flex flex-col items-center">
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                <span class="text-xs font-semibold mt-1">Document</span>
              </div>
            )}
          </div>

          <!-- Badges & Status Row (Positioned below thumbnail so top text is never obscured) -->
          <div class="flex items-center justify-between gap-1.5 mb-2.5">
            <span class={`text-[10px] font-bold px-2 py-0.5 rounded-md uppercase tracking-wider ${
              (item.category || '').toLowerCase().includes('activit') ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' :
              item.category === 'placements' ? 'bg-blue-50 text-blue-700 border border-blue-200' :
              item.category === 'testimonials' ? 'bg-purple-50 text-purple-700 border border-purple-200' :
              'bg-slate-100 text-slate-700 border border-slate-200'
            }`}>
              {item.category === 'activities' ? 'Activities' : item.category || 'General'}
            </span>

            <button 
              class="toggle-publish-btn text-[10px] font-bold px-2 py-0.5 rounded-md cursor-pointer transition-colors shadow-sm"
              data-id={item.id}
              data-published={String(item.is_published !== false)}
              style={{
                backgroundColor: item.is_published !== false ? '#10B981' : '#6B7280',
                color: '#FFFFFF'
              }}
            >
              {item.is_published !== false ? 'Published ✓' : 'Draft (Hidden)'}
            </button>
          </div>

          <!-- Metadata -->
          <h4 class="text-sm font-bold text-[#0B1F3A] mb-1 truncate" title={item.title}>{item.title}</h4>
          {item.description && (
            <p class="text-xs text-[#64748B] mb-2 line-clamp-2">{item.description}</p>
          )}

          <div class="flex items-center justify-between text-[11px] text-gray-400 mb-2">
            <span>{(item.file_size / (1024 * 1024)).toFixed(2)} MB &bull; {item.type.toUpperCase()}</span>
            <span>Order: {item.display_order ?? 0}</span>
          </div>
        </div>

        <!-- Action Bar -->
        <div class="pt-3 border-t border-gray-100 flex items-center justify-between gap-2 mt-2">
          <button 
            data-url={item.file_url} 
            class="copy-url-btn text-xs font-bold text-[#0878E8] hover:underline"
          >
            Copy URL
          </button>

          <div class="flex items-center gap-2">
            <button 
              class="edit-media-btn p-1.5 text-gray-500 hover:text-[#0878E8] hover:bg-blue-50 rounded-lg transition-colors cursor-pointer"
              title="Edit Details"
              data-id={item.id}
              data-title={item.title}
              data-description={item.description || ''}
              data-category={item.category || 'activities'}
              data-published={String(item.is_published !== false)}
              data-order={String(item.display_order ?? 0)}
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            </button>
            <button 
              data-delete-media-id={item.id} 
              class="delete-media-btn p-1.5 text-red-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors cursor-pointer"
              title="Delete File"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </button>
          </div>
        </div>
      </div>
    ))}

    {mediaList.length === 0 && (
      <div class="col-span-full p-16 text-center text-sm text-gray-400 bg-white rounded-2xl border border-gray-100">
        No files uploaded to the media library yet. Click "Upload File" above to add your first photo or video.
      </div>
    )}
  </div>

  <!-- Upload Modal -->
  <div id="upload-modal" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="bg-white rounded-3xl p-6 md:p-8 w-full max-w-lg shadow-2xl relative">
      <h3 class="text-xl font-bold font-manrope text-[#0B1F3A] mb-1">Upload Media Asset</h3>
      <p class="text-xs text-gray-500 mb-6">Uploaded photos and videos will dynamically appear in their assigned public section.</p>
      
      <form id="upload-form" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-[#0B1F3A] mb-1 uppercase tracking-wider">Title / Event Name *</label>
          <input type="text" id="upload-title" required placeholder="e.g. Annual Tech Symposium & Hackathon" class="w-full px-4 py-2.5 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8] focus:ring-2 focus:ring-[#0878E8]/10" />
        </div>

        <div>
          <label class="block text-xs font-bold text-[#0B1F3A] mb-1 uppercase tracking-wider">Media Category *</label>
          <select id="upload-category" required class="w-full px-4 py-2.5 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8] bg-white">
            <option value="activities" selected>Activities Gallery (Student Life / Workshops)</option>
            <option value="placements">Placements</option>
            <option value="testimonials">Testimonials</option>
            <option value="courses">Courses</option>
            <option value="general">General</option>
          </select>
          <span class="text-[11px] text-emerald-600 font-medium block mt-1">Select "Activities Gallery" to display on the public Placement & Activities page.</span>
        </div>

        <div>
          <label class="block text-xs font-bold text-[#0B1F3A] mb-1 uppercase tracking-wider">Description (Optional)</label>
          <textarea id="upload-description" rows="2" placeholder="Brief caption describing the event or project..." class="w-full px-4 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]"></textarea>
        </div>

        <div>
          <label class="block text-xs font-bold text-[#0B1F3A] mb-1 uppercase tracking-wider">Choose File * (Images: JPG, PNG, WEBP &bull; Videos: MP4, WEBM)</label>
          <input type="file" id="upload-file" required accept=".jpg,.jpeg,.png,.webp,.mp4,.webm" class="w-full text-xs text-gray-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-50 file:text-[#0878E8] hover:file:bg-blue-100" />
        </div>

        <div class="grid grid-cols-2 gap-4 pt-2">
          <div>
            <label class="block text-xs font-bold text-[#0B1F3A] mb-1 uppercase tracking-wider">Display Order</label>
            <input type="number" id="upload-order" value="0" min="0" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
          </div>

          <div class="flex items-center gap-2 pt-5">
            <input type="checkbox" id="upload-published" checked class="w-4 h-4 text-[#0878E8] rounded border-gray-300" />
            <label for="upload-published" class="text-xs font-bold text-[#0B1F3A] cursor-pointer">Publish Immediately</label>
          </div>
        </div>

        <div id="upload-status-msg" class="hidden p-3 rounded-xl text-xs"></div>

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
          <button type="button" id="close-upload-modal" class="px-5 py-2.5 border border-gray-200 text-xs font-bold rounded-xl hover:bg-gray-50">Cancel</button>
          <button type="submit" id="upload-submit-btn" class="px-6 py-2.5 bg-[#0878E8] hover:bg-[#0764c2] text-white text-xs font-bold rounded-xl transition-all shadow-md">Upload & Save</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Modal -->
  <div id="edit-modal" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="bg-white rounded-3xl p-6 md:p-8 w-full max-w-lg shadow-2xl relative">
      <h3 class="text-xl font-bold font-manrope text-[#0B1F3A] mb-4">Edit Media Details</h3>
      
      <form id="edit-form" class="space-y-4">
        <input type="hidden" id="edit-id" />

        <div>
          <label class="block text-xs font-bold text-[#0B1F3A] mb-1 uppercase tracking-wider">Title *</label>
          <input type="text" id="edit-title" required class="w-full px-4 py-2.5 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
        </div>

        <div>
          <label class="block text-xs font-bold text-[#0B1F3A] mb-1 uppercase tracking-wider">Media Category *</label>
          <select id="edit-category" required class="w-full px-4 py-2.5 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8] bg-white">
            <option value="activities">Activities Gallery (Student Life / Workshops)</option>
            <option value="placements">Placements</option>
            <option value="testimonials">Testimonials</option>
            <option value="courses">Courses</option>
            <option value="general">General</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-[#0B1F3A] mb-1 uppercase tracking-wider">Description</label>
          <textarea id="edit-description" rows="2" class="w-full px-4 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-[#0B1F3A] mb-1 uppercase tracking-wider">Display Order</label>
            <input type="number" id="edit-order" min="0" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
          </div>

          <div class="flex items-center gap-2 pt-5">
            <input type="checkbox" id="edit-published" class="w-4 h-4 text-[#0878E8] rounded border-gray-300" />
            <label for="edit-published" class="text-xs font-bold text-[#0B1F3A] cursor-pointer">Published Online</label>
          </div>
        </div>

        <div id="edit-status-msg" class="hidden p-3 rounded-xl text-xs"></div>

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
          <button type="button" id="close-edit-modal" class="px-5 py-2.5 border border-gray-200 text-xs font-bold rounded-xl hover:bg-gray-50">Cancel</button>
          <button type="submit" id="edit-submit-btn" class="px-6 py-2.5 bg-[#0878E8] hover:bg-[#0764c2] text-white text-xs font-bold rounded-xl transition-all shadow-md">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Modal controls
    const uploadModal = document.getElementById('upload-modal');
    const editModal = document.getElementById('edit-modal');

    document.getElementById('open-upload-modal')?.addEventListener('click', () => uploadModal?.classList.remove('hidden'));
    document.getElementById('close-upload-modal')?.addEventListener('click', () => uploadModal?.classList.add('hidden'));
    document.getElementById('close-edit-modal')?.addEventListener('click', () => editModal?.classList.add('hidden'));

    // Category Filter Pills
    const filterTabs = document.querySelectorAll('.filter-tab');
    const cards = document.querySelectorAll('.media-card');

    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        filterTabs.forEach(t => {
          t.className = 'filter-tab px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-white border border-gray-200 text-gray-600 hover:bg-gray-50';
        });
        tab.className = 'filter-tab px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-[#0B1F3A] text-white';

        const filter = tab.getAttribute('data-filter') || 'all';
        cards.forEach(card => {
          const cat = card.getAttribute('data-category') || '';
          if (filter === 'all') {
            (card as HTMLElement).style.display = '';
          } else if (filter === 'activities') {
            (card as HTMLElement).style.display = cat.includes('activit') ? '' : 'none';
          } else {
            (card as HTMLElement).style.display = cat === filter ? '' : 'none';
          }
        });
      });
    });

    // Upload Submission
    document.getElementById('upload-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = (document.getElementById('upload-title') as HTMLInputElement).value;
      const category = (document.getElementById('upload-category') as HTMLSelectElement).value;
      const description = (document.getElementById('upload-description') as HTMLTextAreaElement).value;
      const file = (document.getElementById('upload-file') as HTMLInputElement).files?.[0];
      const isPublished = (document.getElementById('upload-published') as HTMLInputElement).checked;
      const displayOrder = (document.getElementById('upload-order') as HTMLInputElement).value;
      const btn = document.getElementById('upload-submit-btn') as HTMLButtonElement;
      const msg = document.getElementById('upload-status-msg') as HTMLElement;

      if (!file) return;

      btn.disabled = true;
      btn.textContent = 'Uploading...';
      msg.className = 'hidden';

      const formData = new FormData();
      formData.append('title', title);
      formData.append('category', category);
      formData.append('description', description);
      formData.append('file', file);
      formData.append('is_published', String(isPublished));
      formData.append('display_order', displayOrder);

      try {
        const res = await fetch('/api/admin/media', { method: 'POST', body: formData });
        const data = await res.json();
        if (res.ok && data.success) {
          msg.textContent = 'Media uploaded and published successfully!';
          msg.className = 'p-3 rounded-xl text-xs bg-emerald-50 text-emerald-800 border border-emerald-200 block';
          setTimeout(() => window.location.reload(), 800);
        } else {
          throw new Error(data.error || 'Failed to upload file.');
        }
      } catch (err: any) {
        msg.textContent = err.message || 'Network error uploading file.';
        msg.className = 'p-3 rounded-xl text-xs bg-red-50 text-red-800 border border-red-200 block';
        btn.disabled = false;
        btn.textContent = 'Upload & Save';
      }
    });

    // Quick Publish / Unpublish Toggle
    document.querySelectorAll('.toggle-publish-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLElement;
        const id = target.dataset.id;
        const currentlyPublished = target.dataset.published === 'true';
        const newStatus = !currentlyPublished;

        target.textContent = 'Updating...';

        try {
          const res = await fetch('/api/admin/media', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, is_published: newStatus })
          });
          if (res.ok) {
            target.dataset.published = String(newStatus);
            target.textContent = newStatus ? 'Published ✓' : 'Draft (Hidden)';
            target.style.backgroundColor = newStatus ? '#10B981' : '#6B7280';
          } else {
            alert('Failed to update status.');
          }
        } catch {
          alert('Network error updating status.');
        }
      });
    });

    // Edit Modal Opening
    document.querySelectorAll('.edit-media-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        (document.getElementById('edit-id') as HTMLInputElement).value = target.dataset.id || '';
        (document.getElementById('edit-title') as HTMLInputElement).value = target.dataset.title || '';
        (document.getElementById('edit-description') as HTMLTextAreaElement).value = target.dataset.description || '';
        (document.getElementById('edit-category') as HTMLSelectElement).value = target.dataset.category || 'activities';
        (document.getElementById('edit-published') as HTMLInputElement).checked = target.dataset.published === 'true';
        (document.getElementById('edit-order') as HTMLInputElement).value = target.dataset.order || '0';
        editModal?.classList.remove('hidden');
      });
    });

    // Edit Submission
    document.getElementById('edit-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = (document.getElementById('edit-id') as HTMLInputElement).value;
      const title = (document.getElementById('edit-title') as HTMLInputElement).value;
      const category = (document.getElementById('edit-category') as HTMLSelectElement).value;
      const description = (document.getElementById('edit-description') as HTMLTextAreaElement).value;
      const isPublished = (document.getElementById('edit-published') as HTMLInputElement).checked;
      const displayOrder = parseInt((document.getElementById('edit-order') as HTMLInputElement).value, 10) || 0;
      const btn = document.getElementById('edit-submit-btn') as HTMLButtonElement;
      const msg = document.getElementById('edit-status-msg') as HTMLElement;

      btn.disabled = true;
      btn.textContent = 'Saving...';
      msg.className = 'hidden';

      try {
        const res = await fetch('/api/admin/media', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id,
            title,
            category,
            description,
            is_published: isPublished,
            display_order: displayOrder
          })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          msg.textContent = 'Changes saved successfully!';
          msg.className = 'p-3 rounded-xl text-xs bg-emerald-50 text-emerald-800 border border-emerald-200 block';
          setTimeout(() => window.location.reload(), 600);
        } else {
          throw new Error(data.error || 'Failed to save changes.');
        }
      } catch (err: any) {
        msg.textContent = err.message || 'Network error saving changes.';
        msg.className = 'p-3 rounded-xl text-xs bg-red-50 text-red-800 border border-red-200 block';
        btn.disabled = false;
        btn.textContent = 'Save Changes';
      }
    });

    // Copy URL
    document.querySelectorAll('.copy-url-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const url = (e.currentTarget as HTMLElement).dataset.url || '';
        const fullUrl = window.location.origin + url;
        navigator.clipboard.writeText(fullUrl);
        alert(`Copied URL to clipboard:\n${fullUrl}`);
      });
    });

    // Delete Media
    document.querySelectorAll('.delete-media-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.deleteMediaId;
        if (!confirm('Are you sure you want to delete this media file? It will be removed from all public galleries.')) return;
        try {
          const res = await fetch(`/api/admin/media?id=${id}`, { method: 'DELETE' });
          if (res.ok) window.location.reload();
          else alert('Error deleting media file.');
        } catch {
          alert('Network error deleting media file.');
        }
      });
    });
  </script>

</AdminLayout>
