# ============================================================
# Knowletive Environment Configuration
# Copy this file to .env and configure your production credentials
# ============================================================

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Admin Authentication & Session Security
# Generate a random 32+ character string (e.g. openssl rand -base64 32)
ADMIN_SESSION_SECRET=knowletive_secure_admin_session_key_replace_in_production_32chars

# Initial Admin Bootstrap Credentials (Used for first-time setup / local admin access)
DEFAULT_ADMIN_EMAIL=admin@knowletive.com
DEFAULT_ADMIN_PASSWORD=KnowletiveAdmin2026!

# Public Site Configuration
PUBLIC_SITE_URL=http://localhost:4321

# Web3Forms API Key (Optional fallback if direct DB email alerting is used)
PUBLIC_WEB3FORMS_KEY=
