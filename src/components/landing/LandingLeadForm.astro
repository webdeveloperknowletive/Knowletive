---
export interface FormField {
  name: string;
  label: string;
  type: 'text' | 'tel' | 'email' | 'select' | 'textarea';
  placeholder?: string;
  options?: { value: string; label: string }[];
  required?: boolean;
  helpText?: string;
  defaultValue?: string;
}

interface Props {
  serviceId: string;
  serviceName: string;
  primaryCta: string;
  headline?: string;
  subheadline?: string;
  customFields?: FormField[];
  formId?: string;
  compact?: boolean;
}

const {
  serviceId,
  serviceName,
  primaryCta,
  headline = `Inquire About ${serviceName}`,
  subheadline = "Fill out this brief form and our dedicated specialist will connect with you within 24 working hours.",
  customFields = [],
  formId = "lead-form",
  compact = false
} = Astro.props;
---

<div id={formId} class={`card-premium border border-gray-200 shadow-xl bg-white relative overflow-hidden ${compact ? 'p-6' : 'p-6 sm:p-8 md:p-10'}`} data-analytics-section="lead-form">
  
  <!-- Subtle Top Accent Gradient -->
  <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#072B6F] via-[#0878E8] to-[#F47A16]"></div>

  <!-- Header -->
  <div class="mb-6">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 text-[#0878E8] font-bold text-[11px] tracking-wide uppercase mb-2">
      <svg class="w-3.5 h-3.5 text-[#F47A16]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
      Direct & Confidential Inquiry
    </div>
    <h3 class="text-xl sm:text-2xl font-manrope font-extrabold text-[#0B1F3A] leading-tight">
      {headline}
    </h3>
    {subheadline && (
      <p class="text-xs sm:text-sm text-[#64748B] mt-1.5 leading-relaxed">
        {subheadline}
      </p>
    )}
  </div>

  <!-- Alert Boxes -->
  <div id={`${formId}-error`} class="hidden mb-4 p-3.5 bg-red-50 border border-red-200 rounded-xl text-red-700 text-xs font-medium" role="alert"></div>

  <div id={`${formId}-success`} class="hidden mb-4 p-5 bg-emerald-50 border border-emerald-200 rounded-2xl text-emerald-800 space-y-3" role="status">
    <div class="flex items-center gap-2 font-bold text-sm text-emerald-900">
      <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      Inquiry Successfully Saved!
    </div>
    <p class="text-xs leading-relaxed text-emerald-800">
      Thank you for contacting Knowletive. Your inquiry for <strong class="text-[#072B6F]">{serviceName}</strong> has been logged in our system. A senior advisor will review your requirements and reach out shortly.
    </p>
    <div class="pt-2 flex flex-wrap gap-2 text-xs">
      <a href="https://wa.me/919970600116" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#25D366] text-white font-bold hover:brightness-105 transition-all">
        Need Faster Support? WhatsApp Us
      </a>
    </div>
  </div>

  <!-- Form Body -->
  <form id={`${formId}-element`} class="space-y-4" novalidate>
    
    <!-- Hidden Metadata & Anti-Spam Honeypot -->
    <input type="hidden" name="serviceInterest" value={serviceName} />
    <input type="hidden" name="leadType" value={serviceName} />
    <input type="hidden" name="source" value={`Landing Page: ${serviceName}`} />
    <input type="hidden" name="landingPage" value="" id={`${formId}-landing-page`} />
    <!-- Honeypot (hidden from human visitors) -->
    <div class="hidden" aria-hidden="true" tabindex="-1">
      <label for={`${formId}-hp`}>Leave this empty</label>
      <input type="text" id={`${formId}-hp`} name="_hp" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Base Required Fields: Full Name & Mobile Number -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
      <div>
        <label for={`${formId}-name`} class="block text-xs font-bold text-[#0B1F3A] mb-1">
          Full Name <span class="text-[#F47A16]">*</span>
        </label>
        <input 
          type="text" 
          id={`${formId}-name`} 
          name="name" 
          required 
          placeholder="e.g. Aniket Deshmukh" 
          class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs text-[#0B1F3A] placeholder-gray-400 focus:outline-none focus:border-[#0878E8] focus:ring-1 focus:ring-[#0878E8] transition-all bg-white"
          autocomplete="name"
        />
        <p class="field-error text-[11px] text-red-500 mt-1 hidden"></p>
      </div>

      <div>
        <label for={`${formId}-phone`} class="block text-xs font-bold text-[#0B1F3A] mb-1">
          Mobile Number <span class="text-[#F47A16]">*</span>
        </label>
        <div class="relative flex">
          <span class="inline-flex items-center px-3 rounded-l-xl border border-r-0 border-gray-200 bg-gray-50 text-gray-500 text-xs font-semibold select-none">
            +91
          </span>
          <input 
            type="tel" 
            id={`${formId}-phone`} 
            name="phone" 
            required 
            inputmode="numeric" 
            maxlength="10" 
            placeholder="10-digit number" 
            class="w-full px-3.5 py-2.5 rounded-r-xl border border-gray-200 text-xs text-[#0B1F3A] placeholder-gray-400 focus:outline-none focus:border-[#0878E8] focus:ring-1 focus:ring-[#0878E8] transition-all bg-white"
            autocomplete="tel"
          />
        </div>
        <p class="field-error text-[11px] text-red-500 mt-1 hidden"></p>
      </div>
    </div>

    <!-- Email Address (Optional for phone-first forms, required where designated) -->
    <div>
      <label for={`${formId}-email`} class="block text-xs font-bold text-[#0B1F3A] mb-1">
        Email Address <span class="text-gray-400 font-normal">(Optional for updates)</span>
      </label>
      <input 
        type="email" 
        id={`${formId}-email`} 
        name="email" 
        placeholder="name@example.com" 
        class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs text-[#0B1F3A] placeholder-gray-400 focus:outline-none focus:border-[#0878E8] focus:ring-1 focus:ring-[#0878E8] transition-all bg-white"
        autocomplete="email"
      />
      <p class="field-error text-[11px] text-red-500 mt-1 hidden"></p>
    </div>

    <!-- Custom Service-Specific Fields -->
    {customFields.map((field) => (
      <div>
        <label for={`${formId}-${field.name}`} class="block text-xs font-bold text-[#0B1F3A] mb-1">
          {field.label} {field.required && <span class="text-[#F47A16]">*</span>}
        </label>

        {field.type === 'select' ? (
          <select 
            id={`${formId}-${field.name}`} 
            name={field.name} 
            required={field.required}
            class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs text-[#0B1F3A] focus:outline-none focus:border-[#0878E8] focus:ring-1 focus:ring-[#0878E8] transition-all bg-white"
          >
            <option value="" disabled selected>{field.placeholder || `Select ${field.label}`}</option>
            {field.options?.map(opt => (
              <option value={opt.value} selected={field.defaultValue === opt.value}>{opt.label}</option>
            ))}
          </select>
        ) : field.type === 'textarea' ? (
          <textarea 
            id={`${formId}-${field.name}`} 
            name={field.name} 
            rows="3" 
            placeholder={field.placeholder || "Tell us briefly about your goals or questions..."} 
            class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs text-[#0B1F3A] placeholder-gray-400 focus:outline-none focus:border-[#0878E8] focus:ring-1 focus:ring-[#0878E8] transition-all bg-white resize-y"
          ></textarea>
        ) : (
          <input 
            type={field.type} 
            id={`${formId}-${field.name}`} 
            name={field.name} 
            required={field.required} 
            placeholder={field.placeholder || ""} 
            value={field.defaultValue || ""}
            class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs text-[#0B1F3A] placeholder-gray-400 focus:outline-none focus:border-[#0878E8] focus:ring-1 focus:ring-[#0878E8] transition-all bg-white"
          />
        )}
        <p class="field-error text-[11px] text-red-500 mt-1 hidden"></p>
        {field.helpText && (
          <p class="text-[10px] text-gray-400 mt-1">{field.helpText}</p>
        )}
      </div>
    ))}

    <!-- Optional Question / Message (if not already in customFields) -->
    {!customFields.some(f => f.name === 'message' || f.name === 'question' || f.name === 'requirement') && (
      <div>
        <label for={`${formId}-message`} class="block text-xs font-bold text-[#0B1F3A] mb-1">
          Specific Question or Requirement <span class="text-gray-400 font-normal">(Optional)</span>
        </label>
        <textarea 
          id={`${formId}-message`} 
          name="message" 
          rows="2" 
          placeholder="Any specific courses, colleges, timeline, or requirement?" 
          class="w-full px-3.5 py-2 rounded-xl border border-gray-200 text-xs text-[#0B1F3A] placeholder-gray-400 focus:outline-none focus:border-[#0878E8] focus:ring-1 focus:ring-[#0878E8] transition-all bg-white resize-y"
        ></textarea>
      </div>
    )}

    <!-- Consent & Privacy -->
    <div class="space-y-2 pt-1 border-t border-gray-100">
      <div class="flex items-start gap-2">
        <input 
          type="checkbox" 
          id={`${formId}-privacy`} 
          name="privacyConsent" 
          checked 
          required 
          class="mt-1 h-3.5 w-3.5 text-[#0878E8] border-gray-300 rounded focus:ring-[#0878E8]" 
        />
        <label for={`${formId}-privacy`} class="text-[11px] text-[#64748B] leading-tight select-none">
          I agree to the <a href="/privacy" target="_blank" class="text-[#0878E8] hover:underline">Privacy Policy</a> and consent to being contacted by Knowletive regarding this service.
        </label>
      </div>

      <div class="flex items-start gap-2">
        <input 
          type="checkbox" 
          id={`${formId}-marketing`} 
          name="marketingConsent" 
          class="mt-1 h-3.5 w-3.5 text-[#0878E8] border-gray-300 rounded focus:ring-[#0878E8]" 
        />
        <label for={`${formId}-marketing`} class="text-[11px] text-gray-500 leading-tight select-none">
          (Optional) Send me admission dates, course notifications and career resources on WhatsApp/Email.
        </label>
      </div>
    </div>

    <!-- Submit Button -->
    <button 
      type="submit" 
      id={`${formId}-submit`} 
      class="btn-primary w-full py-3.5 px-6 text-sm font-bold shadow-lg hover:shadow-xl transition-all cursor-pointer flex items-center justify-center gap-2"
    >
      <span class="btn-text">{primaryCta}</span>
      <svg class="btn-spinner w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
      </svg>
    </button>

    <!-- Factual reassurance -->
    <p class="text-[11px] text-center text-gray-400">
      🔒 100% Privacy Protected. No spam, ever.
    </p>

  </form>
</div>

<script define:vars={{ formId, serviceName, primaryCta }}>
  (function() {
    const formEl = document.getElementById(`${formId}-element`);
    const submitBtn = document.getElementById(`${formId}-submit`);
    const errorBox = document.getElementById(`${formId}-error`);
    const successBox = document.getElementById(`${formId}-success`);
    const landingInput = document.getElementById(`${formId}-landing-page`);

    if (landingInput) {
      landingInput.value = window.location.pathname;
    }

    if (!formEl || !submitBtn) return;

    let isSubmitting = false;

    formEl.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (isSubmitting) return;

      if (errorBox) {
        errorBox.textContent = '';
        errorBox.classList.add('hidden');
      }

      const formData = new FormData(formEl);
      const data = Object.fromEntries(formData.entries());

      // Client-side validation
      const name = String(data.name || '').trim();
      const rawPhone = String(data.phone || '').trim();
      const email = String(data.email || '').trim();
      const privacy = formData.get('privacyConsent');

      if (!name) {
        showError('Please enter your full name.');
        return;
      }

      let cleanPhone = rawPhone.replace(/\D/g, '');
      if (cleanPhone.startsWith('91') && cleanPhone.length === 12) {
        cleanPhone = cleanPhone.slice(2);
      }

      if (!cleanPhone || cleanPhone.length !== 10) {
        showError('Please enter a valid 10-digit mobile number.');
        return;
      }

      if (!/^[6-9][0-9]{9}$/.test(cleanPhone)) {
        showError('Please enter a valid Indian mobile number starting with 6, 7, 8, or 9.');
        return;
      }

      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('Please enter a valid email address.');
        return;
      }

      if (!privacy) {
        showError('Please agree to the privacy policy to continue.');
        return;
      }

      // Check honeypot
      if (data._hp) {
        // Silent success for bots
        formEl.reset();
        return;
      }

      // Check custom required fields
      const requiredInputs = formEl.querySelectorAll('[required]');
      for (const input of requiredInputs) {
        const inp = input;
        if (!inp.value.trim()) {
          showError(`Please fill in the ${inp.labels?.[0]?.textContent?.replace('*', '').trim() || 'required'} field.`);
          inp.focus();
          return;
        }
      }

      // Read stored UTM parameters
      try {
        const storedUtm = sessionStorage.getItem('k_utm');
        if (storedUtm) {
          const parsed = JSON.parse(storedUtm);
          Object.assign(data, parsed);
        }
      } catch {}

      // Set Loading State
      isSubmitting = true;
      submitBtn.disabled = true;
      const btnText = submitBtn.querySelector('.btn-text');
      const btnSpinner = submitBtn.querySelector('.btn-spinner');
      if (btnText) btnText.textContent = 'Submitting Inquiry...';
      if (btnSpinner) btnSpinner.classList.remove('hidden');

      try {
        const res = await fetch('/api/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await res.json().catch(() => ({}));

        if (!res.ok || result.error) {
          throw new Error(result.error || 'Failed to submit inquiry. Please check your information.');
        }

        // Fire analytics conversion event
        if (typeof window !== 'undefined' && (window).dataLayer) {
          (window).dataLayer.push({
            event: 'lead_form_submitted',
            service_id: serviceName,
            lead_id: result.leadId
          });
        }

        // Save submitted state to prevent duplicate count on refresh
        sessionStorage.setItem('k_last_lead', JSON.stringify({
          service: serviceName,
          leadId: result.leadId,
          timestamp: Date.now()
        }));

        // Redirect to thank-you page with service parameter
        const targetUrl = `/thank-you?service=${encodeURIComponent(serviceName)}`;
        window.location.href = targetUrl;

      } catch (err) {
        showError(err.message || 'An error occurred while saving your inquiry. Please try again.');
        isSubmitting = false;
        submitBtn.disabled = false;
        if (btnText) btnText.textContent = primaryCta;
        if (btnSpinner) btnSpinner.classList.add('hidden');
      }
    });

    function showError(msg) {
      if (errorBox) {
        errorBox.textContent = msg;
        errorBox.classList.remove('hidden');
        errorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        alert(msg);
      }
    }
  })();
</script>

