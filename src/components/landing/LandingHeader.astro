---
interface Props {
  primaryCtaText: string;
  targetFormId?: string;
  serviceTitle: string;
}

const { 
  primaryCtaText, 
  targetFormId = "lead-form",
  serviceTitle
} = Astro.props;
---

<header id="landing-header" class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-sm transition-all duration-300 py-3">
  <div class="container-custom flex items-center justify-between min-h-[58px]">
    
    <!-- Logo & Service Tag -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center" aria-label="Knowletive Home">
        <img 
          src="/images/knowletive-logo-optimized.png" 
          alt="Knowletive" 
          class="h-11 md:h-13 w-auto object-contain" 
        />
      </a>
      <span class="hidden sm:inline-block h-5 w-[1px] bg-gray-200"></span>
      <span class="hidden sm:inline-block text-xs font-bold text-[#072B6F] font-manrope truncate max-w-[200px] lg:max-w-none">
        {serviceTitle}
      </span>
    </div>

    <!-- Quick Navigation Links (Desktop) -->
    <nav class="hidden lg:flex items-center gap-6 text-xs font-semibold text-[#0B1F3A]" aria-label="Landing page sections">
      <a href="#overview" class="hover:text-[#0878E8] transition-colors">Overview</a>
      <a href="#problems" class="hover:text-[#0878E8] transition-colors">Challenges</a>
      <a href="#solution" class="hover:text-[#0878E8] transition-colors">Our Solution</a>
      <a href="#benefits" class="hover:text-[#0878E8] transition-colors">Benefits</a>
      <a href="#process" class="hover:text-[#0878E8] transition-colors">How It Works</a>
      <a href="#faqs" class="hover:text-[#0878E8] transition-colors">FAQs</a>
    </nav>

    <!-- Actions: Call & Primary CTA -->
    <div class="flex items-center gap-3">
      <!-- Call Link -->
      <a 
        href="tel:+919970600116" 
        class="hidden sm:inline-flex items-center gap-1.5 text-xs font-bold text-[#0B1F3A] hover:text-[#0878E8] px-3 py-2 rounded-xl transition-colors border border-gray-200 hover:border-blue-200 hover:bg-blue-50/50"
        aria-label="Call Knowletive at +91 99706 00116"
      >
        <svg class="w-3.5 h-3.5 text-[#F47A16]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
        </svg>
        <span class="hidden md:inline">+91 99706 00116</span>
        <span class="md:hidden">Call</span>
      </a>

      <!-- Primary Page CTA Button -->
      <a 
        href={`#${targetFormId}`} 
        class="btn-primary py-2 px-4 md:py-2.5 md:px-5 text-xs md:text-sm shadow-sm hover:shadow-md"
      >
        {primaryCtaText}
      </a>
    </div>

  </div>
</header>

