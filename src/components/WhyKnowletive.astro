---
---
<section data-analytics-section="whyknowletive" class="section-padding bg-gray-50 relative">
  <div class="container-custom">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-full bg-[#F47A16]/10 text-[#F47A16] font-bold text-xs tracking-widest uppercase mb-4 border border-[#F47A16]/20">
        Why Choose Us
      </div>
      <h2 class="fluid-h2 mb-4">
        We Don't Just Train.<br/>
        <span class="text-gradient">We Transform Careers.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 auto-rows-[minmax(180px,auto)]">
      
      <!-- Bento 1: Large Span -->
      <div class="card-premium lg:col-span-2 lg:row-span-2 bg-[#0B1F3A] border-none text-white relative overflow-hidden group">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNjAiIGhlaWdodD0iNjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMzAiIGN5PSIzMCIgcj0iMSIgZmlsbD0icmdiYSgyNTUsMjU1LDI1NSwwLjEpIi8+PC9zdmc+')] [background-size:30px_30px] opacity-30 group-hover:opacity-50 transition-opacity duration-500"></div>
        <div class="relative z-10 h-full flex flex-col justify-between">
          <div class="w-14 h-14 rounded-2xl bg-[#0878E8]/20 flex items-center justify-center mb-6 text-[#0878E8]">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
          </div>
          <div>
            <h3 class="text-2xl font-bold mb-3">Strong Industry Connections</h3>
            <p class="text-blue-100/80 leading-relaxed text-sm md:text-base max-w-sm">
              Our network of 210+ hiring partners opens doors to exceptional career opportunities at top organizations worldwide.
            </p>
          </div>
        </div>
      </div>

      <!-- Bento 2 -->
      <div class="card-premium bg-white border border-gray-100 group">
        <div class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center mb-4 text-[#F47A16] group-hover:scale-110 transition-transform duration-300">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
        </div>
        <h4 class="font-bold text-[#0B1F3A] mb-2">Expert Faculty</h4>
        <p class="text-sm text-[#64748B]">Learn from professionals with 10+ years of real-world experience.</p>
      </div>

      <!-- Bento 3 -->
      <div class="card-premium bg-white border border-gray-100 group">
        <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center mb-4 text-[#0878E8] group-hover:scale-110 transition-transform duration-300">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        </div>
        <h4 class="font-bold text-[#0B1F3A] mb-2">Practical Learning</h4>
        <p class="text-sm text-[#64748B]">Hands-on training with real datasets, projects, and case studies.</p>
      </div>

      <!-- Bento 4: Wide Span -->
      <div class="card-premium md:col-span-2 bg-[#0878E8] border-none text-white group flex flex-col justify-center">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 shrink-0 rounded-xl bg-white/20 flex items-center justify-center text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          </div>
          <div>
            <h4 class="font-bold text-xl mb-2">Personalized Guidance</h4>
            <p class="text-blue-100 text-sm">One-to-one mentoring and continuous support throughout your entire learning journey and beyond.</p>
          </div>
        </div>
      </div>

      <!-- Bento 5 -->
      <div class="card-premium bg-white border border-gray-100 group">
        <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center mb-4 text-green-600 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h4 class="font-bold text-[#0B1F3A] mb-2">Proven Results</h4>
        <p class="text-sm text-[#64748B]">5,000+ students trained with growing success stories every year.</p>
      </div>

      <!-- Bento 6 -->
      <div class="card-premium bg-white border border-gray-100 group">
        <div class="w-10 h-10 rounded-xl bg-purple-50 flex items-center justify-center mb-4 text-purple-600 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h4 class="font-bold text-[#0B1F3A] mb-2">Flexible Learning</h4>
        <p class="text-sm text-[#64748B]">Weekend & weekday batches with options to fit your schedule.</p>
      </div>

    </div>
  </div>
</section>
