---
---
<section data-analytics-section="courses" id="courses" class="section-padding bg-white relative">
  <div class="container-custom">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#F47A16]/10 text-[#F47A16] font-bold text-xs tracking-widest uppercase mb-4">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
          Technical Training
        </div>
        <h2 class="fluid-h2">
          Build Skills the Industry<br/>
          <span class="text-gradient">Actually Needs.</span>
        </h2>
      </div>
      <a href="/courses" class="text-[#0878E8] font-bold hover:text-[#0B1F3A] transition-colors flex items-center gap-2 group whitespace-nowrap">
        View All Courses
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- Course 1 -->
      <div class="card-premium group relative border border-gray-100 flex flex-col justify-between overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-[#0878E8]/5 rounded-bl-[100px] -z-10 group-hover:scale-110 transition-transform duration-500"></div>
        <div>
          <div class="w-14 h-14 rounded-2xl bg-blue-50 flex items-center justify-center mb-6 text-[#0878E8]">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold mb-3 text-[#0B1F3A]">Data Science & AI/ML</h3>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-gray-50 rounded-full text-xs font-semibold text-[#64748B]">Python</span>
            <span class="px-3 py-1 bg-gray-50 rounded-full text-xs font-semibold text-[#64748B]">Machine Learning</span>
            <span class="px-3 py-1 bg-gray-50 rounded-full text-xs font-semibold text-[#64748B]">Deep Learning</span>
            <span class="px-3 py-1 bg-gray-50 rounded-full text-xs font-semibold text-[#64748B]">GenAI</span>
            <span class="px-3 py-1 bg-gray-50 rounded-full text-xs font-semibold text-[#64748B]">+ more</span>
          </div>
        </div>
        <div class="pt-6 mt-4 border-t border-gray-100 flex items-center justify-between">
          <span class="text-sm font-semibold text-[#64748B]">Real-world AI projects</span>
          <a href="/courses/data-science-ai-ml" class="btn-primary py-2 px-5 text-sm group-hover:shadow-lg">Explore Curriculum</a>
        </div>
      </div>

      <!-- Course 2 -->
      <div class="card-premium group relative border border-gray-100 flex flex-col justify-between overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-[#F47A16]/5 rounded-bl-[100px] -z-10 group-hover:scale-110 transition-transform duration-500"></div>
        <div>
          <div class="w-14 h-14 rounded-2xl bg-orange-50 flex items-center justify-center mb-6 text-[#F47A16]">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold mb-3 text-[#0B1F3A]">Data Analyst</h3>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-gray-50 rounded-full text-xs font-semibold text-[#64748B]">Advanced Excel</span>
            <span class="px-3 py-1 bg-gray-50 rounded-full text-xs font-semibold text-[#64748B]">SQL</span>
            <span class="px-3 py-1 bg-gray-50 rounded-full text-xs font-semibold text-[#64748B]">Power BI</span>
            <span class="px-3 py-1 bg-gray-50 rounded-full text-xs font-semibold text-[#64748B]">EDA</span>
            <span class="px-3 py-1 bg-gray-50 rounded-full text-xs font-semibold text-[#64748B]">+ more</span>
          </div>
        </div>
        <div class="pt-6 mt-4 border-t border-gray-100 flex items-center justify-between">
          <span class="text-sm font-semibold text-[#64748B]">Business Problem Solving</span>
          <a href="/courses/data-analysis" class="btn-primary py-2 px-5 text-sm group-hover:shadow-lg bg-[#0B1F3A] hover:bg-[#1a2d4c]">Explore Curriculum</a>
        </div>
      </div>



    </div>
  </div>
</section>
