---
---
<section data-analytics-section="process" id="process" class="section-padding bg-white relative">
  <div class="container-custom">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-full bg-[#0878E8]/10 text-[#0878E8] font-bold text-xs tracking-widest uppercase mb-4 border border-[#0878E8]/20">
        How It Works
      </div>
      <h2 class="fluid-h2 mb-4">
        Your Journey with<br/>
        <span class="text-gradient">Knowletive</span>
      </h2>
      <p class="text-[#64748B] text-lg max-w-2xl mx-auto">A clear, simple process designed to get you from where you are to where you want to be.</p>
    </div>

    <div class="relative max-w-5xl mx-auto mt-20">
      <!-- Horizontal Timeline Line (Desktop) -->
      <div class="hidden md:block absolute top-[2.75rem] left-[10%] right-[10%] h-0.5 bg-gradient-to-r from-transparent via-[#0878E8]/30 to-transparent z-0"></div>
      
      <!-- Vertical Timeline Line (Mobile) -->
      <div class="md:hidden absolute top-[10%] bottom-[10%] left-[2.75rem] w-0.5 bg-gradient-to-b from-[#0878E8]/30 via-[#0878E8]/30 to-transparent z-0"></div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-8 md:gap-4 relative z-10">
        
        <!-- Step 1 -->
        <div class="flex md:flex-col items-center md:text-center gap-6 md:gap-4 group">
          <div class="w-16 h-16 sm:w-20 sm:h-20 shrink-0 rounded-full bg-white border-2 border-[#0878E8]/20 flex items-center justify-center font-manrope font-extrabold text-xl text-[#0878E8] group-hover:border-[#0878E8] group-hover:bg-[#0878E8] group-hover:text-white group-hover:shadow-[0_0_20px_rgba(8,120,232,0.3)] transition-all duration-300 relative z-10">
            01
          </div>
          <div>
            <h4 class="font-bold text-[#0B1F3A] text-lg mb-2">Discover</h4>
            <p class="text-sm text-[#64748B] leading-relaxed">Understand goals, skills and career interests.</p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="flex md:flex-col items-center md:text-center gap-6 md:gap-4 group">
          <div class="w-16 h-16 sm:w-20 sm:h-20 shrink-0 rounded-full bg-white border-2 border-[#0878E8]/20 flex items-center justify-center font-manrope font-extrabold text-xl text-[#0878E8] group-hover:border-[#0878E8] group-hover:bg-[#0878E8] group-hover:text-white group-hover:shadow-[0_0_20px_rgba(8,120,232,0.3)] transition-all duration-300 relative z-10">
            02
          </div>
          <div>
            <h4 class="font-bold text-[#0B1F3A] text-lg mb-2">Learn</h4>
            <p class="text-sm text-[#64748B] leading-relaxed">Industry-aligned training with expert faculty.</p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="flex md:flex-col items-center md:text-center gap-6 md:gap-4 group">
          <div class="w-16 h-16 sm:w-20 sm:h-20 shrink-0 rounded-full bg-white border-2 border-[#0878E8]/20 flex items-center justify-center font-manrope font-extrabold text-xl text-[#0878E8] group-hover:border-[#0878E8] group-hover:bg-[#0878E8] group-hover:text-white group-hover:shadow-[0_0_20px_rgba(8,120,232,0.3)] transition-all duration-300 relative z-10">
            03
          </div>
          <div>
            <h4 class="font-bold text-[#0B1F3A] text-lg mb-2">Build</h4>
            <p class="text-sm text-[#64748B] leading-relaxed">Real-world projects and practical work.</p>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="flex md:flex-col items-center md:text-center gap-6 md:gap-4 group">
          <div class="w-16 h-16 sm:w-20 sm:h-20 shrink-0 rounded-full bg-white border-2 border-[#0878E8]/20 flex items-center justify-center font-manrope font-extrabold text-xl text-[#0878E8] group-hover:border-[#0878E8] group-hover:bg-[#0878E8] group-hover:text-white group-hover:shadow-[0_0_20px_rgba(8,120,232,0.3)] transition-all duration-300 relative z-10">
            04
          </div>
          <div>
            <h4 class="font-bold text-[#0B1F3A] text-lg mb-2">Prepare</h4>
            <p class="text-sm text-[#64748B] leading-relaxed">Resume, LinkedIn and interview preparation.</p>
          </div>
        </div>

        <!-- Step 5 -->
        <div class="flex md:flex-col items-center md:text-center gap-6 md:gap-4 group">
          <div class="w-16 h-16 sm:w-20 sm:h-20 shrink-0 rounded-full bg-white border-2 border-[#F47A16]/20 flex items-center justify-center font-manrope font-extrabold text-xl text-[#F47A16] group-hover:border-[#F47A16] group-hover:bg-[#F47A16] group-hover:text-white group-hover:shadow-[0_0_20px_rgba(244,122,22,0.3)] transition-all duration-300 relative z-10">
            05
          </div>
          <div>
            <h4 class="font-bold text-[#0B1F3A] text-lg mb-2">Launch</h4>
            <p class="text-sm text-[#64748B] leading-relaxed">Internship and placement assistance.</p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
