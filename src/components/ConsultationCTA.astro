---
---
<section id="consultation" data-analytics-section="consultation" class="py-24 bg-white relative overflow-hidden border-t border-gray-100">
  <div class="absolute inset-0 z-0 opacity-40">
    <div class="absolute inset-0" style="background-image: radial-gradient(#0878E8 1px, transparent 1px); background-size: 40px 40px; mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);"></div>
  </div>

  <div class="container-custom relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      
      <!-- Left side: Content -->
      <div class="text-left flex flex-col items-start md:items-center lg:items-start md:text-center lg:text-left">
        <div class="w-20 h-20 bg-blue-50 rounded-full flex items-center justify-center text-[#0878E8] mb-8 shadow-sm">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path></svg>
        </div>
        
        <h2 class="text-4xl md:text-5xl font-manrope font-extrabold text-[#0B1F3A] mb-6 leading-tight">
          Ready to Take the <span class="text-gradient">Next Step?</span>
        </h2>
        
        <p class="text-[#64748B] text-lg md:text-xl max-w-xl mb-10 leading-relaxed mx-auto lg:mx-0">
          Talk to our expert admission counselors to map out your career path, discuss programs, and find your perfect fit.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start w-full sm:w-auto gap-4">
          <a href="/contact" class="btn-primary py-4 px-8 text-lg w-full sm:w-auto text-center shadow-xl shadow-[#0878E8]/20 hover:-translate-y-1 transition-transform">
            Book Free Consultation
          </a>
          <a href="tel:+919970600116" class="btn-secondary py-4 px-8 text-lg w-full sm:w-auto text-center hover:-translate-y-1 transition-transform flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            Call +91 99706 00116
          </a>
        </div>
      </div>

      <!-- Right side: Map -->
      <div class="w-full relative mt-8 lg:mt-0">
        <div class="bg-white p-2 sm:p-3 rounded-[24px] shadow-xl shadow-[#0878E8]/5 border border-gray-200">
          <div class="relative rounded-[16px] overflow-hidden w-full h-[320px] lg:h-[420px] bg-gray-100 z-0 border border-gray-100">
            <iframe 
              src="https://maps.google.com/maps?q=Knowletive+Learning+Center,+Baner,+Pune,+Maharashtra+411045&t=&z=15&ie=UTF8&iwloc=&output=embed" 
              width="100%" 
              height="100%" 
              style="border:0;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              title="Knowletive Office Location - Baner, Pune"
              class="absolute inset-0"
            ></iframe>
          </div>
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-4 px-2 pb-2 text-center sm:text-left">
            <div>
              <p class="font-bold text-[#0B1F3A] text-lg">Knowletive Office</p>
              <p class="text-sm text-[#64748B]">Baner, Pune, Maharashtra</p>
            </div>
            <a 
              href="https://www.google.com/maps/dir//Knowletive+Learning+Center,+Baner,+Pune,+Maharashtra+411045" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-[#0878E8]/5 text-[#0878E8] font-bold text-sm hover:bg-[#0878E8] hover:text-white transition-all whitespace-nowrap"
            >
              Get Directions <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
