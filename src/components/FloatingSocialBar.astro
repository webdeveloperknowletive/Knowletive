  {
    name: 'WhatsApp',
    url: 'https://wa.me/919970600116',
    icon: `<svg class="w-5 h-5 lg:w-6 lg:h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>`,
    desktopColor: 'text-[#25D366] hover:shadow-[0_4px_12px_rgba(37,211,102,0.35)]',
    mobileColor: 'bg-white text-[#25D366] shadow-md'
  }
];
---

<!-- DESKTOP / TABLET: Vertical right-aligned fixed bar -->
<!-- Visible at md (769px) and above -->
<div class="desktop-social-bar hidden md:flex flex-col items-center justify-center gap-3 p-3 bg-white/90 backdrop-blur-md shadow-[0_4px_24px_rgba(0,0,0,0.08)] border border-gray-100 rounded-2xl animate-fade-in-right">
  {socialLinks.map((link) => (
    <a 
      href={link.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={link.name}
      class={`group relative flex items-center justify-center w-10 h-10 lg:w-11 lg:h-11 rounded-xl transition-all duration-200 hover:scale-[1.08] hover:brightness-110 focus:outline-none focus:ring-2 focus:ring-[#F47A16] ${link.desktopColor}`}
    >
      <Fragment set:html={link.icon} />
      
      <!-- Tooltip -->
      <span class="absolute right-full mr-4 top-1/2 -translate-y-1/2 px-3 py-1.5 bg-[#0B1F3A] text-white text-xs font-semibold rounded-lg opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap shadow-xl">
        {link.name}
        <span class="absolute left-full top-1/2 -translate-y-1/2 border-4 border-transparent border-l-[#0B1F3A]"></span>
      </span>
    </a>
  ))}
</div>

<!-- MOBILE: Expandable Floating Action Button (FAB) -->
<!-- Visible below md (768px) -->
<div class="mobile-social-fab md:hidden">
  
  <!-- The expanded menu (hidden by default) -->
  <div id="mobile-social-menu" class="absolute bottom-full right-0 mb-3 flex flex-col gap-3 items-end transition-all duration-300 opacity-0 pointer-events-none scale-90 origin-bottom">
    {[...socialLinks].reverse().map((link) => (
      <a 
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={link.name}
        class={`flex items-center justify-center w-[44px] h-[44px] rounded-full transition-transform active:scale-95 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#F47A16] ${link.mobileColor}`}
      >
        <Fragment set:html={link.icon} />
      </a>
    ))}
  </div>

  <!-- The main FAB toggle button -->
  <button 
    id="fab-social-toggle"
    aria-label="Toggle Social Menu"
    aria-expanded="false"
    aria-controls="mobile-social-menu"
    class="flex items-center justify-center w-[48px] h-[48px] rounded-full bg-[#0B1F3A] text-white shadow-xl transition-transform active:scale-95 hover:bg-[#12315c] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#F47A16]"
  >
    <svg id="fab-icon-open" class="w-6 h-6 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path>
    </svg>
    <svg id="fab-icon-close" class="w-6 h-6 absolute opacity-0 transition-transform duration-300 -rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
</div>

<script>
  // Mobile FAB Toggle Logic
  const fabToggle = document.getElementById('fab-social-toggle');
  const socialMenu = document.getElementById('mobile-social-menu');
  const iconOpen = document.getElementById('fab-icon-open');
  const iconClose = document.getElementById('fab-icon-close');

  let isMenuOpen = false;

  if (fabToggle && socialMenu && iconOpen && iconClose) {
    fabToggle.addEventListener('click', () => {
      isMenuOpen = !isMenuOpen;
      
      fabToggle.setAttribute('aria-expanded', isMenuOpen.toString());

      if (isMenuOpen) {
        // Show menu
        socialMenu.classList.remove('opacity-0', 'pointer-events-none', 'scale-90');
        socialMenu.classList.add('opacity-100', 'pointer-events-auto', 'scale-100');
        
        // Animate icons
        iconOpen.classList.add('opacity-0', 'rotate-90');
        iconClose.classList.remove('opacity-0', '-rotate-90');
      } else {
        // Hide menu
        socialMenu.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100');
        socialMenu.classList.add('opacity-0', 'pointer-events-none', 'scale-90');
        
        // Animate icons
        iconOpen.classList.remove('opacity-0', 'rotate-90');
        iconClose.classList.add('opacity-0', '-rotate-90');
      }
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      if (isMenuOpen && !fabToggle.contains(e.target as Node) && !socialMenu.contains(e.target as Node)) {
        fabToggle.click();
      }
    });
  }
</script>

<style>
  /* Base position for desktop */
  .desktop-social-bar {
    position: fixed;
    top: 50%;
    right: 16px;
    transform: translateY(-50%);
    z-index: 9999;
  }

  /* Base position for mobile FAB */
  .mobile-social-fab {
    display: flex;
    position: fixed;
    right: 16px;
    bottom: 24px;
    bottom: calc(16px + env(safe-area-inset-bottom, 16px));
    z-index: 9999;
  }

  @keyframes fadeInRight {
    from {
      opacity: 0;
      transform: translate(20px, -50%);
    }
    to {
      opacity: 1;
      transform: translate(0, -50%);
    }
  }

  /* Only animate desktop bar */
  @media (min-width: 768px) {
    .animate-fade-in-right {
      animation: fadeInRight 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  }
</style>
