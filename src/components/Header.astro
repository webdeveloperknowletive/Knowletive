---
import MobileMenu from './MobileMenu.astro';
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 py-3 md:py-4 w-full glass-nav">
  <div class="container-custom flex items-center justify-between min-h-[60px] md:min-h-[72px]">
    <!-- Logo -->
    <a href="/" class="flex items-center" aria-label="Knowletive Home">
      <img src="/images/knowletive-logo-optimized.png" alt="Knowletive Logo" class="h-14 md:h-16 lg:h-[72px] w-auto object-contain" />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8">
      <ul class="flex items-center gap-8 font-inter font-medium text-sm text-[#0B1F3A]">
        <li class="relative group">
          <a href="/services" class="flex items-center gap-1 hover:text-[#0878E8] transition-colors relative after:absolute after:-bottom-1 after:left-0 after:h-[2px] after:w-0 after:bg-[#F47A16] hover:after:w-full after:transition-all">
            Services
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </a>
          <div class="absolute top-full left-0 mt-2 w-64 bg-white rounded-xl shadow-lg border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 translate-y-2 group-hover:translate-y-0">
            <div class="py-2">
              <a href="/services/it-training-placement" class="block px-4 py-2 text-sm text-[#0B1F3A] hover:bg-blue-50 hover:text-[#0878E8]">IT Training & Placement</a>
              <a href="/services/industrial-internship" class="block px-4 py-2 text-sm text-[#0B1F3A] hover:bg-blue-50 hover:text-[#0878E8]">Industrial Internship</a>
              <a href="/services/it-projects-freshers" class="block px-4 py-2 text-sm text-[#0B1F3A] hover:bg-blue-50 hover:text-[#0878E8]">IT Projects for Freshers</a>
              <a href="/services/overseas-education" class="block px-4 py-2 text-sm text-[#0B1F3A] hover:bg-blue-50 hover:text-[#0878E8]">Overseas Education</a>
              <a href="/services/distance-learning" class="block px-4 py-2 text-sm text-[#0B1F3A] hover:bg-blue-50 hover:text-[#0878E8]">Distance Learning</a>
              <a href="/services/vocational-courses" class="block px-4 py-2 text-sm text-[#0B1F3A] hover:bg-blue-50 hover:text-[#0878E8]">Vocational Courses</a>
              <a href="/services/career-admission-counselling" class="block px-4 py-2 text-sm text-[#0B1F3A] hover:bg-blue-50 hover:text-[#0878E8]">Career & Admission Counselling</a>
            </div>
          </div>
        </li>
        <li class="relative group">
          <a href="/courses" class="flex items-center gap-1 hover:text-[#0878E8] transition-colors relative after:absolute after:-bottom-1 after:left-0 after:h-[2px] after:w-0 after:bg-[#F47A16] hover:after:w-full after:transition-all">
            Courses
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </a>
          <div class="absolute top-full left-0 mt-2 w-64 bg-white rounded-xl shadow-lg border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 translate-y-2 group-hover:translate-y-0">
            <div class="py-2">
              <a href="/courses/data-analysis" class="block px-4 py-2 text-sm text-[#0B1F3A] hover:bg-blue-50 hover:text-[#0878E8]">Data Analysis</a>
              <a href="/courses/data-science-ai-ml" class="block px-4 py-2 text-sm text-[#0B1F3A] hover:bg-blue-50 hover:text-[#0878E8]">Data Science & AI/ML</a>
              <a href="/courses/mern-stack" class="block px-4 py-2 text-sm text-[#0B1F3A] hover:bg-blue-50 hover:text-[#0878E8]">MERN Stack Development</a>
              <a href="/courses/java-full-stack" class="block px-4 py-2 text-sm text-[#0B1F3A] hover:bg-blue-50 hover:text-[#0878E8]">Java Full Stack</a>
              <a href="/courses/cloud-devops" class="block px-4 py-2 text-sm text-[#0B1F3A] hover:bg-blue-50 hover:text-[#0878E8]">Cloud & DevOps</a>
              <a href="/courses/banking" class="block px-4 py-2 text-sm text-[#0B1F3A] hover:bg-blue-50 hover:text-[#0878E8]">Banking</a>
              <a href="/courses/digital-marketing" class="block px-4 py-2 text-sm text-[#0B1F3A] hover:bg-blue-50 hover:text-[#0878E8]">Digital Marketing</a>
            </div>
          </div>
        </li>
        <li><a href="/placement-activities" class="hover:text-[#0878E8] transition-colors relative after:absolute after:-bottom-1 after:left-0 after:h-[2px] after:w-0 after:bg-[#F47A16] hover:after:w-full after:transition-all whitespace-nowrap">Placement & Activities</a></li>
        <li><a href="/internship-jobs" class="hover:text-[#0878E8] transition-colors relative after:absolute after:-bottom-1 after:left-0 after:h-[2px] after:w-0 after:bg-[#F47A16] hover:after:w-full after:transition-all whitespace-nowrap">Internship & Jobs</a></li>
        <li><a href="/free-study-material" class="hover:text-[#0878E8] transition-colors relative after:absolute after:-bottom-1 after:left-0 after:h-[2px] after:w-0 after:bg-[#F47A16] hover:after:w-full after:transition-all whitespace-nowrap">Free Study Material</a></li>
        <li><a href="/contact" class="hover:text-[#0878E8] transition-colors relative after:absolute after:-bottom-1 after:left-0 after:h-[2px] after:w-0 after:bg-[#F47A16] hover:after:w-full after:transition-all">Contact</a></li>
      </ul>
    </nav>

    <!-- CTAs & Mobile Toggle -->
    <div class="flex items-center gap-4">
      <a href="tel:+919970600116" class="hidden lg:flex items-center gap-2 text-sm font-semibold text-[#0B1F3A] hover:text-[#0878E8] transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
        Call
      </a>
      <a href="/contact" class="btn-primary hidden md:inline-flex py-2.5 px-6">Get Started</a>
      
      <!-- Hamburger -->
      <button id="mobile-menu-btn" aria-label="Toggle navigation menu" aria-expanded="false" class="md:hidden flex flex-col justify-center items-center w-10 h-10 space-y-1.5 focus:outline-none z-50">
        <span class="block w-6 h-0.5 bg-[#0B1F3A] transition-transform duration-300"></span>
        <span class="block w-6 h-0.5 bg-[#0B1F3A] transition-opacity duration-300"></span>
        <span class="block w-6 h-0.5 bg-[#0B1F3A] transition-transform duration-300"></span>
      </button>
    </div>
  </div>
</header>

<MobileMenu />

<script>
  const header = document.getElementById('site-header');
  
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header.classList.add('shadow-md', 'py-2', 'md:py-3');
      header.classList.remove('py-3', 'md:py-4');
    } else {
      header.classList.remove('shadow-md', 'py-2', 'md:py-3');
      header.classList.add('py-3', 'md:py-4');
    }
  });
</script>
