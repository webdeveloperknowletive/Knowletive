---
---
<section data-analytics-section="foundermessage" class="section-padding bg-white relative">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      
      <!-- Image Left -->
      <div class="relative w-full max-w-md mx-auto lg:mx-0 lg:max-w-none group">
        <div class="absolute inset-0 bg-gradient-to-tr from-[#0878E8]/20 to-[#F47A16]/20 rounded-3xl translate-x-4 translate-y-4 -z-10 transition-transform group-hover:translate-x-6 group-hover:translate-y-6 duration-500"></div>
        <img src="/images/founder.jpg" alt="Manoj Kulkarni, Founder & CEO of Knowletive" width="400" height="500" loading="lazy" class="w-full h-auto object-cover rounded-3xl shadow-xl aspect-[4/5] bg-gray-100" />
      </div>

      <!-- Content Right -->
      <div class="relative">
        <div class="absolute -top-10 -left-10 text-[120px] font-serif text-[#0878E8]/10 leading-none pointer-events-none select-none">"</div>
        
        <h2 class="fluid-h2 mb-10 text-[#0B1F3A]">A Message From<br/><span class="text-[#0878E8]">Our Founder</span></h2>
        
        <p class="text-xl md:text-2xl text-[#0B1F3A] font-medium leading-relaxed mb-12 italic relative z-10 border-l-4 border-[#F47A16] pl-6">
          At Knowletive, we believe education is not just about acquiring knowledge, but about building the right skills, confidence and mindset to create a better future.
        </p>

        <div>
          <h4 class="font-manrope font-bold text-2xl text-[#0B1F3A] mb-1">Manoj Kulkarni</h4>
          <p class="text-[#F47A16] font-semibold uppercase tracking-wider text-sm mb-4">Founder & CEO, Knowletive</p>
          
          <div class="font-satisfy text-4xl text-[#0878E8] opacity-70 mt-6" style="font-family: 'Brush Script MT', cursive, sans-serif;">
            M. Kulkarni
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
