---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact Us | Knowletive" 
  description="Get in touch with Knowletive for admission counseling, technical course inquiries, PEP program enrollment, and business consulting in Pune, India."
>
  <section class="relative page-header-spacing bg-[#F7F9FC] overflow-hidden border-b border-gray-200">
    <div class="container-custom relative z-10 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#0878E8]/10 text-[#0878E8] font-bold text-xs tracking-widest uppercase mb-3 border border-[#0878E8]/20">
        Get In Touch
      </div>
      <h1 class="fluid-h2 font-manrope font-extrabold mb-3 text-[#0B1F3A]">
        Let's Start a <span class="text-[#0878E8]">Conversation</span>
      </h1>
      <p class="text-[#64748B] text-base md:text-xl max-w-2xl mx-auto leading-relaxed">
        Whether you're looking to upskill, explore the PEP program, study abroad, or grow your business, our expert advisors are ready to guide you.
      </p>
    </div>
  </section>

  <section class="section-padding bg-white relative">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-8">
        
        <!-- Contact Info -->
        <div class="lg:col-span-2 flex flex-col gap-8">
          
          <div class="card-premium border border-gray-100 bg-[#0B1F3A] text-white">
            <h2 class="text-2xl font-bold mb-8 text-white">Contact Information</h2>
            
            <div class="flex items-start gap-4 mb-6">
              <div class="w-10 h-10 rounded-full bg-[#0878E8]/20 flex items-center justify-center text-[#0878E8] shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              </div>
              <div>
                <p class="font-bold text-white mb-1">Our Office</p>
                <p class="text-blue-100/80 text-sm leading-relaxed">
                  Knowletive Learning Center<br/>
                  Baner, Pune, Maharashtra 411045<br/>
                  India
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4 mb-6">
              <div class="w-10 h-10 rounded-full bg-[#F47A16]/20 flex items-center justify-center text-[#F47A16] shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div>
                <p class="font-bold text-white mb-1">Email Us</p>
                <a href="mailto:info@knowletive.com" class="text-blue-100/80 text-sm hover:text-[#0878E8] transition-colors block">info@knowletive.com</a>
                <a href="mailto:info@knowletive.in" class="text-blue-100/80 text-sm hover:text-[#0878E8] transition-colors block">info@knowletive.in</a>
              </div>
            </div>

            <div class="flex items-start gap-4 mb-6">
              <div class="w-10 h-10 rounded-full bg-[#0878E8]/20 flex items-center justify-center text-[#0878E8] shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              </div>
              <div>
                <p class="font-bold text-white mb-1">Call Us Directly</p>
                <a href="tel:+919970600116" class="text-blue-100/80 text-sm hover:text-[#0878E8] transition-colors font-semibold">+91 99706 00116</a>
                <p class="text-xs text-blue-200/60 mt-1">Mon–Sat: 9:30 AM – 7:00 PM IST</p>
              </div>
            </div>

            <div class="pt-6 border-t border-white/10">
              <p class="text-xs text-blue-200/70 leading-relaxed">
                Walk-in consultations are welcome with prior appointments. We provide 100% free initial career guidance sessions.
              </p>
            </div>
            
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-3">
          <div class="card-premium border border-gray-200 shadow-xl shadow-[#0878E8]/5 bg-white">
            <h2 class="text-2xl font-bold mb-2 text-[#0B1F3A]">Send us a Message</h2>
            <p class="text-[#64748B] text-sm mb-6">Fill in the form below and an advisor will get back to you within 24 hours.</p>
            
            <div id="contact-status" class="mb-6 hidden p-4 rounded-xl text-sm" role="alert"></div>

            <form id="contact-form" class="space-y-6" novalidate>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-2">
                  <label for="firstName" class="text-sm font-semibold text-[#0B1F3A]">First Name <span class="text-red-500">*</span></label>
                  <input type="text" id="firstName" name="firstName" required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#0878E8] focus:ring-2 focus:ring-[#0878E8]/20 outline-none transition-all" placeholder="e.g. Rahul" autocomplete="given-name">
                </div>
                <div class="space-y-2">
                  <label for="lastName" class="text-sm font-semibold text-[#0B1F3A]">Last Name <span class="text-red-500">*</span></label>
                  <input type="text" id="lastName" name="lastName" required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#0878E8] focus:ring-2 focus:ring-[#0878E8]/20 outline-none transition-all" placeholder="e.g. Sharma" autocomplete="family-name">
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-2">
                  <label for="email" class="text-sm font-semibold text-[#0B1F3A]">Email Address <span class="text-red-500">*</span></label>
                  <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#0878E8] focus:ring-2 focus:ring-[#0878E8]/20 outline-none transition-all" placeholder="rahul@example.com" autocomplete="email">
                </div>
                <div class="space-y-2">
                  <label for="phone" class="text-sm font-semibold text-[#0B1F3A]">Phone Number <span class="text-red-500">*</span></label>
                  <input 
                    type="tel" 
                    id="phone" 
                    name="phone" 
                    required 
                    inputmode="numeric" 
                    maxlength="10" 
                    pattern="[0-9]{10}" 
                    class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#0878E8] focus:ring-2 focus:ring-[#0878E8]/20 outline-none transition-all" 
                    placeholder="10-digit mobile number" 
                    autocomplete="tel"
                  >
                </div>
              </div>

              <div class="space-y-2">
                <label for="interest" class="text-sm font-semibold text-[#0B1F3A]">Program / Service of Interest <span class="text-red-500">*</span></label>
                <select id="interest" name="interest" required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#0878E8] focus:ring-2 focus:ring-[#0878E8]/20 outline-none transition-all bg-white appearance-none">
                  <option value="" disabled selected>Select an option</option>
                  <option value="PEP Program">Flagship PEP Program (Training + Internship + Placement)</option>
                  <option value="Data Science & AI/ML">Data Science & AI/ML Course</option>
                  <option value="Data Analyst">Data Analyst Course</option>
                  <option value="MERN Stack">MERN Stack Development Course</option>
                  <option value="Java Full Stack">Java Full Stack Development Course</option>
                  <option value="Overseas Education">Overseas Education Consulting</option>
                  <option value="Career Guidance">1-on-1 Career Guidance</option>
                  <option value="Business Consulting">Business / Corporate Consulting</option>
                  <option value="CET 2026">CET 2026 Guidance</option>
                  <option value="Other">Other Query</option>
                </select>
              </div>

              <div class="space-y-2">
                <label for="message" class="text-sm font-semibold text-[#0B1F3A]">Message <span class="text-red-500">*</span></label>
                <textarea id="message" name="message" rows="4" required class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#0878E8] focus:ring-2 focus:ring-[#0878E8]/20 outline-none transition-all resize-y" placeholder="Tell us about your background, career goals, or any specific questions you have..."></textarea>
              </div>

              <div class="flex items-start gap-2 pt-1">
                <input type="checkbox" id="privacyConsent" name="privacyConsent" required checked class="mt-1 rounded text-[#0878E8] focus:ring-[#0878E8]" />
                <label for="privacyConsent" class="text-xs text-[#64748B] leading-relaxed">
                  I consent to Knowletive storing and reviewing my details to contact me regarding my inquiry. View our <a href="/privacy" class="text-[#0878E8] underline hover:text-[#072B6F]">Privacy Policy</a>. <span class="text-red-500">*</span>
                </label>
              </div>

              <button type="submit" id="contact-submit" class="btn-primary w-full shadow-lg shadow-[#F47A16]/20 py-4 text-base cursor-pointer">
                Send Message
              </button>

            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<script>
  import { isValidEmail } from '../lib/validators';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusDiv = document.getElementById('contact-status') as HTMLDivElement | null;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const phoneInput = document.getElementById('phone') as HTMLInputElement | null;

  // Real-time phone sanitization & strict digit blocking
  if (phoneInput) {
    phoneInput.addEventListener('input', () => {
      let clean = phoneInput.value.replace(/\D/g, '');
      if (clean.length > 10) clean = clean.slice(0, 10);
      phoneInput.value = clean;
    });

    phoneInput.addEventListener('paste', (e) => {
      e.preventDefault();
      const text = (e.clipboardData || (window as any).clipboardData)?.getData('text') || '';
      let clean = text.replace(/\D/g, '');
      if (clean.startsWith('91') && clean.length === 12) {
        clean = clean.slice(2);
      }
      phoneInput.value = clean.slice(0, 10);
    });

    phoneInput.addEventListener('keydown', (e) => {
      if (
        ['Backspace', 'Delete', 'Tab', 'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Enter', 'Home', 'End'].includes(e.key) ||
        e.ctrlKey || e.metaKey
      ) {
        return;
      }
      if (!/^[0-9]$/.test(e.key)) {
        e.preventDefault();
        return;
      }
      const hasSelection = phoneInput.selectionStart !== null && phoneInput.selectionEnd !== null && phoneInput.selectionStart !== phoneInput.selectionEnd;
      if (phoneInput.value.length >= 10 && !hasSelection) {
        e.preventDefault();
      }
    });
  }

  if (form && statusDiv && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const fName = (document.getElementById('firstName') as HTMLInputElement)?.value.trim();
      const lName = (document.getElementById('lastName') as HTMLInputElement)?.value.trim();
      const emailInput = document.getElementById('email') as HTMLInputElement | null;
      const email = emailInput?.value.trim() || '';
      if (emailInput) emailInput.value = email;
      const rawPhone = (document.getElementById('phone') as HTMLInputElement)?.value || '';
      const interest = (document.getElementById('interest') as HTMLSelectElement)?.value;
      const message = (document.getElementById('message') as HTMLTextAreaElement)?.value.trim();
      const consent = (document.getElementById('privacyConsent') as HTMLInputElement)?.checked;

      // Sanitization & Extraction
      let cleanPhone = rawPhone.replace(/\D/g, '');
      if (cleanPhone.startsWith('91') && cleanPhone.length === 12) {
        cleanPhone = cleanPhone.slice(2);
      }

      // Validation
      if (!fName || !lName || !email || !cleanPhone || !interest || !message) {
        statusDiv.className = 'mb-6 p-4 rounded-xl text-sm bg-red-50 text-red-700 border border-red-200 block';
        statusDiv.textContent = 'Please fill out all required fields marked with an asterisk (*).';
        return;
      }

      if (!isValidEmail(email)) {
        statusDiv.className = 'mb-6 p-4 rounded-xl text-sm bg-red-50 text-red-700 border border-red-200 block';
        statusDiv.textContent = 'Please enter a valid email address.';
        return;
      }

      if (cleanPhone.length !== 10) {
        statusDiv.className = 'mb-6 p-4 rounded-xl text-sm bg-red-50 text-red-700 border border-red-200 block';
        statusDiv.textContent = 'Mobile number must contain exactly 10 digits.';
        return;
      }

      if (!/^[6-9][0-9]{9}$/.test(cleanPhone)) {
        statusDiv.className = 'mb-6 p-4 rounded-xl text-sm bg-red-50 text-red-700 border border-red-200 block';
        statusDiv.textContent = 'Please enter a valid 10-digit Indian mobile number.';
        return;
      }

      submitBtn.disabled = true;
      const originalText = submitBtn.textContent || 'Send Message';
      submitBtn.textContent = 'Sending Message...';

      try {
        const payload = {
          firstName: fName,
          lastName: lName,
          email,
          phone: cleanPhone,
          leadType: 'Contact',
          courseInterest: interest,
          message,
          source: 'Contact Us Form',
          privacyConsent: consent
        };

        const response = await fetch('/api/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok || data.error) {
          statusDiv.className = 'mb-6 p-4 rounded-xl text-sm bg-red-50 text-red-700 border border-red-200 block';
          statusDiv.textContent = data.error || 'Failed to submit inquiry. Please try again.';
          return;
        }

        statusDiv.className = 'mb-6 p-4 rounded-xl text-sm bg-green-50 text-green-800 border border-green-200 block';
        statusDiv.innerHTML = `<strong>Inquiry Received!</strong> Thank you, ${fName}. We have saved your request regarding <em>${interest}</em>. An advisor will contact you within 24 hours.`;
        form.reset();
      } catch (err) {
        statusDiv.className = 'mb-6 p-4 rounded-xl text-sm bg-red-50 text-red-700 border border-red-200 block';
        statusDiv.textContent = 'Unable to send message right now. Please call us directly at +91 99706 00116.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  }
</script>
