---
// ============================================================
// /thank-you
// Dedicated Service Thank-You Page with Service-Specific Guidance
// ============================================================

import BaseLayout from '../layouts/BaseLayout.astro';

const url = Astro.url;
const service = url.searchParams.get('service') || 'Career Counseling';

// Service-specific messaging and next steps
const serviceDetails: Record<string, {
  headline: string;
  subheadline: string;
  nextSteps: string[];
  docHelp?: string;
  whatsappMsg: string;
}> = {
  'Career Counseling': {
    headline: 'Your Career Counseling Session Request Is Confirmed',
    subheadline: 'Our senior academic and career counseling team in Baner, Pune has received your inquiry.',
    nextSteps: [
      'Our certified counselor will review your current stage and goals.',
      'We will call or WhatsApp you within 24 working hours to schedule a suitable time slot.',
      'Prepare any existing mark sheets, aptitude tests, or questions for discussion.'
    ],
    whatsappMsg: 'Hi Knowletive, I submitted a Career Counseling inquiry and would like to confirm my session timing.'
  },
  'CET 2027 Admission Counseling': {
    headline: 'Your CET 2027 Admission Guidance Request Is Received',
    subheadline: 'Our Maharashtra CET admission counseling specialists will reach out to guide you through preparation and CAP procedures.',
    nextSteps: [
      'An admission counselor will review your target CET exam (MHT-CET / MBA / MCA) and stream.',
      'We will share the official verification checklist and cutoff benchmark data.',
      'Please note: Guidance helps you plan strategy; seat allotments are determined solely by State CET Cell merit rules.'
    ],
    whatsappMsg: 'Hi Knowletive, I submitted an inquiry for CET 2027 Admission Guidance and would like to connect with a counselor.'
  },
  'IT Training and Internship': {
    headline: 'Your IT Training & Internship Inquiry Is Registered',
    subheadline: 'Thank you for your interest in Knowletive’s hands-on technology skill development and internship programs.',
    nextSteps: [
      'Our technical program mentor will review your program of interest and educational background.',
      'You will receive the complete syllabus, project deliverables, and upcoming batch schedule.',
      'We will arrange a quick orientation call to answer your curriculum and project questions.'
    ],
    whatsappMsg: 'Hi Knowletive, I inquired about IT Training & Internship and would like the detailed syllabus and batch dates.'
  },
  'Ebook Selling': {
    headline: 'Thank You for Your Ebook Request',
    subheadline: 'Your career and technical resource access has been recorded.',
    nextSteps: [
      'Your download instructions or direct delivery link will be sent to your provided email address.',
      'If you have questions regarding any chapter or career roadmap, our team is always available to assist.',
      'Check your inbox (and spam/promotions folder) within 5 minutes.'
    ],
    whatsappMsg: 'Hi Knowletive, I requested an Ebook from your website and would like to confirm access.'
  },
  'Data Solutions': {
    headline: 'Your Data Solutions Requirement Has Been Logged',
    subheadline: 'Our enterprise data services team will review your requested data category and intended business application.',
    nextSteps: [
      'A data specialist will verify catalog availability, coverage fields, and compliance parameters.',
      'We will provide a synthetic/redacted sample preview and customized quote according to your requirements.',
      'All datasets are shared in compliance with applicable Indian data protection standards for legitimate B2B use.'
    ],
    whatsappMsg: 'Hi Knowletive, I submitted a Data Solutions inquiry and would like to review the dataset sample and quotation.'
  },
  'Distance Education Admission': {
    headline: 'Your Distance Education Guidance Request Is Received',
    subheadline: 'Our higher education advisors will help you evaluate UGC-DEB recognized distance degree programs.',
    nextSteps: [
      'An education advisor will assess your current qualification and desired degree program (MBA, MCA, BBA, etc.).',
      'We will guide you through university comparisons, fee structures, exam formats, and eligibility criteria.',
      'You will receive document verification assistance before final university submission.'
    ],
    whatsappMsg: 'Hi Knowletive, I submitted an inquiry for Distance Education Admission Guidance and would like to know about available universities.'
  },
  'Coachgenie': {
    headline: 'Your Coachgenie Mentorship Inquiry Is Received',
    subheadline: 'Thank you for your interest in Coachgenie by Knowletive — personalized 1-on-1 mentorship and mock interview preparation.',
    nextSteps: [
      'Our coaching director will assess your target role, experience level, and timeline.',
      'We will connect with you to discuss cohort availability, mentor matching, and roadmap setup.',
      'You will be invited for an introductory 1-on-1 discovery session.'
    ],
    whatsappMsg: 'Hi Knowletive, I inquired about Coachgenie mentorship and would like to check available mentor slots.'
  }
};

const currentInfo = serviceDetails[service] || {
  headline: `Thank You! Your Inquiry for ${service} Has Been Received`,
  subheadline: 'Our specialized team at Knowletive has received your submission and will get in touch shortly.',
  nextSteps: [
    'A designated specialist will review your details.',
    'We will contact you via phone or WhatsApp within 24 working hours.',
    'Feel free to connect directly via WhatsApp if you need immediate assistance.'
  ],
  whatsappMsg: `Hi Knowletive, I submitted an inquiry for ${service} and would like to follow up.`
};
---

<BaseLayout 
  title={`Thank You | ${service} — Knowletive`}
  description={`Your inquiry for ${service} has been successfully received by Knowletive.`}
>
  <section class="page-header-spacing pb-20 bg-gray-50 min-h-[85vh] flex items-center">
    <div class="container-custom max-w-3xl mx-auto">
      
      <div class="card-premium border border-gray-200 bg-white p-8 md:p-12 shadow-xl text-center relative overflow-hidden">
        
        <!-- Top success badge -->
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-emerald-50 border-4 border-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-6 shadow-sm">
          <svg class="w-8 h-8 sm:w-10 sm:h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 text-emerald-700 font-bold text-xs uppercase tracking-wider mb-4 border border-emerald-200">
          Inquiry Successfully Recorded
        </div>

        <h1 class="text-2xl sm:text-3xl md:text-4xl font-manrope font-extrabold text-[#0B1F3A] mb-4 leading-tight">
          {currentInfo.headline}
        </h1>

        <p class="text-[#64748B] text-sm sm:text-base max-w-xl mx-auto mb-8 leading-relaxed">
          {currentInfo.subheadline}
        </p>

        <!-- Next Steps Box -->
        <div class="bg-[#F7F9FC] border border-gray-200 rounded-2xl p-6 sm:p-8 text-left mb-8">
          <h2 class="text-sm sm:text-base font-bold font-manrope text-[#0B1F3A] mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-[#0878E8]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
            What Happens Next?
          </h2>

          <ol class="space-y-3.5 text-xs sm:text-sm text-[#0B1F3A]">
            {currentInfo.nextSteps.map((step, idx) => (
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-[#0878E8] text-white text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">
                  {idx + 1}
                </span>
                <span class="leading-relaxed text-[#64748B]">{step}</span>
              </li>
            ))}
          </ol>
        </div>

        <!-- Quick Secondary Action Options -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
          <a 
            href={`https://wa.me/919970600116?text=${encodeURIComponent(currentInfo.whatsappMsg)}`}
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-[#25D366] text-white font-bold text-xs sm:text-sm shadow-md hover:brightness-105 transition-all"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Chat with Counselor on WhatsApp
          </a>

          <a 
            href="tel:+919970600116" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full border border-gray-300 text-[#0B1F3A] hover:border-[#0878E8] hover:text-[#0878E8] font-bold text-xs sm:text-sm transition-colors"
          >
            <svg class="w-4 h-4 text-[#F47A16]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            Call +91 99706 00116
          </a>
        </div>

        <div class="mt-8 pt-6 border-t border-gray-100 flex items-center justify-between text-xs text-gray-400">
          <a href="/" class="hover:text-[#0878E8] transition-colors flex items-center gap-1 font-semibold">
            ← Back to Knowletive Home
          </a>
          <span class="text-[11px]">Knowletive • Baner, Pune</span>
        </div>

      </div>

    </div>
  </section>
</BaseLayout>

