---
import BaseLayout from '../layouts/BaseLayout.astro';
import Placements from '../components/Placements.astro';
import ConsultationCTA from '../components/ConsultationCTA.astro';
import { db } from '../lib/db';

const pageTitle = "Placement & Activities | Knowletive";
const pageDescription = "Career outcomes beyond the classroom. Explore our placement records, hiring partners, student activities, workshops, and career development initiatives at Knowletive.";

let activities: any[] = [];
try {
  activities = await db.getMedia('activities', true);
} catch (e) {
  console.error('[Activities Page] Failed to query media:', e);
}
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="relative bg-[#0B1F3A] pt-32 pb-20 overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
      <div class="absolute inset-0" style="background-image: radial-gradient(#F47A16 1px, transparent 1px); background-size: 30px 30px;"></div>
    </div>
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-[#0878E8]/20 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="container-custom relative z-10 text-center max-w-4xl mx-auto">
      <nav aria-label="Breadcrumb" class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-blue-200 mb-6 bg-white/10 px-4 py-1.5 rounded-full backdrop-blur-sm">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">Placement & Activities</span>
      </nav>

      <h1 class="fluid-hero font-manrope font-extrabold text-white mb-6">
        Career Outcomes <br/>
        <span class="text-gradient-orange">Beyond the Classroom</span>
      </h1>

      <p class="text-blue-100/90 text-lg md:text-xl max-w-3xl mx-auto leading-relaxed mb-10">
        Discover how Knowletive prepares students for the corporate world through dedicated placement support, industry interactions, and engaging student activities.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="#activities-section" class="px-8 py-3.5 bg-gradient-to-r from-[#F47A16] to-[#E06605] text-white font-bold rounded-xl shadow-lg hover:shadow-orange-500/25 transition-all">
          Explore Activities Gallery
        </a>
        <a href="#placements" class="px-8 py-3.5 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-xl backdrop-blur-md transition-all border border-white/20">
          Placement Records
        </a>
      </div>
    </div>
  </section>

  <!-- Placement Section -->
  <Placements />

  <!-- Activities & Workshops Gallery Section (Coverflow Carousel) -->
  <section id="activities-section" class="py-16 md:py-24 bg-white relative overflow-hidden">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#0878E8]/10 text-[#0878E8] font-bold text-xs tracking-widest uppercase mb-4 border border-[#0878E8]/20">
          Student Life & Workshops
        </div>
        <h2 class="fluid-h2 text-[#0B1F3A] mb-3">Workshops & <span class="text-[#0878E8]">Activities Gallery</span></h2>
        <p class="text-[#64748B] text-sm md:text-base">
          Holistic development in action. Glimpses of technical hackathons, guest seminars, corporate masterclasses, and student achievements.
        </p>
      </div>
    </div>

    <!-- Carousel Container -->
    {activities && activities.length > 0 ? (
      <div class="relative w-full max-w-[1400px] mx-auto px-2 sm:px-4">
        <!-- Subtle Side Edge Vignette Overlays for Depth -->
        <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-10 sm:w-20 md:w-32 bg-gradient-to-r from-white via-white/80 to-transparent z-20"></div>
        <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-10 sm:w-20 md:w-32 bg-gradient-to-l from-white via-white/80 to-transparent z-20"></div>

        <!-- Carousel Viewport -->
        <div 
          id="activities-carousel-viewport" 
          class="relative w-full overflow-hidden py-6 select-none touch-pan-y"
          tabindex="0"
          aria-label="Activities Gallery Carousel"
        >
          <div 
            id="activities-carousel-track" 
            class="flex items-center transition-transform duration-500 ease-out will-change-transform cursor-grab active:cursor-grabbing"
          >
            {activities.map((item, index) => (
              <div 
                class="activity-carousel-slide shrink-0 transition-all duration-500 ease-out flex flex-col items-center justify-start px-2 sm:px-3.5"
                data-index={index}
                data-title={item.title}
                data-desc={item.description || ''}
                data-type={item.type || item.media_type || 'image'}
                data-src={item.file_url}
              >
                <!-- Card Inner Frame (Image / Video) -->
                <div class="activity-card-inner w-full aspect-[4/3] rounded-2xl md:rounded-3xl overflow-hidden bg-slate-100 border border-slate-200/90 shadow-md transition-all duration-500 relative flex items-center justify-center cursor-pointer">
                  {item.type === 'video' || item.media_type === 'video' ? (
                    <div class="w-full h-full relative group/video bg-slate-950 flex items-center justify-center">
                      <video 
                        src={item.file_url} 
                        class="w-full h-full object-cover object-top" 
                        playsinline 
                        preload="metadata"
                      ></video>
                      <div class="absolute inset-0 bg-black/30 flex items-center justify-center group-hover/video:bg-black/20 transition-all">
                        <div class="w-12 h-12 md:w-14 md:h-14 rounded-full bg-[#F47A16] text-white flex items-center justify-center shadow-lg transform group-hover/video:scale-110 transition-transform">
                          <svg class="w-5 h-5 md:w-6 md:h-6 ml-0.5" fill="currentColor" viewBox="0 0 20 20"><path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/></svg>
                        </div>
                      </div>
                    </div>
                  ) : (
                    <div class="w-full h-full relative overflow-hidden bg-slate-100 flex items-center justify-center">
                      <img 
                        src={item.file_url} 
                        alt={item.title} 
                        class="w-full h-full object-cover object-top transition-transform duration-500" 
                        loading="lazy" 
                      />
                    </div>
                  )}

                  <!-- Zoom hint icon on active card -->
                  <div class="zoom-badge absolute top-3 right-3 opacity-0 transition-opacity duration-300 p-1.5 rounded-full bg-black/50 text-white backdrop-blur-xs pointer-events-none">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
                  </div>
                </div>

                <!-- Text Caption below card (Title & Subtitle/Branch) -->
                <div class="activity-card-caption w-full text-center mt-3.5 px-2 transition-all duration-500">
                  <h3 class="font-extrabold text-[#0B1F3A] text-sm md:text-base leading-snug line-clamp-1">{item.title}</h3>
                  <p class="text-xs text-[#64748B] mt-0.5 font-medium line-clamp-1">{item.description || 'Student Activity & Workshop'}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Navigation Buttons: Circular Arrows centered below carousel -->
        <div class="flex items-center justify-center gap-4 mt-6 md:mt-8">
          <button 
            type="button" 
            id="activities-prev-btn" 
            class="w-11 h-11 md:w-12 md:h-12 rounded-full bg-slate-600/80 hover:bg-[#0B1F3A] text-white flex items-center justify-center transition-all shadow-md active:scale-90 cursor-pointer"
            aria-label="Previous gallery item"
          >
            <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M15 19l-7-7 7-7" /></svg>
          </button>
          <button 
            type="button" 
            id="activities-next-btn" 
            class="w-11 h-11 md:w-12 md:h-12 rounded-full bg-slate-600/80 hover:bg-[#0B1F3A] text-white flex items-center justify-center transition-all shadow-md active:scale-90 cursor-pointer"
            aria-label="Next gallery item"
          >
            <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      </div>
    ) : (
      <div class="container-custom">
        <div class="bg-gray-50 rounded-3xl p-16 text-center border border-gray-200 border-dashed max-w-2xl mx-auto shadow-sm">
          <div class="w-16 h-16 bg-blue-50 text-[#0878E8] rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-[#0B1F3A] mb-2">Activities Gallery</h3>
          <p class="text-[#64748B] text-sm max-w-md mx-auto">
            Photos and updates from our recent events, workshops, and industry visits will be updated here soon.
          </p>
        </div>
      </div>
    )}
  </section>

  <!-- Lightbox Modal for Photo / Video Zoom -->
  <div id="lightbox-modal" class="fixed inset-0 bg-black/90 z-50 hidden flex items-center justify-center p-4 backdrop-blur-md">
    <button id="close-lightbox" class="absolute top-6 right-6 text-white hover:text-[#F47A16] p-2 transition-colors cursor-pointer" aria-label="Close zoom modal">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
    <div class="max-w-4xl max-h-[85vh] flex flex-col items-center">
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[70vh] object-contain rounded-xl shadow-2xl mb-4 hidden" />
      <video id="lightbox-video" src="" controls playsinline class="max-w-full max-h-[70vh] rounded-xl shadow-2xl mb-4 hidden"></video>
      <h4 id="lightbox-title" class="text-white text-lg font-bold text-center"></h4>
      <p id="lightbox-desc" class="text-gray-300 text-xs text-center max-w-lg mt-1"></p>
    </div>
  </div>

  <ConsultationCTA />
</BaseLayout>

<style>
  /* Responsive Slide Widths */
  .activity-carousel-slide {
    width: 410px;
  }
  @media (max-width: 1024px) {
    .activity-carousel-slide {
      width: 350px;
    }
  }
  @media (max-width: 640px) {
    .activity-carousel-slide {
      width: calc(100vw - 72px);
      max-width: 330px;
    }
  }
</style>

<script>
  (() => {
    const viewport = document.getElementById('activities-carousel-viewport');
    const track = document.getElementById('activities-carousel-track') as HTMLElement | null;
    const slides = Array.from(document.querySelectorAll('.activity-carousel-slide')) as HTMLElement[];
    const prevBtn = document.getElementById('activities-prev-btn');
    const nextBtn = document.getElementById('activities-next-btn');

    // Lightbox elements
    const lightbox = document.getElementById('lightbox-modal');
    const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lbVideo = document.getElementById('lightbox-video') as HTMLVideoElement | null;
    const lbTitle = document.getElementById('lightbox-title');
    const lbDesc = document.getElementById('lightbox-desc');
    const closeLb = document.getElementById('close-lightbox');

    if (!viewport || !track || slides.length === 0) return;

    const totalSlides = slides.length;
    // Default to the middle or 0
    let currentIndex = Math.min(Math.floor(totalSlides / 2), Math.max(0, totalSlides - 1));
    let isDragging = false;
    let startX = 0;
    let currentDeltaX = 0;
    let autoplayTimer: any = null;

    function openMediaModal(slide: HTMLElement) {
      const type = slide.dataset.type || 'image';
      const src = slide.dataset.src || '';
      const title = slide.dataset.title || '';
      const desc = slide.dataset.desc || '';

      if (lightbox && lbTitle) {
        lbTitle.textContent = title;
        if (lbDesc) lbDesc.textContent = desc;

        if (type === 'video') {
          if (lbImg) lbImg.classList.add('hidden');
          if (lbVideo) {
            lbVideo.src = src;
            lbVideo.classList.remove('hidden');
            lbVideo.play().catch(() => {});
          }
        } else {
          if (lbVideo) {
            lbVideo.pause();
            lbVideo.src = '';
            lbVideo.classList.add('hidden');
          }
          if (lbImg) {
            lbImg.src = src;
            lbImg.alt = title;
            lbImg.classList.remove('hidden');
          }
        }

        lightbox.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeLightbox() {
      if (lightbox) {
        lightbox.classList.add('hidden');
        if (lbVideo) {
          lbVideo.pause();
          lbVideo.src = '';
        }
        document.body.style.overflow = '';
      }
    }

    closeLb?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });

    function updateCarousel(animate = true) {
      if (!viewport || !track || slides.length === 0) return;

      if (!animate) {
        track.style.transition = 'none';
      } else {
        track.style.transition = 'transform 500ms cubic-bezier(0.16, 1, 0.3, 1)';
      }

      const viewportWidth = viewport.offsetWidth;
      const targetSlide = slides[currentIndex];
      const slideWidth = targetSlide.offsetWidth;

      // Calculate track translation to center targetSlide in viewport
      let offsetLeft = 0;
      for (let i = 0; i < currentIndex; i++) {
        offsetLeft += slides[i].offsetWidth;
      }
      const targetCenter = offsetLeft + (slideWidth / 2);
      const targetTranslateX = (viewportWidth / 2) - targetCenter;

      track.style.transform = `translateX(${targetTranslateX}px)`;

      // Apply coverflow scale, opacity and z-index to all slides
      slides.forEach((slide, i) => {
        const diff = i - currentIndex;
        const absDiff = Math.abs(diff);
        const cardInner = slide.querySelector('.activity-card-inner') as HTMLElement | null;
        const caption = slide.querySelector('.activity-card-caption') as HTMLElement | null;
        const zoomBadge = slide.querySelector('.zoom-badge') as HTMLElement | null;

        if (!cardInner) return;

        if (absDiff === 0) {
          // Active Center Card
          cardInner.style.transform = 'scale(1)';
          cardInner.style.opacity = '1';
          cardInner.style.boxShadow = '0 20px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1)';
          cardInner.style.zIndex = '10';
          slide.style.zIndex = '10';
          if (caption) {
            caption.style.opacity = '1';
            caption.style.transform = 'translateY(0)';
          }
          if (zoomBadge) zoomBadge.style.opacity = '1';
        } else if (absDiff === 1) {
          // Immediate Adjacent Side Cards
          cardInner.style.transform = 'scale(0.92)';
          cardInner.style.opacity = '0.68';
          cardInner.style.boxShadow = '0 4px 6px -1px rgba(0, 0, 0, 0.05)';
          cardInner.style.zIndex = '5';
          slide.style.zIndex = '5';
          if (caption) {
            caption.style.opacity = '0.65';
            caption.style.transform = 'translateY(2px)';
          }
          if (zoomBadge) zoomBadge.style.opacity = '0';
        } else {
          // Farther Side Cards
          cardInner.style.transform = 'scale(0.85)';
          cardInner.style.opacity = '0.32';
          cardInner.style.boxShadow = 'none';
          cardInner.style.zIndex = '1';
          slide.style.zIndex = '1';
          if (caption) {
            caption.style.opacity = '0.3';
            caption.style.transform = 'translateY(4px)';
          }
          if (zoomBadge) zoomBadge.style.opacity = '0';
        }
      });
    }

    function goToSlide(index: number) {
      if (totalSlides <= 1) return;
      currentIndex = (index + totalSlides) % totalSlides;
      updateCarousel(true);
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    // Attach click listeners to slides
    slides.forEach((slide, i) => {
      slide.addEventListener('click', () => {
        if (Math.abs(currentDeltaX) > 10) return; // Ignore drag clicks
        if (i === currentIndex) {
          // Clicking active card opens zoom modal
          openMediaModal(slide);
        } else {
          // Clicking side card centers it
          goToSlide(i);
        }
      });
    });

    // Arrow buttons
    prevBtn?.addEventListener('click', () => {
      prevSlide();
      resetAutoplay();
    });

    nextBtn?.addEventListener('click', () => {
      nextSlide();
      resetAutoplay();
    });

    // Keyboard navigation
    viewport.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        prevSlide();
        resetAutoplay();
      } else if (e.key === 'ArrowRight') {
        nextSlide();
        resetAutoplay();
      }
    });

    // Drag / Touch Swipe Handling
    function onDragStart(clientX: number) {
      isDragging = true;
      startX = clientX;
      currentDeltaX = 0;
      pauseAutoplay();
    }

    function onDragMove(clientX: number) {
      if (!isDragging) return;
      currentDeltaX = clientX - startX;
    }

    function onDragEnd() {
      if (!isDragging) return;
      isDragging = false;
      if (currentDeltaX > 40) {
        prevSlide();
      } else if (currentDeltaX < -40) {
        nextSlide();
      }
      setTimeout(() => {
        currentDeltaX = 0;
      }, 50);
      resetAutoplay();
    }

    // Mouse Events
    viewport.addEventListener('mousedown', (e) => onDragStart(e.clientX));
    window.addEventListener('mousemove', (e) => {
      if (isDragging) onDragMove(e.clientX);
    });
    window.addEventListener('mouseup', () => {
      if (isDragging) onDragEnd();
    });

    // Touch Events
    viewport.addEventListener('touchstart', (e) => {
      if (e.touches.length > 0) onDragStart(e.touches[0].clientX);
    }, { passive: true });

    viewport.addEventListener('touchmove', (e) => {
      if (isDragging && e.touches.length > 0) onDragMove(e.touches[0].clientX);
    }, { passive: true });

    viewport.addEventListener('touchend', () => {
      if (isDragging) onDragEnd();
    });

    // Autoplay (every 4.5 seconds)
    function startAutoplay() {
      if (totalSlides <= 1) return;
      pauseAutoplay();
      autoplayTimer = setInterval(() => {
        if (!document.hidden && !isDragging) {
          nextSlide();
        }
      }, 4500);
    }

    function pauseAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    function resetAutoplay() {
      pauseAutoplay();
      startAutoplay();
    }

    viewport.addEventListener('mouseenter', pauseAutoplay);
    viewport.addEventListener('mouseleave', startAutoplay);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pauseAutoplay();
      else startAutoplay();
    });

    // Initial positioning & resize listener
    window.addEventListener('resize', () => updateCarousel(false));
    
    // Initial run
    setTimeout(() => {
      updateCarousel(false);
      startAutoplay();
    }, 100);

  })();
</script>
