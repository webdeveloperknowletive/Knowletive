---
// ============================================================
// /data-solutions
// Conversion-Focused Landing Page: Data Selling & B2B Solutions
// Primary CTA: "Request Data Details"
// ============================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHeader from '../components/landing/LandingHeader.astro';
import LandingLeadForm, { type FormField } from '../components/landing/LandingLeadForm.astro';
import LandingFAQ from '../components/landing/LandingFAQ.astro';
import StickyMobileCTA from '../components/landing/StickyMobileCTA.astro';
import UTMTracker from '../components/landing/UTMTracker.astro';

const serviceTitle = "Data Solutions & B2B Datasets";
const primaryCta = "Request Data Details";

const customFields: FormField[] = [
  {
    name: "dataCategory",
    label: "Data Category of Interest",
    type: "select",
    required: true,
    placeholder: "Select data category",
    options: [
      { value: "B2B Technology & IT Companies Directory", label: "B2B Tech & IT Companies (Pune, Mumbai, Bangalore)" },
      { value: "Higher Education & Engineering Institutions", label: "Colleges & Higher Education Institutions Directory" },
      { value: "Tech Industry Hiring & Skills Benchmark Data", label: "Tech Hiring & Skill Demand Intelligence" },
      { value: "Maharashtra Regional Business Directory", label: "Maharashtra Verified Business Contacts (Public Records)" },
      { value: "Custom Enterprise Dataset Requirement", label: "Custom Industry Dataset (Specify in message)" }
    ]
  },
  {
    name: "companyName",
    label: "Company / Organization Name",
    type: "text",
    required: false,
    placeholder: "e.g. Acme Analytics Pvt Ltd"
  },
  {
    name: "message",
    label: "Intended Business Use & Volume Requirements",
    type: "textarea",
    required: true,
    placeholder: "Describe how your team intends to utilize the dataset (e.g. B2B software marketing, recruitment outreach, academic market analysis)..."
  }
];

const categories = [
  {
    title: "B2B IT & Software Companies",
    coverage: "12,000+ Verified Records",
    fields: "Company Name, Tech Stack, City, Official Domain, Corporate Email, HR/Talent Contact, LinkedIn Page",
    formats: "CSV, XLSX, JSON",
    refresh: "Quarterly Verification",
    useCase: "B2B SaaS marketing, IT vendor partnerships, recruitment intelligence."
  },
  {
    title: "Engineering & Degree Colleges",
    coverage: "3,500+ Accredited Institutions",
    fields: "College Name, Affiliated University, DTE/AISHE Code, Streams Offered, Principal/TPO Desk Email, Official Phone",
    formats: "CSV, XLSX",
    refresh: "Bi-Annual Verification",
    useCase: "Student outreach, campus recruitment drives, academic partnerships."
  },
  {
    title: "Tech Skills & Hiring Trends Benchmark",
    coverage: "Quarterly Aggregated Analytics",
    fields: "Role Title, In-Demand Frameworks, Salary Ranges, Regional Vacancy Trends, Experience Banding",
    formats: "XLSX, PDF Executive Report",
    refresh: "Quarterly Updates",
    useCase: "Workforce planning, curriculum development, strategic HR benchmarking."
  },
  {
    title: "Regional Maharashtra Business Registry",
    coverage: "25,000+ Public Commercial Records",
    fields: "Registered Firm Name, GSTIN Status, Industry Sector, Registered City, Commercial Contact, Director Name",
    formats: "CSV, XLSX",
    refresh: "Quarterly Verification",
    useCase: "Regional B2B sales expansion, industrial supply chain discovery."
  }
];

// Synthetic Redacted Sample (strictly synthetic preview records for demo, no real PII)
const sampleData = [
  { name: "Apex Technologies [Synthesized]", sector: "Enterprise Cloud Software", location: "Pune, MH", contact: "contact@***-tech.com", website: "https://apex-***.example" },
  { name: "Deccan Engineering Institute [Synthesized]", sector: "Higher Education / TPO", location: "Pune, MH", contact: "tpo@***-engg.edu.in", website: "https://deccan-***.example" },
  { name: "Sahyadri Logistics Corp [Synthesized]", sector: "Supply Chain & Warehousing", location: "Mumbai, MH", contact: "info@***-logistics.in", website: "https://sahyadri-***.example" },
  { name: "Vanguard Data Systems [Synthesized]", sector: "Fintech & Analytics", location: "Bangalore, KA", contact: "bizdev@***-data.com", website: "https://vanguard-***.example" }
];

const faqs = [
  {
    question: "Where is Knowletive's business data sourced from?",
    answer: "Our data solutions are compiled strictly from public company registries, authorized institutional directories, government gazettes, and opt-in corporate business filings. We do not provide unauthorized personal data or scraped confidential customer information."
  },
  {
    question: "How does Knowletive ensure data protection and DPDP Act compliance?",
    answer: "All datasets conform to India's Digital Personal Data Protection (DPDP) Act 2023 guidelines. Data is restricted to verified commercial and institutional business information intended strictly for lawful B2B commercial communication and market research."
  },
  {
    question: "Can I receive a sample before placing a full data request?",
    answer: "Yes. Upon submitting your business email and specific requirement in the form, our data team will send a sanitized 20-row sample preview corresponding to your selected category."
  },
  {
    question: "In what file formats are datasets delivered?",
    answer: "Datasets are delivered securely via password-protected links in CSV, Microsoft Excel (.xlsx), or structured JSON format depending on your database requirements."
  },
  {
    question: "What is the update frequency and bounce-rate threshold?",
    answer: "Records are verified on a quarterly cycle. We aim for an active deliverability rate exceeding 90% across email and corporate domain endpoints."
  }
];
---

<BaseLayout 
  title="B2B Data Selling & Business Solutions | Verified Datasets — Knowletive"
  description="Verified B2B data selling and industry datasets in India. IT companies directories, college contact lists, and market hiring intelligence by Knowletive Pune."
>
  <UTMTracker />
  <LandingHeader primaryCtaText={primaryCta} serviceTitle={serviceTitle} />

  <!-- HERO SECTION -->
  <section id="overview" class="page-header-spacing pb-16 bg-[#0B1F3A] text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-15 pointer-events-none" style="background-image: radial-gradient(#0878E8 1px, transparent 1px); background-size: 28px 28px;"></div>

    <div class="container-custom relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Left: Headline & Pitch -->
        <div class="lg:col-span-7 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/20 text-[#F47A16] font-bold text-xs uppercase tracking-wider mb-5">
            <span class="w-2 h-2 rounded-full bg-[#F47A16] animate-pulse"></span>
            Authorized B2B Data Selling & Market Intelligence
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-manrope font-extrabold tracking-tight text-white mb-5 leading-tight">
            Verified B2B Data Solutions. <br/>
            <span class="text-[#F47A16]">Fuel Your Sales & Recruitment</span> Outreach.
          </h1>

          <p class="text-blue-100 text-sm sm:text-base md:text-lg max-w-xl mx-auto lg:mx-0 mb-6 leading-relaxed">
            High-accuracy directories of IT software firms, higher education institutions, and regional commercial enterprises. Clean, compliant data formatted in CSV, Excel, and JSON.
          </p>

          <!-- Compliance & Ethical Disclaimer Box -->
          <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 max-w-xl text-left text-xs text-blue-200/90 leading-relaxed mb-8">
            <strong class="text-white block mb-0.5">🛡️ Ethical Data & DPDP Act 2023 Compliance:</strong>
            Knowletive supplies strictly verified business, institutional, and publicly registered corporate records. We do not sell scraped, sensitive personal information, banking details, or unauthorized consumer data.
          </div>

          <!-- Secondary Actions -->
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3">
            <a href="#lead-form" class="btn-primary w-full sm:w-auto px-8 py-3.5 text-sm shadow-xl">
              {primaryCta}
            </a>
            <a 
              href="https://wa.me/919970600116?text=Hi%20Knowletive%2C%20I%20would%20like%20to%20request%20information%20about%20your%20B2B%20datasets." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white/10 hover:bg-white/15 text-white font-semibold text-xs border border-white/20 transition-all"
            >
              <svg class="w-4 h-4 text-[#25D366] fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Chat on WhatsApp
            </a>
          </div>
        </div>

        <!-- Right: Form -->
        <div class="lg:col-span-5">
          <LandingLeadForm 
            serviceId="data-solutions"
            serviceName={serviceTitle}
            primaryCta={primaryCta}
            headline="Request Dataset Details & Quote"
            subheadline="Select the dataset category to request sample rows and customized pricing."
            customFields={customFields}
            compact={true}
          />
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION 2: AVAILABLE DATASETS -->
  <section id="datasets" class="section-padding bg-gray-50" data-analytics-section="datasets">
    <div class="container-custom">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0878E8]/10 text-[#0878E8] font-bold text-xs uppercase tracking-wider mb-3">
          Catalog & Coverage
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-manrope font-extrabold text-[#0B1F3A] mb-3">
          Authorized Commercial Datasets
        </h2>
        <p class="text-[#64748B] text-sm md:text-base">
          Accurate, structured records formatted for modern CRM and email marketing engines.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {categories.map((cat) => (
          <div class="card-premium border border-gray-200 bg-white p-6 sm:p-8 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-[#0878E8]">
                  {cat.coverage}
                </span>
                <span class="text-xs font-mono text-gray-400">{cat.formats}</span>
              </div>
              <h3 class="text-xl font-bold font-manrope text-[#0B1F3A] mb-2">{cat.title}</h3>
              <p class="text-xs text-[#64748B] leading-relaxed mb-4"><strong>Primary Use:</strong> {cat.useCase}</p>
              
              <div class="p-4 rounded-xl bg-gray-50 text-[11px] text-gray-600 mb-6 space-y-1">
                <p><strong>Available Fields:</strong> {cat.fields}</p>
                <p><strong>Audit Frequency:</strong> {cat.refresh}</p>
              </div>
            </div>

            <a href="#lead-form" class="btn-primary w-full py-2.5 text-xs font-bold text-center justify-center">
              Request Sample & Quotation →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 3: SYNTHETIC SAMPLE PREVIEW TABLE -->
  <section class="section-padding bg-white" data-analytics-section="sample-preview">
    <div class="container-custom max-w-5xl mx-auto">
      <div class="text-center mb-8">
        <h3 class="text-xl sm:text-2xl font-bold font-manrope text-[#0B1F3A] mb-2">
          Synthetic Sample Preview Structure
        </h3>
        <p class="text-xs sm:text-sm text-[#64748B]">
          Demonstration of field schema and clean column structure (synthetic redacted records shown below for privacy protection).
        </p>
      </div>

      <div class="overflow-x-auto border border-gray-200 rounded-2xl shadow-sm">
        <table class="w-full text-left text-xs whitespace-nowrap">
          <thead class="bg-gray-50 text-gray-500 uppercase font-bold text-[10px] tracking-wider border-b border-gray-200">
            <tr>
              <th class="py-3 px-4">Entity Name</th>
              <th class="py-3 px-4">Sector / Category</th>
              <th class="py-3 px-4">Location</th>
              <th class="py-3 px-4">Verified Business Email</th>
              <th class="py-3 px-4">Official Web Domain</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-[#0B1F3A]">
            {sampleData.map(row => (
              <tr class="hover:bg-gray-50/50">
                <td class="py-3 px-4 font-semibold">{row.name}</td>
                <td class="py-3 px-4 text-gray-600">{row.sector}</td>
                <td class="py-3 px-4 text-gray-600">{row.location}</td>
                <td class="py-3 px-4 font-mono text-gray-500">{row.contact}</td>
                <td class="py-3 px-4 text-[#0878E8]">{row.website}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- SECTION 4: FAQS -->
  <LandingFAQ faqs={faqs} title="Frequently Asked Questions on Knowletive Data Solutions" />

  <!-- SECTION 5: FINAL CTA -->
  <section class="section-padding bg-gray-50 border-t border-gray-200 text-center" data-analytics-section="final-cta">
    <div class="container-custom max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-manrope font-extrabold text-[#0B1F3A] mb-4">
        Accelerate Your B2B Outreach With Clean Data
      </h2>
      <p class="text-[#64748B] text-sm sm:text-base max-w-xl mx-auto mb-8">
        Submit your business requirements today to receive a verified sample and quotation within 24 hours.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="#lead-form" class="btn-primary w-full sm:w-auto px-8 py-3.5 text-sm shadow-md">
          {primaryCta}
        </a>
        <a href="tel:+919970600116" class="btn-secondary w-full sm:w-auto px-6 py-3.5 text-xs font-bold">
          Call +91 99706 00116
        </a>
      </div>
    </div>
  </section>

  <StickyMobileCTA primaryCtaText={primaryCta} serviceName={serviceTitle} />
</BaseLayout>

