---
// ============================================================
// /cet-2027-admission-counseling
// Conversion-Focused Landing Page: CET 2027 Admission Counseling
// Primary CTA: "Get Admission Guidance"
// ============================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHeader from '../components/landing/LandingHeader.astro';
import LandingLeadForm, { type FormField } from '../components/landing/LandingLeadForm.astro';
import LandingFAQ from '../components/landing/LandingFAQ.astro';
import StickyMobileCTA from '../components/landing/StickyMobileCTA.astro';
import UTMTracker from '../components/landing/UTMTracker.astro';

const serviceTitle = "CET 2027 Admission Counseling";
const primaryCta = "Get Admission Guidance";

const customFields: FormField[] = [
  {
    name: "targetCourse",
    label: "Target CET Examination / Stream",
    type: "select",
    required: true,
    placeholder: "Select your target CET exam",
    options: [
      { value: "MHT-CET (Engineering / B.Tech)", label: "MHT-CET (Engineering / B.Tech - COEP, VJTI, PICT, SPIT)" },
      { value: "MHT-CET (Pharmacy / B.Pharm)", label: "MHT-CET (Pharmacy / B.Pharm)" },
      { value: "MAH-MBA / MMS CET", label: "MAH-MBA / MMS CET (JBIMS, SIMSREE, PUMBA, Welingkar)" },
      { value: "MAH-MCA CET", label: "MAH-MCA CET (Master of Computer Applications)" },
      { value: "Other Maharashtra CET", label: "Other Maharashtra CET (Law / Hotel Management)" }
    ]
  },
  {
    name: "currentStatus",
    label: "Applicant Category",
    type: "select",
    required: true,
    placeholder: "Select category",
    options: [
      { value: "Maharashtra State Candidate (General/OBC/SC/ST/EWS)", label: "Maharashtra State Candidate (Home / Other University)" },
      { value: "All India Candidate (OMS)", label: "All India Candidate (OMS / Outside Maharashtra)" },
      { value: "TFWS / Minority / PwD", label: "TFWS / Minority / PwD Eligible Candidate" },
      { value: "Parent Inquiring for Ward", label: "Parent Inquiring for Ward" }
    ]
  }
];

const problems = [
  {
    icon: "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    title: "Complex CAP Round Rules",
    desc: "The Centralized Admission Process (CAP) has multi-layered reservation quotas, freeze/float mechanisms, and strict verification timelines that confuse families."
  },
  {
    icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
    title: "Document Rejections & Delays",
    desc: "Missing non-creamy layer certificates, income validity, or caste validity documents during Scrutiny Center verification can invalidate category benefits."
  },
  {
    icon: "M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z",
    title: "Uninformed Preference Filling",
    desc: "Submitting wrong college preference sequences without analyzing previous cutoffs often results in losing seats at superior institutions."
  },
  {
    icon: "M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    title: "Fake Agents & False Guarantees",
    desc: "Unscrupulous middlemen promise 'guaranteed allotments' for illegal donations. In reality, state CAP admissions are computerized and strictly merit-governed."
  }
];

const solutions = [
  {
    step: "01",
    title: "Cutoff Analysis & College Shortlisting",
    desc: "We analyze previous multi-year round-wise cutoff percentiles for your category across top colleges in Pune, Mumbai, and Maharashtra."
  },
  {
    step: "02",
    title: "Strategic Option Form Preparation",
    desc: "Formulate a personalized high-probability choice matrix (Dream, Realistic, and Safe colleges) for CAP Round 1, Round 2, and Round 3."
  },
  {
    step: "03",
    title: "Document Scrutiny Readiness",
    desc: "Pre-verify all required category certificates, domicile certificates, income certificates, and receipts to prevent last-minute rejection."
  },
  {
    step: "04",
    title: "Real-Time Round Support",
    desc: "Live guidance on Freeze vs. Float decisions, institutional round procedures, and vacancy seat evaluations as official rounds progress."
  }
];

const inclusions = [
  { title: "Personalized Choice Form Draft", detail: "Prioritized college code sequence tailored to your percentile and stream." },
  { title: "Document Audit Checklist", detail: "Step-by-step checklist of original and attested copies for Scrutiny Centers." },
  { title: "Category & Quota Evaluation", detail: "Guidance on Home University, Other Than Home, TFWS, and EWS quotas." },
  { title: "CAP Round 1, 2 & 3 Advisory", detail: "Strategic recommendations on seat acceptance, betterments, and floats." },
  { title: "Institutional / Spot Round Guidance", detail: "Transparent information on college-level vacancy seat application procedures." },
  { title: "College Fee & ROI Comparison", detail: "Tuition fees, hostel estimates, and recent placement trends across options." }
];

const faqs = [
  {
    question: "Which CET examinations does Knowletive support?",
    answer: "We support Maharashtra State CET Cell examinations, primarily MHT-CET (Engineering and Pharmacy), MAH-MBA/MMS CET (Management), and MAH-MCA CET (Computer Applications)."
  },
  {
    question: "Does Knowletive guarantee seat allotment or admission?",
    answer: "No. Knowletive strictly provides authentic guidance, preference strategy, and document verification support. Under Maharashtra government rules, seat allotment is computerized and strictly determined by merit rank, category, and submitted preferences."
  },
  {
    question: "When should we start preparing for CET 2027 admission counseling?",
    answer: "The best time is well before the exam window and CAP registration to get documents (caste validity, non-creamy layer, domicile) in order. Early planning allows you to shortlist colleges calmly."
  },
  {
    question: "Can parents attend the CAP counseling session?",
    answer: "Yes, both the student and parents are encouraged to join the session so all college choices, travel preferences, and fee considerations are thoroughly understood."
  },
  {
    question: "What is the difference between Freeze, Betterment (Float), and Exit in CAP?",
    answer: "Our counselors will explain each mechanism in detail during your session so you don't accidentally forfeit an allotted seat or miss out on a higher-preference college."
  }
];
---

<BaseLayout 
  title="CET 2027 Admission Counseling in Pune | MHT-CET & MBA CET Guidance — Knowletive"
  description="Expert Maharashtra CET 2027 admission counseling. College shortlisting, CAP round preference filling, cutoff analysis, and document verification guidance in Pune."
>
  <UTMTracker />
  <LandingHeader primaryCtaText={primaryCta} serviceTitle={serviceTitle} />

  <!-- HERO SECTION -->
  <section id="overview" class="page-header-spacing pb-16 bg-[#0B1F3A] text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-15 pointer-events-none" style="background-image: radial-gradient(#0878E8 1px, transparent 1px); background-size: 28px 28px;"></div>

    <div class="container-custom relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Left: Headline & Highlights -->
        <div class="lg:col-span-7 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/20 text-[#F47A16] font-bold text-xs uppercase tracking-wider mb-5">
            <span class="w-2 h-2 rounded-full bg-[#F47A16] animate-pulse"></span>
            Maharashtra State CET Admissions Guidance
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-manrope font-extrabold tracking-tight text-white mb-5 leading-tight">
            Navigate <span class="text-[#F47A16]">CET 2027 Admissions</span> With Clarity & Strategy.
          </h1>

          <p class="text-blue-100 text-sm sm:text-base md:text-lg max-w-xl mx-auto lg:mx-0 mb-6 leading-relaxed">
            From cutoff analysis and document readiness to CAP round choice filling. Get step-by-step guidance for MHT-CET (Engineering/Pharmacy), MBA-CET, and MCA-CET in Maharashtra.
          </p>

          <!-- Important Transparent Disclaimer Box -->
          <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 max-w-xl text-left text-xs text-blue-200/90 leading-relaxed mb-8">
            <strong class="text-white block mb-0.5">⚠️ Transparent Legal Notice:</strong>
            Knowletive provides strategic counseling, choice-sequence planning, and documentation support. Admissions are conducted strictly by the Maharashtra State CET Cell based on merit. We do not guarantee seat allotment or offer illegal donation quotas.
          </div>

          <!-- Secondary Actions -->
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3">
            <a href="#lead-form" class="btn-primary w-full sm:w-auto px-8 py-3.5 text-sm shadow-xl">
              {primaryCta}
            </a>
            <a 
              href="https://wa.me/919970600116?text=Hi%20Knowletive%2C%20I%20have%20questions%20regarding%20CET%202027%20Admission%20Counseling." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white/10 hover:bg-white/15 text-white font-semibold text-xs border border-white/20 transition-all"
            >
              <svg class="w-4 h-4 text-[#25D366] fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Chat on WhatsApp
            </a>
          </div>
        </div>

        <!-- Right: Compact Form -->
        <div class="lg:col-span-5">
          <LandingLeadForm 
            serviceId="cet-2027"
            serviceName={serviceTitle}
            primaryCta={primaryCta}
            headline="Request Admission Guidance"
            subheadline="Specify your target CET exam to get cutoff advice from our counselors."
            customFields={customFields}
            compact={true}
          />
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION 2: PROBLEMS -->
  <section id="problems" class="section-padding bg-[#F7F9FC]" data-analytics-section="problems">
    <div class="container-custom">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-manrope font-extrabold text-[#0B1F3A] mb-3">
          Why CET Candidates Miss Their Best College Options
        </h2>
        <p class="text-[#64748B] text-sm md:text-base">
          Every year, thousands of students lose opportunities due to technical errors in option forms and document gaps.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {problems.map((prob) => (
          <div class="bg-white p-6 rounded-2xl border border-gray-200/80 shadow-sm">
            <div class="w-12 h-12 rounded-xl bg-orange-50 text-[#F47A16] flex items-center justify-center mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={prob.icon}></path></svg>
            </div>
            <h3 class="font-manrope font-bold text-base text-[#0B1F3A] mb-2">{prob.title}</h3>
            <p class="text-xs text-[#64748B] leading-relaxed">{prob.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 3: SOLUTION -->
  <section id="solution" class="section-padding bg-white" data-analytics-section="solution">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-[#0878E8] font-bold text-xs uppercase tracking-wider mb-3">
            Knowletive Strategy
          </div>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-manrope font-extrabold text-[#0B1F3A] mb-4 leading-tight">
            Data-Driven College Preference Planning
          </h2>
          <p class="text-[#64748B] text-sm leading-relaxed mb-6">
            We build a mathematical preference sequence matching your percentile, category, branch priorities, and budget across Maharashtra's premier universities.
          </p>
          <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-100 text-xs text-emerald-800 font-medium leading-relaxed">
            ✓ Over 8 years of historical CAP round cutoff benchmarks analyzed across Pune, Mumbai, Nagpur, and Aurangabad colleges.
          </div>
        </div>

        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {solutions.map((sol) => (
            <div class="p-6 rounded-2xl bg-gray-50 border border-gray-100">
              <span class="text-xs font-mono font-bold text-[#0878E8] block mb-2">{sol.step}</span>
              <h3 class="font-manrope font-bold text-base text-[#0B1F3A] mb-2">{sol.title}</h3>
              <p class="text-xs text-[#64748B] leading-relaxed">{sol.desc}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION 4: WHAT IS INCLUDED -->
  <section id="benefits" class="section-padding bg-[#F7F9FC]" data-analytics-section="benefits">
    <div class="container-custom">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-manrope font-extrabold text-[#0B1F3A] mb-3">
          Included in CET 2027 Admission Guidance
        </h2>
        <p class="text-[#64748B] text-sm">
          Specific guidance tools and counseling support provided to every registered applicant.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {inclusions.map((item) => (
          <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
            <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center mb-3">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <h3 class="font-manrope font-bold text-base text-[#0B1F3A] mb-1">{item.title}</h3>
            <p class="text-xs text-[#64748B] leading-relaxed">{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 5: HOW IT WORKS -->
  <section id="process" class="section-padding bg-white" data-analytics-section="process">
    <div class="container-custom max-w-4xl">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-manrope font-extrabold text-[#0B1F3A] mb-3">
          How Our CET Admission Guidance Works
        </h2>
        <p class="text-[#64748B] text-sm">Four seamless steps throughout the CAP timeline.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="text-center p-4">
          <div class="w-12 h-12 rounded-full bg-[#0B1F3A] text-white font-manrope font-bold text-sm flex items-center justify-center mx-auto mb-3 shadow-md">1</div>
          <h3 class="font-bold text-sm text-[#0B1F3A] mb-1">Submit Scores</h3>
          <p class="text-xs text-[#64748B]">Provide your CET exam, estimated percentile, and branch choice.</p>
        </div>
        <div class="text-center p-4">
          <div class="w-12 h-12 rounded-full bg-[#0878E8] text-white font-manrope font-bold text-sm flex items-center justify-center mx-auto mb-3 shadow-md">2</div>
          <h3 class="font-bold text-sm text-[#0B1F3A] mb-1">Cutoff Audit</h3>
          <p class="text-xs text-[#64748B]">Review realistic college matches and fee structures with a counselor.</p>
        </div>
        <div class="text-center p-4">
          <div class="w-12 h-12 rounded-full bg-[#F47A16] text-white font-manrope font-bold text-sm flex items-center justify-center mx-auto mb-3 shadow-md">3</div>
          <h3 class="font-bold text-sm text-[#0B1F3A] mb-1">Option Form Fill</h3>
          <p class="text-xs text-[#64748B]">Craft your prioritized college preference code sequence for Round 1.</p>
        </div>
        <div class="text-center p-4">
          <div class="w-12 h-12 rounded-full bg-emerald-600 text-white font-manrope font-bold text-sm flex items-center justify-center mx-auto mb-3 shadow-md">4</div>
          <h3 class="font-bold text-sm text-[#0B1F3A] mb-1">CAP Round Live Help</h3>
          <p class="text-xs text-[#64748B]">Receive real-time decision support on Float/Freeze decisions.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 6: WHY KNOWLETIVE & PRICING -->
  <section class="section-padding bg-[#072B6F] text-white" data-analytics-section="why-knowletive">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7">
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-manrope font-extrabold mb-4 leading-tight">
            Verifiable Guidance by Pune Admission Specialists
          </h2>
          <p class="text-blue-100 text-sm leading-relaxed mb-6">
            Located in Baner, Pune, our counseling team actively tracks Maharashtra State CET Cell government gazettes, CAP round schedules, and official university seat matrices.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-blue-100">
            <div class="p-4 rounded-xl bg-white/5 border border-white/10">
              <strong class="text-white block text-sm mb-1">Authentic Information</strong>
              Data sourced directly from official mahacet.org portal archives and verified college authorities.
            </div>
            <div class="p-4 rounded-xl bg-white/5 border border-white/10">
              <strong class="text-white block text-sm mb-1">Zero Hidden Donations</strong>
              We do not accept donations or make false backdoor promises. 100% legal merit guidance.
            </div>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="bg-white/10 border border-white/15 p-6 sm:p-8 rounded-2xl backdrop-blur-md">
            <h3 class="text-lg font-bold font-manrope mb-3 text-[#F47A16]">Guidance Package Terms</h3>
            <p class="text-xs text-blue-100 leading-relaxed mb-4">
              • Initial Assessment: Free basic eligibility & document verification check.
              <br/>
              • End-to-End CAP Round Support Package: Transparent fixed fee covering Option Form drafts for all 3 rounds and spot round advisory.
            </p>
            <a href="#lead-form" class="btn-primary w-full py-3 text-xs font-bold text-center justify-center">
              {primaryCta}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 7: FAQS -->
  <LandingFAQ faqs={faqs} title="Frequently Asked Questions on CET 2027 Admission Guidance" />

  <!-- SECTION 8: FINAL CTA -->
  <section class="section-padding bg-gray-50 border-t border-gray-200 text-center" data-analytics-section="final-cta">
    <div class="container-custom max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-manrope font-extrabold text-[#0B1F3A] mb-4">
        Don't Leave Your College Allotment to Chance
      </h2>
      <p class="text-[#64748B] text-sm sm:text-base max-w-xl mx-auto mb-8">
        Submit your target CET exam and category today for an honest, strategic admission consultation.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="#lead-form" class="btn-primary w-full sm:w-auto px-8 py-3.5 text-sm shadow-md">
          {primaryCta}
        </a>
        <a href="tel:+919970600116" class="btn-secondary w-full sm:w-auto px-6 py-3.5 text-xs font-bold">
          Call +91 99706 00116
        </a>
      </div>
    </div>
  </section>

  <StickyMobileCTA primaryCtaText={primaryCta} serviceName={serviceTitle} />
</BaseLayout>

