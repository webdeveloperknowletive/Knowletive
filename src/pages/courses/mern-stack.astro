---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConsultationCTA from '../../components/ConsultationCTA.astro';
import CourseInquiry from '../../components/CourseInquiry.astro';

const skills = ["HTML5/CSS3","JavaScript ES6+","React.js","Node.js","Express.js","MongoDB","REST APIs","Git"];
const roadmap = [{"step":"01","title":"Web Fundamentals","desc":"HTML, CSS, Responsive Design"},{"step":"02","title":"JavaScript","desc":"ES6+, DOM manipulation, Async JS"},{"step":"03","title":"React","desc":"Components, Hooks, React Router"},{"step":"04","title":"State Management","desc":"Context API, Redux toolkit"},{"step":"05","title":"Node.js","desc":"Runtime environment, modules, file system"},{"step":"06","title":"Express.js","desc":"Server setup, middleware, routing"},{"step":"07","title":"MongoDB","desc":"NoSQL DB, CRUD operations, Aggregation"},{"step":"08","title":"REST APIs","desc":"API design, request/response cycles"},{"step":"09","title":"Authentication","desc":"JWT, secure login/registration flows"},{"step":"10","title":"Full-Stack Projects","desc":"Integrating frontend with backend"},{"step":"11","title":"Deployment","desc":"Hosting apps on cloud platforms"}];
const careers = ["Frontend Developer","React Developer","Backend Developer","Full Stack Developer"];
---

<BaseLayout 
  title="MERN Stack Development Course | Knowletive" 
  description="Learn frontend and backend development using JavaScript technologies and build complete production-ready web applications."
>
  <!-- 1. Breadcrumb -->
  <div class="bg-[#0B1F3A] border-b border-white/10 pt-6 pb-2">
    <div class="container-custom">
      <nav aria-label="Breadcrumb" class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-blue-200 bg-white/10 px-4 py-1.5 rounded-full backdrop-blur-sm">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/courses" class="hover:text-white transition-colors">Courses</a>
        <span>/</span>
        <span class="text-[#F47A16]">MERN Stack Development</span>
      </nav>
    </div>
  </div>

  <!-- 2. Course Hero -->
  <section class="relative pt-12 pb-20 bg-[#0B1F3A] text-white overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
      <div class="absolute inset-0" style="background-image: radial-gradient(white 1px, transparent 1px); background-size: 40px 40px; mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);"></div>
    </div>
    <div class="container-custom relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/20 text-white font-bold text-xs tracking-widest uppercase mb-6">
            Job-Ready Program
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-manrope font-extrabold mb-6">
            Become a <br/><span class="text-[#F47A16]">MERN Stack Development Professional</span>
          </h1>
          <p class="text-lg md:text-xl text-blue-100 max-w-xl mb-8 leading-relaxed">
            Learn frontend and backend development using JavaScript technologies and build complete production-ready web applications.
          </p>
          <div class="flex flex-col sm:flex-row items-center gap-4">
            <a href="#inquiry-form" class="btn-primary w-full sm:w-auto text-center">Request Course Details</a>
            <a href="/contact" class="btn-outline border-white/30 text-white hover:bg-white/10 w-full sm:w-auto text-center">Book Free Consultation</a>
          </div>
        </div>
        
        <div class="hidden lg:block relative">
          <div class="absolute inset-0 bg-gradient-to-tr from-[#0878E8]/30 to-[#F47A16]/30 rounded-3xl blur-3xl -z-10"></div>
          <div class="bg-white/10 border border-white/20 backdrop-blur-md rounded-3xl p-8 shadow-2xl relative overflow-hidden">
            <h3 class="text-2xl font-bold font-manrope mb-4">Core Focus</h3>
            <div class="flex flex-wrap gap-2">
              {skills.slice(0, 6).map(skill => (
                <span class="bg-white/10 px-4 py-2 rounded-lg text-sm font-semibold">{skill}</span>
              ))}
              <span class="bg-[#F47A16]/20 text-[#F47A16] px-4 py-2 rounded-lg text-sm font-semibold">+ More</span>
            </div>
            <div class="mt-8 p-4 bg-[#0B1F3A]/50 rounded-xl border border-white/10">
              <p class="text-sm text-blue-200 font-semibold mb-1">Career Goal</p>
              <p class="text-lg font-bold">Build Modern Full-Stack Web Applications.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Navigation Sticky Bar -->
  <div class="sticky top-[72px] z-30 bg-white border-b border-gray-200 shadow-sm hidden md:block">
    <div class="container-custom">
      <ul class="flex items-center gap-8 overflow-x-auto whitespace-nowrap py-4 font-semibold text-sm text-[#64748B]">
        <li><a href="#overview" class="hover:text-[#0878E8]">Overview</a></li>
        <li><a href="#curriculum" class="hover:text-[#0878E8]">Curriculum</a></li>
        <li><a href="#roadmap" class="hover:text-[#0878E8]">Roadmap</a></li>
        <li><a href="#career" class="hover:text-[#0878E8]">Career Paths</a></li>
        <li><a href="#why-us" class="hover:text-[#0878E8]">Why Knowletive</a></li>
      </ul>
    </div>
  </div>

  <!-- 3. Course Overview & 5. Skills -->
  <section id="overview" class="section-padding bg-white">
    <div class="container-custom">
      <div class="grid lg:grid-cols-12 gap-12">
        <div class="lg:col-span-7">
          <h2 class="text-3xl md:text-4xl font-manrope font-bold text-[#0B1F3A] mb-6">Course Overview</h2>
          <p class="text-lg text-[#64748B] leading-relaxed mb-6">
            Learn frontend and backend development using JavaScript technologies and build complete production-ready web applications. We focus on practical, job-oriented training that prepares you for the realities of the industry.
          </p>
          <div class="bg-gray-50 border-l-4 border-[#F47A16] p-6 rounded-r-xl">
            <h4 class="font-bold text-[#0B1F3A] text-lg mb-2">Build Modern Full-Stack Web Applications.</h4>
            <p class="text-[#64748B]">Our curriculum is designed by industry experts to bridge the gap between theoretical knowledge and practical execution.</p>
          </div>
        </div>
        
        <div class="lg:col-span-5">
          <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-8">
            <h3 class="text-2xl font-bold text-[#0B1F3A] mb-6 font-manrope">Skills You'll Learn</h3>
            <ul class="space-y-4">
              {skills.map(skill => (
                <li class="flex items-center gap-3">
                  <div class="w-6 h-6 rounded-full bg-[#10B981]/10 flex items-center justify-center text-[#10B981] shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  </div>
                  <span class="text-[#0B1F3A] font-semibold">{skill}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Learning Roadmap -->
  <section id="roadmap" class="section-padding bg-gray-50 border-y border-gray-200 overflow-hidden scroll-mt-24">
    <div id="curriculum" class="scroll-mt-24"></div>
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-manrope font-bold text-[#0B1F3A] mb-4">Step-by-Step Learning Roadmap</h2>
        <p class="text-[#64748B] text-lg">A structured journey from fundamentals to career readiness.</p>
      </div>

      <!-- Desktop Zig-Zag Timeline -->
      <div class="hidden md:block relative max-w-5xl mx-auto pb-10">
        <!-- Central Line -->
        <div class="absolute left-1/2 top-0 bottom-0 w-1 bg-gradient-to-b from-[#0878E8] to-[#F47A16] -translate-x-1/2 rounded-full"></div>
        
        <div class="space-y-12">
          {roadmap.map((item, index) => (
            <div class={`relative flex items-center justify-between w-full ${index % 2 === 0 ? 'flex-row-reverse' : ''}`}>
              <div class="w-5/12"></div>
              <div class="z-10 flex items-center justify-center w-12 h-12 bg-white border-4 border-[#0878E8] rounded-full shadow-lg shrink-0">
                <span class="font-bold text-[#0B1F3A] text-sm">{item.step}</span>
              </div>
              <div class={`w-5/12 ${index % 2 === 0 ? 'text-right' : 'text-left'}`}>
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                  <h4 class="font-bold text-xl text-[#0B1F3A] mb-2 font-manrope">{item.title}</h4>
                  <p class="text-[#64748B] text-sm">{item.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Mobile Vertical Timeline -->
      <div class="md:hidden relative border-l-2 border-[#0878E8] ml-6 space-y-8 pb-4">
        {roadmap.map(item => (
          <div class="relative pl-8">
            <div class="absolute -left-[21px] top-1 w-10 h-10 bg-white border-4 border-[#0878E8] rounded-full flex items-center justify-center font-bold text-[#0B1F3A] text-xs shadow-md">
              {item.step}
            </div>
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
              <h4 class="font-bold text-lg text-[#0B1F3A] mb-1">{item.title}</h4>
              <p class="text-[#64748B] text-sm">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. Projects & 11. Career Support -->
  <section id="career" class="section-padding bg-white">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-16">
        
        <!-- Career Opportunities -->
        <div>
          <h2 class="text-3xl font-manrope font-bold text-[#0B1F3A] mb-6">Career Opportunities</h2>
          <p class="text-[#64748B] mb-8">This program prepares you for various high-demand roles in the industry.</p>
          
          <div class="grid sm:grid-cols-2 gap-4">
            {careers.map(career => (
              <div class="bg-gray-50 p-4 rounded-xl border border-gray-100 flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-[#0878E8]/10 text-[#0878E8] flex items-center justify-center">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                </div>
                <span class="font-semibold text-[#0B1F3A]">{career}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Career Support -->
        <div id="why-us" class="scroll-mt-24">
          <h2 class="text-3xl font-manrope font-bold text-[#0B1F3A] mb-6">From Learning to Career Readiness</h2>
          <div class="space-y-4">
            <div class="flex gap-4 items-start">
              <div class="w-10 h-10 rounded-full bg-[#10B981]/10 text-[#10B981] flex items-center justify-center shrink-0 mt-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <div>
                <h4 class="font-bold text-[#0B1F3A] text-lg">Real-World Projects</h4>
                <p class="text-[#64748B] text-sm">Build a portfolio-ready project to showcase your skills during interviews.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start">
              <div class="w-10 h-10 rounded-full bg-[#10B981]/10 text-[#10B981] flex items-center justify-center shrink-0 mt-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
              </div>
              <div>
                <h4 class="font-bold text-[#0B1F3A] text-lg">Interview Preparation</h4>
                <p class="text-[#64748B] text-sm">Technical mock interviews and HR round preparation.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start">
              <div class="w-10 h-10 rounded-full bg-[#10B981]/10 text-[#10B981] flex items-center justify-center shrink-0 mt-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div>
                <h4 class="font-bold text-[#0B1F3A] text-lg">Placement Assistance</h4>
                <p class="text-[#64748B] text-sm">Resume building, LinkedIn optimization, and placement support.</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 16. Inquiry Form -->
  <CourseInquiry courseName="MERN Stack Development" />

</BaseLayout>
