---
// ============================================================
// /career-counseling
// Conversion-Focused Landing Page: Career Counseling
// Primary CTA: "Book Career Counseling"
// ============================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHeader from '../components/landing/LandingHeader.astro';
import LandingLeadForm, { type FormField } from '../components/landing/LandingLeadForm.astro';
import LandingFAQ from '../components/landing/LandingFAQ.astro';
import StickyMobileCTA from '../components/landing/StickyMobileCTA.astro';
import UTMTracker from '../components/landing/UTMTracker.astro';

const serviceTitle = "Career Counseling";
const primaryCta = "Book Career Counseling";

const customFields: FormField[] = [
  {
    name: "currentStatus",
    label: "Current Education or Career Stage",
    type: "select",
    required: true,
    placeholder: "Select your current stage",
    options: [
      { value: "Class 10th / 12th Student", label: "Class 10th / 12th Student (Stream Selection)" },
      { value: "College Student (Pursuing Degree)", label: "College Student (Pursuing Degree / Final Year)" },
      { value: "Recent Graduate / Fresher", label: "Recent Graduate / Fresher (Job Guidance)" },
      { value: "Working Professional", label: "Working Professional (Seeking Career Transition)" },
      { value: "Parent Inquiring for Child", label: "Parent Inquiring for Child" }
    ]
  },
  {
    name: "careerGoal",
    label: "Target Domain / Interest (Optional)",
    type: "text",
    required: false,
    placeholder: "e.g. Engineering, Data Science, Management, Civil Services"
  }
];

const problems = [
  {
    icon: "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z",
    title: "Stream & Course Overwhelm",
    desc: "Hundreds of modern degree choices, emerging fields, and buzzwords make it difficult for students and parents to pick the right academic direction."
  },
  {
    icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
    title: "Mismatched Skills & Aptitude",
    desc: "Choosing courses purely based on peer pressure or rumors often results in academic disengagement, low grades, and career dissatisfaction."
  },
  {
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    title: "Uncertain Industry Demand",
    desc: "Degrees that were lucrative five years ago may not offer good entry-level opportunities today. Students need realistic industry insights before investing years."
  },
  {
    icon: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
    title: "No Clear Action Roadmap",
    desc: "Graduates and students often know the destination they want, but lack an actionable, month-by-month preparation plan for entrance exams or skill milestones."
  }
];

const solutions = [
  {
    step: "01",
    title: "In-Depth Profile & Interest Mapping",
    desc: "We analyze your academic track record, strengths, problem-solving preferences, and long-term aspirations to identify compatible career sectors."
  },
  {
    step: "02",
    title: "Evidence-Based Domain Exploration",
    desc: "Compare high-growth fields (IT, Engineering, Business, Finance, Creative) with transparent data on career trajectories and prerequisite qualifications."
  },
  {
    step: "03",
    title: "Personalized Action Roadmap",
    desc: "Receive a structured roadmap covering exam prep timelines, essential courses, recommended institutions, and practical skill milestones."
  },
  {
    step: "04",
    title: "Dedicated Counselor Follow-Up",
    desc: "Direct access to our senior counseling mentors in Baner, Pune for queries regarding admission deadlines, entrance requirements, and parental discussions."
  }
];

const inclusions = [
  { title: "1-on-1 Counselor Consultation", detail: "60-minute focused session dedicated strictly to your background and aspirations." },
  { title: "Academic & Aptitude Review", detail: "Evaluation of marks, core subjects, and personal learning aptitude." },
  { title: "Career Cluster Comparison", detail: "Side-by-side analysis of 2 to 3 career streams with expected timelines." },
  { title: "Written Guidance Summary", detail: "Actionable notes and key milestones shared after the counseling session." },
  { title: "Entrance Exam Timelines", detail: "Official registration windows and criteria for relevant entrance tests." },
  { title: "Parent Counseling Support", detail: "Open discussion with parents to align educational expectations and budget." }
];

const faqs = [
  {
    question: "Who should take career counseling at Knowletive?",
    answer: "Our career counseling is designed for 10th and 12th standard students deciding streams or degree programs, college students planning their specialization, fresh graduates seeking structured career roadmaps, and working professionals evaluating a planned career shift."
  },
  {
    question: "Can parents attend the counseling session with the student?",
    answer: "Yes, absolutely. We strongly encourage parents to participate so that family goals, budget considerations, and academic choices are completely transparent and aligned."
  },
  {
    question: "Is the session conducted online or in person?",
    answer: "We offer both options. You can visit our office in Baner, Pune for an in-person session, or join a secure 1-on-1 Google Meet / Zoom session from anywhere in India."
  },
  {
    question: "Does counseling guarantee job placement or college admission?",
    answer: "No. Career counseling provides unbiased, professional clarity, roadmap planning, and course/college evaluation. College admissions and hiring decisions depend on your merit, entrance scores, and individual academic performance."
  },
  {
    question: "How soon can I schedule my session after submitting the form?",
    answer: "Our senior academic advisor will call or WhatsApp you within 24 working hours to confirm your current stage and book a convenient date and time."
  }
];
---

<BaseLayout 
  title="Career Counseling in Pune | 1-on-1 Guidance — Knowletive"
  description="Personalized 1-on-1 career counseling for students, parents, and graduates. Stream selection, career roadmap planning, and practical domain guidance with Knowletive Pune."
>
  <UTMTracker />
  <LandingHeader primaryCtaText={primaryCta} serviceTitle={serviceTitle} />

  <!-- SECTION 1: HERO -->
  <section id="overview" class="page-header-spacing pb-16 bg-[#072B6F] text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-15 pointer-events-none" style="background-image: radial-gradient(#0878E8 1px, transparent 1px); background-size: 28px 28px;"></div>
    
    <div class="container-custom relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Left: Headline & Reassurance -->
        <div class="lg:col-span-7 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/20 text-[#F47A16] font-bold text-xs uppercase tracking-wider mb-5">
            <span class="w-2 h-2 rounded-full bg-[#F47A16] animate-pulse"></span>
            Personalized Academic & Professional Guidance
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-manrope font-extrabold tracking-tight text-white mb-5 leading-tight">
            Stop Guessing Your Future. <br/>
            <span class="text-[#F47A16]">Make Confident Career Moves.</span>
          </h1>

          <p class="text-blue-100 text-sm sm:text-base md:text-lg max-w-xl mx-auto lg:mx-0 mb-8 leading-relaxed">
            Gain unbiased clarity on degree streams, high-growth career tracks, and actionable study milestones through personalized 1-on-1 mentorship with Knowletive advisors in Baner, Pune.
          </p>

          <!-- Factual Reassurance Pills -->
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 mb-8 text-xs text-blue-100">
            <div class="flex items-center gap-2 bg-white/10 px-3 py-1.5 rounded-lg border border-white/10">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>1-on-1 Private Consultation</span>
            </div>
            <div class="flex items-center gap-2 bg-white/10 px-3 py-1.5 rounded-lg border border-white/10">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Students, Parents & Graduates</span>
            </div>
            <div class="flex items-center gap-2 bg-white/10 px-3 py-1.5 rounded-lg border border-white/10">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Online & In-Person at Pune</span>
            </div>
          </div>

          <!-- Secondary Actions -->
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3">
            <a href="#lead-form" class="btn-primary w-full sm:w-auto px-8 py-3.5 text-sm shadow-xl">
              {primaryCta}
            </a>
            <a 
              href="https://wa.me/919970600116?text=Hi%20Knowletive%2C%20I%20would%20like%20to%20know%20more%20about%20Career%20Counseling." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white/10 hover:bg-white/15 text-white font-semibold text-xs border border-white/20 transition-all"
            >
              <svg class="w-4 h-4 text-[#25D366] fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Quick Question on WhatsApp
            </a>
          </div>
        </div>

        <!-- Right: Compact Form -->
        <div class="lg:col-span-5">
          <LandingLeadForm 
            serviceId="career-counseling"
            serviceName={serviceTitle}
            primaryCta={primaryCta}
            headline="Book Your Counseling Session"
            subheadline="Select your stage and get direct callback from our senior counselor."
            customFields={customFields}
            compact={true}
          />
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION 2: PROBLEMS -->
  <section id="problems" class="section-padding bg-[#F7F9FC]" data-analytics-section="problems">
    <div class="container-custom">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-manrope font-extrabold text-[#0B1F3A] mb-3">
          The Career Crossroads Dilemma
        </h2>
        <p class="text-[#64748B] text-sm md:text-base">
          Choosing an educational or career trajectory without verified guidance leads to costly detours.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {problems.map((prob) => (
          <div class="bg-white p-6 rounded-2xl border border-gray-200/80 shadow-sm hover:shadow-md transition-shadow">
            <div class="w-12 h-12 rounded-xl bg-red-50 text-red-500 flex items-center justify-center mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={prob.icon}></path></svg>
            </div>
            <h3 class="font-manrope font-bold text-base text-[#0B1F3A] mb-2">{prob.title}</h3>
            <p class="text-xs text-[#64748B] leading-relaxed">{prob.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 3: SOLUTION -->
  <section id="solution" class="section-padding bg-white" data-analytics-section="solution">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-[#0878E8] font-bold text-xs uppercase tracking-wider mb-3">
            Knowletive Solution
          </div>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-manrope font-extrabold text-[#0B1F3A] mb-4 leading-tight">
            A Structured, Data-Backed Path to Career Certainty
          </h2>
          <p class="text-[#64748B] text-sm leading-relaxed mb-6">
            We don't rely on generic advice or standardized computer reports. Our counseling process pairs human empathy with real Pune tech and industry recruitment realities to guide your next decision.
          </p>
          <div class="p-4 rounded-xl bg-blue-50/60 border border-blue-100 text-xs text-[#072B6F] font-medium leading-relaxed">
            "The objective of our career counseling is not to push a specific course, but to give the student and their family authentic facts and realistic next steps."
          </div>
        </div>

        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {solutions.map((sol) => (
            <div class="p-6 rounded-2xl bg-gray-50 border border-gray-100 hover:border-blue-200 transition-colors">
              <span class="text-xs font-mono font-bold text-[#F47A16] block mb-2">{sol.step}</span>
              <h3 class="font-manrope font-bold text-base text-[#0B1F3A] mb-2">{sol.title}</h3>
              <p class="text-xs text-[#64748B] leading-relaxed">{sol.desc}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION 4: BENEFITS & WHAT'S INCLUDED -->
  <section id="benefits" class="section-padding bg-[#F7F9FC]" data-analytics-section="benefits">
    <div class="container-custom">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-manrope font-extrabold text-[#0B1F3A] mb-3">
          What Is Included in Your Session
        </h2>
        <p class="text-[#64748B] text-sm">
          Specific deliverables and discussion topics covered during your counseling consultation.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {inclusions.map((item) => (
          <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
            <div class="w-8 h-8 rounded-lg bg-blue-50 text-[#0878E8] flex items-center justify-center mb-3">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <h3 class="font-manrope font-bold text-base text-[#0B1F3A] mb-1">{item.title}</h3>
            <p class="text-xs text-[#64748B] leading-relaxed">{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 5: HOW IT WORKS (PROCESS) -->
  <section id="process" class="section-padding bg-white" data-analytics-section="process">
    <div class="container-custom max-w-4xl">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-manrope font-extrabold text-[#0B1F3A] mb-3">
          How It Works
        </h2>
        <p class="text-[#64748B] text-sm">Four clear steps from enquiry to actionable plan.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 relative">
        <div class="text-center p-4">
          <div class="w-12 h-12 rounded-full bg-[#072B6F] text-white font-manrope font-bold text-sm flex items-center justify-center mx-auto mb-3 shadow-md">1</div>
          <h3 class="font-bold text-sm text-[#0B1F3A] mb-1">Submit Inquiry</h3>
          <p class="text-xs text-[#64748B]">Fill the quick booking form with your stage and questions.</p>
        </div>
        <div class="text-center p-4">
          <div class="w-12 h-12 rounded-full bg-[#0878E8] text-white font-manrope font-bold text-sm flex items-center justify-center mx-auto mb-3 shadow-md">2</div>
          <h3 class="font-bold text-sm text-[#0B1F3A] mb-1">Advisor Callback</h3>
          <p class="text-xs text-[#64748B]">We call or WhatsApp to confirm your preferred slot.</p>
        </div>
        <div class="text-center p-4">
          <div class="w-12 h-12 rounded-full bg-[#F47A16] text-white font-manrope font-bold text-sm flex items-center justify-center mx-auto mb-3 shadow-md">3</div>
          <h3 class="font-bold text-sm text-[#0B1F3A] mb-1">1-on-1 Session</h3>
          <p class="text-xs text-[#64748B]">Attend your 60-min private session (in-person or online).</p>
        </div>
        <div class="text-center p-4">
          <div class="w-12 h-12 rounded-full bg-emerald-600 text-white font-manrope font-bold text-sm flex items-center justify-center mx-auto mb-3 shadow-md">4</div>
          <h3 class="font-bold text-sm text-[#0B1F3A] mb-1">Action Roadmap</h3>
          <p class="text-xs text-[#64748B]">Receive your written guidance notes and next steps.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 6: WHY KNOWLETIVE -->
  <section class="section-padding bg-[#0B1F3A] text-white" data-analytics-section="why-knowletive">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-[#F47A16] font-bold text-xs uppercase tracking-wider mb-4 border border-white/10">
            Why Knowletive
          </div>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-manrope font-extrabold mb-4 leading-tight">
            Grounded in Real Industry and Academic Facts
          </h2>
          <p class="text-blue-100 text-sm leading-relaxed mb-6">
            Based in Baner, Pune, Knowletive mentors have guided hundreds of students through engineering, IT careers, competitive entrance planning, and study-abroad roadmaps.
          </p>
          <ul class="space-y-3 text-xs sm:text-sm text-blue-100">
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Personalized assessment tailored to individual strengths.</span>
            </li>
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Direct access to active technical trainers and recruitment mentors.</span>
            </li>
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>No biased push toward single partner institutes.</span>
            </li>
          </ul>
        </div>

        <div class="lg:col-span-6">
          <div class="bg-white/5 border border-white/10 p-6 sm:p-8 rounded-2xl backdrop-blur-sm">
            <h3 class="text-lg font-bold font-manrope mb-4 text-[#F47A16]">Pricing & Booking Terms</h3>
            <div class="space-y-3 text-xs text-blue-100 leading-relaxed mb-6">
              <p>• Initial 15-minute Discovery Consultation: <strong>Free of charge</strong>.</p>
              <p>• In-depth 60-minute Comprehensive 1-on-1 Session with Written Action Summary: Nominal advisory fee confirmed upon callback based on student stage.</p>
              <p>• No hidden subscription commitments or undisclosed upsells.</p>
            </div>
            <a href="#lead-form" class="btn-primary w-full py-3 text-xs font-bold text-center justify-center">
              {primaryCta}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 7: FAQS -->
  <LandingFAQ faqs={faqs} title="Frequently Asked Questions on Career Counseling" />

  <!-- SECTION 8: FINAL CTA -->
  <section class="section-padding bg-[#F7F9FC] border-t border-gray-200 text-center" data-analytics-section="final-cta">
    <div class="container-custom max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-manrope font-extrabold text-[#0B1F3A] mb-4">
        Ready to Build Your Career Strategy?
      </h2>
      <p class="text-[#64748B] text-sm sm:text-base max-w-xl mx-auto mb-8">
        Take 60 seconds to submit your details and let our counseling team provide the guidance you need.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="#lead-form" class="btn-primary w-full sm:w-auto px-8 py-3.5 text-sm shadow-md">
          {primaryCta}
        </a>
        <a href="tel:+919970600116" class="btn-secondary w-full sm:w-auto px-6 py-3.5 text-xs font-bold">
          Call +91 99706 00116
        </a>
      </div>
    </div>
  </section>

  <StickyMobileCTA primaryCtaText={primaryCta} serviceName={serviceTitle} />
</BaseLayout>

