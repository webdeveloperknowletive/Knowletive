---
// ============================================================
// /admin/candidates/[id]
// Candidate Deep Profile, Keyword Matching & Resume Inspector
// ============================================================

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../lib/db';
import { evaluateAllRoles } from '../../../lib/matcher';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/resumes');

const candidate = await db.getCandidateById(id);
if (!candidate) return Astro.redirect('/admin/resumes');

if (candidate.is_read === false) {
  await db.markCandidateAsRead(id);
  candidate.is_read = true;
  candidate.viewed_at = new Date().toISOString();
}

const [roles, allKeywords, keywordMatches, candidateApps] = await Promise.all([
  db.getJobRoles(false),
  db.getAllKeywords(false),
  db.getCandidateMatches(id),
  db.getApplications({ candidateId: id })
]);

const roleMap = new Map(roles.map(r => [r.id, r.role_name]));
const assignedRole = roles.find(r => r.id === candidate.assigned_role_id);

// Recalculate match details for each role for comprehensive chip breakdown
const matchAnalysis = evaluateAllRoles(
  candidate.extracted_text || '',
  roles,
  allKeywords,
  candidate.applied_role_id
);

const currentRoleMatch = matchAnalysis.results.find(r => r.role.id === candidate.assigned_role_id) || matchAnalysis.results[0];
---

<AdminLayout title={`Candidate: ${candidate.full_name}`} activeNav="resumes">

  <!-- Header Banner -->
  <div class="bg-white p-6 md:p-8 rounded-2xl border border-gray-100 shadow-sm mb-6 flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div class="flex items-start gap-4">
      <div class="w-16 h-16 rounded-2xl bg-[#0878E8]/10 text-[#0878E8] flex items-center justify-center font-manrope font-extrabold text-2xl shrink-0 border border-[#0878E8]/20">
        {candidate.first_name ? candidate.first_name.charAt(0).toUpperCase() : 'C'}
      </div>
      <div>
        <div class="flex items-center gap-3 flex-wrap">
          <h1 class="text-2xl font-bold font-manrope text-[#0B1F3A]">{candidate.full_name}</h1>
          <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-bold ${
            candidate.status === 'Shortlisted' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' :
            candidate.status === 'Selected' ? 'bg-green-50 text-green-700 border border-green-200' :
            candidate.status === 'Rejected' ? 'bg-red-50 text-red-700 border border-red-200' :
            'bg-amber-50 text-amber-700 border border-amber-200'
          }`}>
            {candidate.status}
          </span>
        </div>
        <p class="text-xs text-[#64748B] mt-1 flex items-center gap-3 flex-wrap">
          <span>{candidate.email}</span>
          <span>·</span>
          <span>{candidate.phone}</span>
          <span>·</span>
          <span>Applied: {new Date(candidate.created_at).toLocaleDateString('en-IN')}</span>
        </p>
      </div>
    </div>

    <!-- Quick Status & Download Actions -->
    <div class="flex items-center gap-3">
      <a 
        href={candidate.resume_file_url} 
        target="_blank" 
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#0878E8] hover:bg-[#0764c2] text-white font-manrope font-bold text-xs shadow-md shadow-[#0878E8]/20 transition-all"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
        Download Resume ({candidate.resume_file_type.includes('pdf') ? 'PDF' : candidate.resume_file_type.includes('word') ? 'DOCX' : 'TXT'})
      </a>
      <a href="/admin/resumes" class="px-4 py-2.5 rounded-xl border border-gray-200 text-xs font-semibold hover:bg-gray-50 transition-colors">
        Back to List
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    
    <!-- Left Column: Matched Keywords & Role Analysis (2 cols wide) -->
    <div class="lg:col-span-2 space-y-6">
      
      <!-- Role Match Score Card -->
      <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-[#64748B]">Assigned Role Analysis</span>
            <h2 class="text-lg font-bold text-[#0B1F3A]">{assignedRole?.role_name || 'Needs Review'}</h2>
          </div>
          <div class="text-right">
            <span class="text-xs font-bold text-[#64748B] block">Keyword Match Score</span>
            <span class="text-2xl font-extrabold text-[#0878E8]">{candidate.match_score}%</span>
          </div>
        </div>

        <div class="w-full bg-gray-100 h-2.5 rounded-full overflow-hidden mb-6">
          <div 
            class={`h-full rounded-full transition-all duration-500 ${candidate.match_score >= 60 ? 'bg-green-500' : candidate.match_score >= 40 ? 'bg-[#0878E8]' : 'bg-amber-500'}`}
            style={`width: ${candidate.match_score}%`}
          ></div>
        </div>

        <!-- Chips: Matched Keywords (Green) -->
        <div class="mb-5">
          <p class="text-xs font-bold uppercase tracking-wider text-green-700 mb-2 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Matched Keywords ({currentRoleMatch ? currentRoleMatch.matchedKeywords.length : 0})
          </p>
          <div class="flex flex-wrap gap-2">
            {currentRoleMatch && currentRoleMatch.matchedKeywords.map(kw => (
              <span class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-bold bg-green-50 text-green-800 border border-green-200">
                {kw} <span class="ml-1 text-green-600">✓</span>
              </span>
            ))}
            {(!currentRoleMatch || currentRoleMatch.matchedKeywords.length === 0) && (
              <span class="text-xs text-gray-400 italic">No role keywords were matched in resume text.</span>
            )}
          </div>
        </div>

        <!-- Chips: Missing / Recommended Keywords (Gray) -->
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-[#64748B] mb-2 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Missing / Recommended Keywords ({currentRoleMatch ? currentRoleMatch.missingKeywords.length : 0})
          </p>
          <p class="text-[11px] text-gray-400 mb-2.5">These keywords are recommended for this domain. Missing keywords are indicators for growth, not candidate failures.</p>
          <div class="flex flex-wrap gap-2">
            {currentRoleMatch && currentRoleMatch.missingKeywords.map(kw => (
              <span class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-gray-100 text-gray-600 border border-gray-200">
                {kw}
              </span>
            ))}
          </div>
        </div>

      </div>

      <!-- Other Role Match Scores Breakdown -->
      <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
        <h2 class="text-sm font-bold uppercase tracking-wider text-[#0B1F3A] mb-4">Scores Across All Roles</h2>
        <div class="space-y-4">
          {matchAnalysis.results.map(r => (
            <div>
              <div class="flex items-center justify-between text-xs mb-1">
                <span class="font-bold text-[#0B1F3A]">{r.role.role_name}</span>
                <span class="font-semibold text-gray-600">{r.score}% ({r.matchedKeywords.length}/{r.totalKeywords} keywords)</span>
              </div>
              <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden">
                <div class="h-full bg-[#0878E8] rounded-full" style={`width: ${r.score}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Candidate Applications History (Jobs & Internships) -->
      <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-sm font-bold uppercase tracking-wider text-[#0B1F3A]">Application History</h2>
            <p class="text-xs text-[#64748B]">All job and internship applications linked to this candidate profile.</p>
          </div>
          <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-blue-50 text-[#0878E8]">
            {candidateApps.length} {candidateApps.length === 1 ? 'Application' : 'Applications'}
          </span>
        </div>

        {candidateApps.length === 0 ? (
          <p class="text-xs text-gray-400 italic">No applications recorded yet.</p>
        ) : (
          <div class="divide-y divide-gray-100 border border-gray-100 rounded-xl overflow-hidden">
            {candidateApps.map(app => {
              const isIntern = app.application_type === 'internship';
              return (
                <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-gray-50/70 transition-colors">
                  <div>
                    <div class="flex items-center gap-2 mb-1">
                      <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold ${
                        isIntern ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-blue-50 text-blue-700 border border-blue-200'
                      }`}>
                        <span class={`w-1.5 h-1.5 rounded-full ${isIntern ? 'bg-emerald-500' : 'bg-blue-500'}`}></span>
                        {isIntern ? 'Internship' : 'Job'}
                      </span>
                      <span class="font-bold text-[#0B1F3A] text-sm">
                        {app.applied_role || (isIntern ? (app.internship?.title || 'Internship') : (app.job?.title || 'Job'))}
                      </span>
                    </div>
                    <p class="text-xs text-[#64748B]">
                      {isIntern ? (app.internship?.department || 'Department N/A') : (app.job?.company || 'Company N/A')} · Match Score: <strong class="text-[#0878E8]">{app.match_score || 0}%</strong>
                    </p>
                  </div>
                  <div class="flex items-center gap-3">
                    <span class={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold ${
                      app.status === 'Shortlisted' || app.status === 'Selected' ? 'bg-green-50 text-green-700' :
                      app.status === 'Rejected' ? 'bg-red-50 text-red-700' : 'bg-blue-50 text-blue-700'
                    }`}>
                      {app.status}
                    </span>
                    <span class="text-xs text-gray-400">
                      {new Date(app.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                    </span>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>

      <!-- Extracted Resume Text Inspector -->
      <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-sm font-bold uppercase tracking-wider text-[#0B1F3A]">Extracted Document Text</h2>
          <span class="text-xs text-gray-400">Length: {candidate.extracted_text?.length || 0} characters</span>
        </div>
        <div class="bg-slate-50 p-4 rounded-xl border border-gray-200 text-xs font-mono text-[#0B1F3A] max-h-96 overflow-y-auto whitespace-pre-wrap leading-relaxed">
          {candidate.extracted_text || 'No text extracted.'}
        </div>
      </div>

    </div>

    <!-- Right Column: Profile Details, Socials, Status Management -->
    <div class="space-y-6">
      
      <!-- Management Controls -->
      <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm space-y-4">
        <h2 class="text-sm font-bold uppercase tracking-wider text-[#0B1F3A]">Workflow Management</h2>
        
        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Candidate Status</label>
          <select id="update-status" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 bg-white font-medium outline-none focus:border-[#0878E8]">
            <option value="New" selected={candidate.status === 'New'}>New</option>
            <option value="Needs Review" selected={candidate.status === 'Needs Review'}>Needs Review</option>
            <option value="Shortlisted" selected={candidate.status === 'Shortlisted'}>Shortlisted</option>
            <option value="Interviewing" selected={candidate.status === 'Interviewing'}>Interviewing</option>
            <option value="Selected" selected={candidate.status === 'Selected'}>Selected</option>
            <option value="Rejected" selected={candidate.status === 'Rejected'}>Rejected</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Assigned Job Role</label>
          <select id="update-role" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 bg-white font-medium outline-none focus:border-[#0878E8]">
            <option value="">Needs Review / Unassigned</option>
            {roles.map(r => (
              <option value={r.id} selected={candidate.assigned_role_id === r.id}>{r.role_name}</option>
            ))}
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Admin Internal Notes</label>
          <textarea 
            id="update-notes" 
            rows="4" 
            placeholder="Interview feedback, interview dates, assessment results..."
            class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]"
          >{candidate.admin_notes || ''}</textarea>
        </div>

        <button 
          id="save-changes-btn"
          class="w-full py-2.5 bg-[#0878E8] hover:bg-[#0764c2] text-white font-bold text-xs rounded-xl transition-colors cursor-pointer"
        >
          Save Changes
        </button>
      </div>

      <!-- Candidate Contact & Background Info -->
      <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm space-y-4">
        <h2 class="text-sm font-bold uppercase tracking-wider text-[#0B1F3A]">Profile Details</h2>
        
        <div class="text-xs space-y-3">
          <div>
            <span class="text-gray-400 block">Full Name</span>
            <span class="font-bold text-[#0B1F3A] text-sm">{candidate.full_name}</span>
          </div>

          <div>
            <span class="text-gray-400 block">Email</span>
            <a href={`mailto:${candidate.email}`} class="font-medium text-[#0878E8]">{candidate.email}</a>
          </div>

          <div>
            <span class="text-gray-400 block">Phone</span>
            <a href={`tel:${candidate.phone}`} class="font-medium text-[#0B1F3A]">{candidate.phone}</a>
          </div>

          <div>
            <span class="text-gray-400 block">Location</span>
            <span class="font-medium text-[#0B1F3A]">{candidate.city || 'Location not detected'}, {candidate.country || 'India'}</span>
          </div>

          <div>
            <span class="text-gray-400 block">Education / Degree</span>
            <span class="font-medium text-[#0B1F3A]">{candidate.degree || 'Degree not detected'}</span>
          </div>

          <div>
            <span class="text-gray-400 block">College / University</span>
            <span class="font-medium text-[#0B1F3A]">{candidate.college || 'College not detected'}</span>
          </div>

          <div>
            <span class="text-gray-400 block">Experience</span>
            <span class="font-medium text-[#0B1F3A]">
              {candidate.years_experience !== undefined ? `${candidate.years_experience} Years` : 'Fresher'}
            </span>
          </div>
        </div>

        <!-- Links -->
        <div class="pt-4 border-t border-gray-100">
          <span class="text-xs text-gray-400 block mb-2 font-semibold">Profiles & Repositories</span>
          <div class="flex flex-col gap-2 text-xs">
            {candidate.linkedin_url ? (
              <a href={candidate.linkedin_url} target="_blank" class="text-blue-600 hover:underline flex items-center gap-1.5">
                <span class="font-bold bg-blue-50 px-1 py-0.5 rounded border border-blue-100">in</span>
                LinkedIn Profile
              </a>
            ) : (
              <span class="text-gray-400 italic">No LinkedIn profile detected</span>
            )}

            {candidate.github_url ? (
              <a href={candidate.github_url} target="_blank" class="text-gray-800 hover:underline flex items-center gap-1.5">
                <span class="font-bold bg-gray-100 px-1 py-0.5 rounded border border-gray-200">GH</span>
                GitHub Profile
              </a>
            ) : (
              <span class="text-gray-400 italic">No GitHub profile detected</span>
            )}
          </div>
        </div>

      </div>

      <!-- Discovered Skills Badges -->
      <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
        <h2 class="text-sm font-bold uppercase tracking-wider text-[#0B1F3A] mb-3">Extracted Skills</h2>
        <div class="flex flex-wrap gap-1.5">
          {candidate.skills && candidate.skills.length > 0 ? (
            candidate.skills.map(s => (
              <span class="px-2.5 py-1 rounded-md text-xs font-semibold bg-blue-50 text-[#0878E8] border border-blue-100">
                {s}
              </span>
            ))
          ) : (
            <span class="text-xs text-gray-400 italic">No skills cataloged</span>
          )}
        </div>
      </div>

    </div>

  </div>

  <script define:vars={{ candidateId: candidate.id }}>
    // Notify sidebar to sync unread badge immediately
    window.dispatchEvent(new CustomEvent('refresh-notifications'));

    const saveBtn = document.getElementById('save-changes-btn');
    saveBtn?.addEventListener('click', async () => {
      const status = (document.getElementById('update-status')).value;
      const assignedRoleId = (document.getElementById('update-role')).value;
      const adminNotes = (document.getElementById('update-notes')).value;

      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';

      try {
        const res = await fetch(`/api/admin/candidates/${candidateId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status, assignedRoleId, adminNotes })
        });

        if (res.ok) {
          alert('Candidate details updated successfully.');
          window.location.reload();
        } else {
          alert('Failed to update candidate.');
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Changes';
        }
      } catch {
        alert('Network error saving changes.');
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Changes';
      }
    });
  </script>

</AdminLayout>
