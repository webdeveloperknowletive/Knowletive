---
// ============================================================
// /admin/leads
// Leads & Inquiries Management with Filters & Status Updates
// ============================================================

import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../lib/db';

const url = Astro.url;
const leadTypeFilter = url.searchParams.get('leadType') || '';
const statusFilter = url.searchParams.get('status') || '';
const search = url.searchParams.get('search') || '';

const leads = await db.getLeads({ leadType: leadTypeFilter, status: statusFilter, search });
---

<AdminLayout title="Leads & Inquiries" activeNav="leads">
  
  <!-- Filter & Export Controls -->
  <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    
    <form method="GET" class="flex flex-wrap items-center gap-3 flex-1">
      <div class="relative min-w-[220px] flex-1">
        <input 
          type="text" 
          name="search" 
          value={search} 
          placeholder="Search name, email, phone..." 
          class="w-full px-3.5 py-2 pl-9 text-xs rounded-xl border border-gray-200 focus:border-[#0878E8] focus:ring-1 focus:ring-[#0878E8] outline-none transition-all"
        />
        <svg class="w-4 h-4 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </div>

      <!-- Lead Type Filter -->
      <select name="leadType" class="px-3 py-2 text-xs rounded-xl border border-gray-200 focus:border-[#0878E8] outline-none bg-white text-[#0B1F3A]">
        <option value="">All Lead Types</option>
        <option value="Contact" selected={leadTypeFilter === 'Contact'}>Contact Form</option>
        <option value="Course" selected={leadTypeFilter === 'Course'}>Course Inquiry</option>
        <option value="Counseling" selected={leadTypeFilter === 'Counseling'}>Counseling</option>
        <option value="Admission" selected={leadTypeFilter === 'Admission'}>Admission</option>
        <option value="Overseas Education" selected={leadTypeFilter === 'Overseas Education'}>Overseas Education</option>
        <option value="Job" selected={leadTypeFilter === 'Job'}>Job</option>
        <option value="Internship" selected={leadTypeFilter === 'Internship'}>Internship</option>
        <option value="eBook" selected={leadTypeFilter === 'eBook'}>Free eBook</option>
      </select>

      <!-- Status Filter -->
      <select name="status" class="px-3 py-2 text-xs rounded-xl border border-gray-200 focus:border-[#0878E8] outline-none bg-white text-[#0B1F3A]">
        <option value="">All Statuses</option>
        <option value="New" selected={statusFilter === 'New'}>New</option>
        <option value="Contacted" selected={statusFilter === 'Contacted'}>Contacted</option>
        <option value="Follow-up" selected={statusFilter === 'Follow-up'}>Follow-up</option>
        <option value="Interested" selected={statusFilter === 'Interested'}>Interested</option>
        <option value="Converted" selected={statusFilter === 'Converted'}>Converted</option>
        <option value="Not Interested" selected={statusFilter === 'Not Interested'}>Not Interested</option>
        <option value="Closed" selected={statusFilter === 'Closed'}>Closed</option>
      </select>

      <button type="submit" class="px-4 py-2 bg-[#0878E8] text-white text-xs font-bold rounded-xl hover:bg-[#0764c2] transition-colors cursor-pointer">
        Apply Filters
      </button>

      {(leadTypeFilter || statusFilter || search) && (
        <a href="/admin/leads" class="px-3 py-2 border border-gray-200 text-[#64748B] text-xs font-semibold rounded-xl hover:bg-gray-50 transition-colors">
          Clear
        </a>
      )}
    </form>

    <!-- Export Buttons & Bulk Destructive Actions -->
    <div class="flex flex-wrap items-center gap-2">
      <a 
        href={`/api/exports/leads?format=xlsx${leadTypeFilter ? `&leadType=${leadTypeFilter}` : ''}${statusFilter ? `&status=${statusFilter}` : ''}`} 
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-manrope font-bold text-xs shadow-sm transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        Export Leads (Excel)
      </a>
      <a 
        href={`/api/exports/leads?format=csv${leadTypeFilter ? `&leadType=${leadTypeFilter}` : ''}${statusFilter ? `&status=${statusFilter}` : ''}`} 
        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl border border-gray-200 hover:bg-gray-50 text-[#0B1F3A] font-semibold text-xs transition-colors"
      >
        CSV
      </a>

    </div>

  </div>

  <!-- Leads Table -->
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
    <div class="p-4 px-6 border-b border-gray-100 bg-[#F7F9FC] flex items-center justify-between">
      <span class="text-xs font-bold text-[#64748B] uppercase tracking-wider">
        Showing {leads.length} Leads & Inquiries
      </span>
      <span class="text-xs text-gray-400">Captured from all website inquiry endpoints</span>
    </div>

    {leads.length === 0 ? (
      <div class="p-16 text-center text-[#64748B] text-sm">
        <svg class="w-12 h-12 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        <p class="font-bold text-[#0B1F3A]">No leads recorded yet.</p>
        <p class="text-xs text-gray-400 mt-1">Submissions from contact, courses, or eBook forms will automatically appear here.</p>
      </div>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm whitespace-nowrap">
          <thead class="bg-[#F7F9FC] text-[#64748B] text-[11px] font-bold uppercase tracking-wider border-b border-gray-100">
            <tr>
              <th class="py-3 px-6">Name</th>
              <th class="py-3 px-6">Lead Type</th>
              <th class="py-3 px-6">Contact</th>
              <th class="py-3 px-6">Interest / Opportunity</th>
              <th class="py-3 px-6">Education & College</th>
              <th class="py-3 px-6">Message / Note</th>
              <th class="py-3 px-6">Status</th>
              <th class="py-3 px-6">Date</th>
              <th class="py-3 px-6 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {leads.map((l) => (
              <tr class="hover:bg-gray-50/60 transition-colors">
                <td class="py-4 px-6 font-bold text-[#0B1F3A]">
                  <div class="flex items-center gap-2">
                    <button 
                      type="button" 
                      class="view-lead-btn hover:text-[#0878E8] text-left transition-colors font-bold cursor-pointer"
                      data-lead-id={l.id}
                      data-lead-name={`${l.first_name} ${l.last_name}`}
                      data-lead-type={l.lead_type}
                      data-lead-source={l.source || 'Website'}
                      data-lead-phone={l.phone}
                      data-lead-email={l.email || ''}
                      data-lead-interest={l.opportunity_type || l.course_interest || l.service_interest || 'General'}
                      data-lead-role={l.preferred_role || l.career_goal || ''}
                      data-lead-education={l.degree || l.education || ''}
                      data-lead-college={l.college || ''}
                      data-lead-message={l.message || ''}
                      data-lead-status={l.status}
                      data-lead-date={new Date(l.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })}
                      data-lead-unread={l.is_read === false ? 'true' : 'false'}
                    >
                      {l.first_name} {l.last_name}
                    </button>
                    {l.is_read === false && (
                      <span id={`lead-new-badge-${l.id}`} class="lead-unread-indicator shrink-0 inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-extrabold uppercase bg-[#F47A16] text-white shadow-sm tracking-wider">
                        NEW
                      </span>
                    )}
                  </div>
                </td>
                <td class="py-4 px-6">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-blue-50 text-[#0878E8] border border-blue-100">
                    {l.lead_type}
                  </span>
                  <span class="text-[11px] text-gray-500 block mt-1 font-medium">
                    {l.source || 'Website'}
                  </span>
                </td>
                <td class="py-4 px-6 text-xs">
                  <a href={`tel:${l.phone}`} class="font-medium text-[#0B1F3A] hover:underline block">{l.phone}</a>
                  {l.email ? (
                    <a href={`mailto:${l.email}`} class="text-gray-500 hover:text-[#0878E8] block">{l.email}</a>
                  ) : (
                    <span class="text-gray-400 italic block">No email provided</span>
                  )}
                </td>
                <td class="py-4 px-6 text-xs text-[#64748B]">
                  <span class="font-medium text-[#0B1F3A] block truncate max-w-xs">{l.opportunity_type || l.course_interest || l.service_interest || 'General'}</span>
                  <span class="text-gray-400 block truncate max-w-xs">{l.preferred_role || l.career_goal || ''}</span>
                </td>
                <td class="py-4 px-6 text-xs text-[#64748B]">
                  <span class="font-medium text-[#0B1F3A] block">{l.degree || l.education || 'N/A'}</span>
                  <span class="text-gray-400 block truncate max-w-xs">{l.college || ''}</span>
                </td>
                <td class="py-4 px-6 text-xs text-[#64748B] max-w-xs truncate" title={l.message || ''}>
                  {l.message || '—'}
                </td>
                <td class="py-4 px-6">
                  <select 
                    data-lead-id={l.id} 
                    class="lead-status-select text-xs font-semibold px-2 py-1 rounded-lg border border-gray-200 bg-white outline-none cursor-pointer focus:border-[#0878E8]"
                  >
                    <option value="New" selected={l.status === 'New'}>New</option>
                    <option value="Contacted" selected={l.status === 'Contacted'}>Contacted</option>
                    <option value="Follow-up" selected={l.status === 'Follow-up'}>Follow-up</option>
                    <option value="Interested" selected={l.status === 'Interested'}>Interested</option>
                    <option value="Converted" selected={l.status === 'Converted'}>Converted</option>
                    <option value="Not Interested" selected={l.status === 'Not Interested'}>Not Interested</option>
                    <option value="Closed" selected={l.status === 'Closed'}>Closed</option>
                  </select>
                </td>
                <td class="py-4 px-6 text-xs text-[#64748B]">
                  {new Date(l.created_at).toLocaleDateString('en-IN')}
                </td>
                <td class="py-4 px-6 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <button 
                      type="button" 
                      class="view-lead-btn p-1.5 rounded-lg border border-gray-200 text-[#0878E8] hover:bg-blue-50 hover:border-blue-200 transition-colors cursor-pointer" 
                      title="View Lead Details"
                      data-lead-id={l.id}
                      data-lead-name={`${l.first_name} ${l.last_name}`}
                      data-lead-type={l.lead_type}
                      data-lead-source={l.source || 'Website'}
                      data-lead-phone={l.phone}
                      data-lead-email={l.email || ''}
                      data-lead-interest={l.opportunity_type || l.course_interest || l.service_interest || 'General'}
                      data-lead-role={l.preferred_role || l.career_goal || ''}
                      data-lead-education={l.degree || l.education || ''}
                      data-lead-college={l.college || ''}
                      data-lead-message={l.message || ''}
                      data-lead-status={l.status}
                      data-lead-date={new Date(l.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })}
                      data-lead-unread={l.is_read === false ? 'true' : 'false'}
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    </button>
                    <button 
                      data-delete-lead-id={l.id} 
                      class="delete-lead-btn p-1.5 rounded-lg border border-gray-200 text-red-500 hover:bg-red-50 hover:border-red-200 transition-colors" 
                      title="Delete Lead"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

  </div>

  <!-- MODAL: VIEW LEAD DETAILS -->
  <div id="modal-lead-details" class="fixed inset-0 z-50 bg-[#0B1F3A]/70 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 md:p-8 shadow-2xl border border-gray-100 transform transition-all max-h-[90vh] overflow-y-auto">
      
      <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-[#0878E8] block" id="modal-lead-type-badge">Lead Details</span>
          <h3 class="text-xl font-bold font-manrope text-[#0B1F3A]" id="modal-lead-name">Lead Name</h3>
        </div>
        <button type="button" id="btn-close-lead-modal" class="p-2 text-gray-400 hover:text-gray-600 rounded-lg hover:bg-gray-100 transition-colors cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="space-y-4 text-xs">
        <div class="grid grid-cols-2 gap-3 bg-gray-50 p-4 rounded-xl">
          <div>
            <span class="text-gray-500 font-medium block">Phone</span>
            <a id="modal-lead-phone-link" href="#" class="font-bold text-[#0B1F3A] hover:underline text-sm block mt-0.5"></a>
          </div>
          <div>
            <span class="text-gray-500 font-medium block">Email</span>
            <a id="modal-lead-email-link" href="#" class="font-bold text-[#0878E8] hover:underline text-sm block mt-0.5"></a>
          </div>
          <div>
            <span class="text-gray-500 font-medium block">Lead Type / Source</span>
            <span id="modal-lead-source" class="font-bold text-[#0B1F3A] block mt-0.5"></span>
          </div>
          <div>
            <span class="text-gray-500 font-medium block">Date Received</span>
            <span id="modal-lead-date" class="font-semibold text-gray-700 block mt-0.5"></span>
          </div>
        </div>

        <div class="border border-gray-100 rounded-xl p-4 space-y-3">
          <div>
            <span class="text-gray-500 font-medium block">Interest / Opportunity</span>
            <span id="modal-lead-interest" class="font-bold text-[#0B1F3A] text-sm block mt-0.5"></span>
          </div>
          <div>
            <span class="text-gray-500 font-medium block">Preferred Role / Career Goal</span>
            <span id="modal-lead-role" class="font-semibold text-gray-700 block mt-0.5"></span>
          </div>
          <div>
            <span class="text-gray-500 font-medium block">Education & College</span>
            <span id="modal-lead-education" class="font-semibold text-gray-700 block mt-0.5"></span>
          </div>
        </div>

        <div class="border border-gray-100 rounded-xl p-4">
          <span class="text-gray-500 font-medium block mb-1">Message / Note</span>
          <p id="modal-lead-message" class="text-gray-700 bg-gray-50 p-3 rounded-lg leading-relaxed whitespace-pre-wrap font-mono text-[11px]"></p>
        </div>

        <div class="flex items-center justify-between pt-2">
          <div class="flex items-center gap-2">
            <span class="text-gray-500 font-medium">Status:</span>
            <span id="modal-lead-status-pill" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700"></span>
          </div>
          <button type="button" id="btn-done-lead-modal" class="px-5 py-2.5 bg-[#0878E8] text-white font-bold rounded-xl hover:bg-[#0764c2] transition-colors cursor-pointer">
            Close
          </button>
        </div>
      </div>

    </div>
  </div>

  <script>
    // ============================================================
    // VIEW LEAD DETAILS & MARK AS READ
    // ============================================================
    const modalLeadDetails = document.getElementById('modal-lead-details');
    const btnCloseLeadModal = document.getElementById('btn-close-lead-modal');
    const btnDoneLeadModal = document.getElementById('btn-done-lead-modal');

    function closeLeadModal() {
      modalLeadDetails?.classList.add('hidden');
      modalLeadDetails?.classList.remove('flex');
    }

    btnCloseLeadModal?.addEventListener('click', closeLeadModal);
    btnDoneLeadModal?.addEventListener('click', closeLeadModal);

    document.querySelectorAll('.view-lead-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLElement;
        const leadId = target.dataset.leadId;
        const name = target.dataset.leadName || 'Lead';
        const type = target.dataset.leadType || 'Inquiry';
        const source = target.dataset.leadSource || 'Website';
        const phone = target.dataset.leadPhone || '';
        const email = target.dataset.leadEmail || '';
        const interest = target.dataset.leadInterest || 'General';
        const role = target.dataset.leadRole || 'Not specified';
        const education = target.dataset.leadEducation || '';
        const college = target.dataset.leadCollege || '';
        const message = target.dataset.leadMessage || 'No message attached.';
        const status = target.dataset.leadStatus || 'New';
        const date = target.dataset.leadDate || '';
        const isUnread = target.dataset.leadUnread === 'true';

        // Populate modal
        const elName = document.getElementById('modal-lead-name');
        const elType = document.getElementById('modal-lead-type-badge');
        const elPhone = document.getElementById('modal-lead-phone-link') as HTMLAnchorElement | null;
        const elEmail = document.getElementById('modal-lead-email-link') as HTMLAnchorElement | null;
        const elSource = document.getElementById('modal-lead-source');
        const elDate = document.getElementById('modal-lead-date');
        const elInterest = document.getElementById('modal-lead-interest');
        const elRole = document.getElementById('modal-lead-role');
        const elEdu = document.getElementById('modal-lead-education');
        const elMsg = document.getElementById('modal-lead-message');
        const elStatus = document.getElementById('modal-lead-status-pill');

        if (elName) elName.textContent = name;
        if (elType) elType.textContent = `${type} Inquiry Details`;
        if (elPhone) {
          elPhone.textContent = phone || 'None';
          elPhone.href = phone ? `tel:${phone}` : '#';
        }
        if (elEmail) {
          elEmail.textContent = email || 'None';
          elEmail.href = email ? `mailto:${email}` : '#';
        }
        if (elSource) elSource.textContent = `${type} (${source})`;
        if (elDate) elDate.textContent = date;
        if (elInterest) elInterest.textContent = interest;
        if (elRole) elRole.textContent = role;
        if (elEdu) elEdu.textContent = `${education || 'N/A'}${college ? ` · ${college}` : ''}`;
        if (elMsg) elMsg.textContent = message;
        if (elStatus) elStatus.textContent = status;

        modalLeadDetails?.classList.remove('hidden');
        modalLeadDetails?.classList.add('flex');

        // Mark as read in DB if unread
        if (isUnread && leadId) {
          try {
            const res = await fetch(`/api/admin/leads/${leadId}/read`, {
              method: 'PATCH'
            });
            if (res.ok) {
              // Remove NEW badge from table row
              const badge = document.getElementById(`lead-new-badge-${leadId}`);
              if (badge) badge.remove();

              // Update data-lead-unread on all buttons for this lead
              document.querySelectorAll(`[data-lead-id="${leadId}"]`).forEach(el => {
                (el as HTMLElement).dataset.leadUnread = 'false';
              });

              // Dispatch event to decrement sidebar badge
              window.dispatchEvent(new CustomEvent('refresh-notifications'));
            }
          } catch (err) {
            console.error('[Mark Lead As Read Error]:', err);
          }
        }
      });
    });

    document.querySelectorAll('.lead-status-select').forEach(el => {
      el.addEventListener('change', async (e) => {
        const target = e.target as HTMLSelectElement;
        const leadId = target.dataset.leadId;
        const status = target.value;

        try {
          const res = await fetch(`/api/admin/leads/${leadId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status })
          });
          if (!res.ok) alert('Failed to update lead status.');
        } catch {
          alert('Network error updating lead status.');
        }
      });
    });

    document.querySelectorAll('.delete-lead-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = (e.currentTarget as HTMLElement);
        const leadId = target.dataset.deleteLeadId;
        if (!confirm('Are you sure you want to delete this lead inquiry?')) return;

        try {
          const res = await fetch(`/api/admin/leads/${leadId}`, { method: 'DELETE' });
          if (res.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete lead.');
          }
        } catch {
          alert('Error deleting lead.');
        }
      });
    });

  </script>

</AdminLayout>
