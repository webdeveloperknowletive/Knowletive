---
// ============================================================
// /admin/exports
// Multi-Sheet Excel & CSV Export Control Center
// ============================================================

import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../lib/db';

const candidates = await db.getCandidates();
const leads = await db.getLeads();
const roles = await db.getJobRoles();
---

<AdminLayout title="Exports & Reports" activeNav="exports">
  
  <div class="mb-8">
    <h2 class="text-xl font-bold font-manrope text-[#0B1F3A]">Data Export Center</h2>
    <p class="text-xs text-[#64748B]">Download full candidate databases, matched keyword reports, and marketing leads in Excel (.xlsx) and CSV formats.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
    
    <!-- Candidate Resumes Export Card -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 md:p-8 flex flex-col justify-between">
      <div>
        <div class="w-12 h-12 rounded-xl bg-blue-50 text-[#0878E8] flex items-center justify-center mb-4">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        </div>

        <h3 class="text-lg font-bold font-manrope text-[#0B1F3A] mb-1">Resume Candidates Database</h3>
        <p class="text-xs text-[#64748B] mb-4">
          Includes candidate contact info, educational qualification, college, years of experience, matched role, keyword match score, extracted skills, and status.
        </p>

        <div class="p-4 rounded-xl bg-slate-50 border border-gray-100 text-xs space-y-2 mb-6 text-[#64748B]">
          <div class="flex items-center justify-between">
            <span>Total Available Candidates:</span>
            <strong class="text-[#0B1F3A]">{candidates.length}</strong>
          </div>
          <div class="flex items-center justify-between">
            <span>Generated File Format:</span>
            <span class="font-mono text-[11px] text-[#0878E8]">Resume_Candidates.xlsx</span>
          </div>
          <div class="flex items-center justify-between">
            <span>Workbook Sheets Included:</span>
            <span>All Candidates + Individual Role Sheets</span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <a 
          href="/api/exports/candidates?format=xlsx" 
          class="flex-1 py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-manrope font-bold text-xs shadow-md shadow-emerald-600/20 text-center flex items-center justify-center gap-2 transition-all cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          Download Excel Workbook (.xlsx)
        </a>

        <a 
          href="/api/exports/candidates?format=csv" 
          class="py-3 px-4 rounded-xl border border-gray-200 hover:bg-gray-50 text-[#0B1F3A] font-bold text-xs transition-colors"
        >
          CSV
        </a>
      </div>
    </div>

    <!-- Leads Export Card -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 md:p-8 flex flex-col justify-between">
      <div>
        <div class="w-12 h-12 rounded-xl bg-orange-50 text-[#F47A16] flex items-center justify-center mb-4">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        </div>

        <h3 class="text-lg font-bold font-manrope text-[#0B1F3A] mb-1">Leads & Inquiries Database</h3>
        <p class="text-xs text-[#64748B] mb-4">
          Contains inquiries from all website forms: Contact, Course inquiries, Free Career Guide eBook leads, Counseling, and Admission requests.
        </p>

        <div class="p-4 rounded-xl bg-slate-50 border border-gray-100 text-xs space-y-2 mb-6 text-[#64748B]">
          <div class="flex items-center justify-between">
            <span>Total Available Leads:</span>
            <strong class="text-[#0B1F3A]">{leads.length}</strong>
          </div>
          <div class="flex items-center justify-between">
            <span>Generated File Format:</span>
            <span class="font-mono text-[11px] text-[#F47A16]">Knowletive_Leads.xlsx</span>
          </div>
          <div class="flex items-center justify-between">
            <span>Workbook Sheets Included:</span>
            <span>All Leads, Course Leads, Counseling, Admission, eBook...</span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <a 
          href="/api/exports/leads?format=xlsx" 
          class="flex-1 py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-manrope font-bold text-xs shadow-md shadow-emerald-600/20 text-center flex items-center justify-center gap-2 transition-all cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          Download Excel Workbook (.xlsx)
        </a>

        <a 
          href="/api/exports/leads?format=csv" 
          class="py-3 px-4 rounded-xl border border-gray-200 hover:bg-gray-50 text-[#0B1F3A] font-bold text-xs transition-colors"
        >
          CSV
        </a>
      </div>
    </div>

  </div>

</AdminLayout>
