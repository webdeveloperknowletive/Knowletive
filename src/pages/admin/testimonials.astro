---
// ============================================================
// /admin/testimonials
// Manage Student Story Reels, Videos, Posters & Dynamic Publishing
// ============================================================

import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../lib/db';

const testimonials = await db.getTestimonials(false);
---

<AdminLayout title="Video Testimonials Management" activeNav="testimonials">
  
  <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <h2 class="text-lg font-bold font-manrope text-[#0B1F3A]">Student Stories & Video Testimonials</h2>
      <p class="text-xs text-[#64748B]">All published stories automatically update on the public website homepage carousel in real time.</p>
    </div>
    
    <button 
      id="open-add-testi-modal"
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#0878E8] hover:bg-[#0764c2] text-white text-xs font-bold transition-all shadow-sm cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
      Add Story Reel
    </button>
  </div>

  <!-- Testimonials Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {testimonials.map(item => (
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden flex flex-col justify-between group" data-story-card-id={item.id}>
        <div>
          <!-- Thumbnail / Video Preview -->
          <div class="relative aspect-[9/16] bg-slate-900 overflow-hidden">
            <img 
              id={`card-thumb-${item.id}`}
              src={(item.poster_url || item.thumbnail_url || '/images/hero-students.jpg') + (item.updated_at ? `?v=${encodeURIComponent(item.updated_at)}` : '')} 
              alt={item.student_name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/30 pointer-events-none"></div>

            <div class="absolute top-3 left-3">
              <span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ${
                item.is_published ? 'bg-green-500/90 text-white' : 'bg-gray-800/90 text-gray-300'
              }`}>
                {item.is_published ? 'Live on Site' : 'Draft (Hidden)'}
              </span>
            </div>

            <div class="absolute top-3 right-3">
              <span class="text-[10px] font-bold bg-white/20 text-white px-2 py-0.5 rounded backdrop-blur-sm">
                Order #{item.display_order}
              </span>
            </div>

            <!-- Per-Card Independent Thumbnail Upload Trigger -->
            <div class="absolute bottom-16 right-3 z-10">
              <label 
                for={`card-thumb-input-${item.id}`}
                class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-black/70 hover:bg-[#0878E8] text-white text-[11px] font-semibold backdrop-blur-sm shadow transition-all cursor-pointer hover:scale-105 active:scale-95 border border-white/20"
                title={`Change thumbnail for ${item.student_name} only`}
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <span id={`thumb-btn-text-${item.id}`}>Change Thumbnail</span>
              </label>
              <input 
                type="file" 
                id={`card-thumb-input-${item.id}`}
                class="hidden single-thumb-input"
                data-story-id={item.id}
                data-story-name={item.student_name}
                accept="image/jpeg,image/png,image/webp"
              />
            </div>

            <div class="absolute bottom-3 left-3 right-3 text-white">
              <h3 class="font-bold text-sm leading-tight drop-shadow">{item.student_name}</h3>
              <p class="text-xs text-blue-200 drop-shadow">{item.program}</p>
            </div>
          </div>

          <div class="p-4">
            <p class="text-xs text-[#64748B] line-clamp-2 italic">"{item.caption || 'No caption provided.'}"</p>
          </div>
        </div>

        <div class="p-4 pt-0 border-t border-gray-50 flex items-center justify-between gap-2 mt-2">
          <button 
            data-toggle-testi-id={item.id} 
            data-current-published={item.is_published ? 'true' : 'false'}
            class="toggle-testi-btn text-xs font-bold text-[#0878E8] hover:underline cursor-pointer"
          >
            {item.is_published ? 'Unpublish' : 'Publish'}
          </button>

          <div class="flex items-center gap-1.5">
            <button 
              class="edit-testi-btn p-1.5 text-gray-500 hover:text-[#0878E8] hover:bg-blue-50 rounded-lg transition-colors cursor-pointer"
              title="Edit Story"
              data-id={item.id}
              data-name={item.student_name}
              data-program={item.program}
              data-caption={item.caption || ''}
              data-video={item.video_url}
              data-poster={item.poster_url || item.thumbnail_url || ''}
              data-order={item.display_order}
              data-published={item.is_published ? 'true' : 'false'}
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            </button>

            <button 
              data-delete-testi-id={item.id}
              class="delete-testi-btn p-1.5 text-red-500 hover:bg-red-50 rounded-lg transition-colors cursor-pointer"
              title="Delete Testimonial"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </button>
          </div>
        </div>
      </div>
    ))}

    {testimonials.length === 0 && (
      <div class="col-span-full p-16 text-center text-sm text-gray-400 bg-white rounded-2xl border border-gray-100">
        No story reels added yet. Click "Add Story Reel" above to upload your first student video testimonial.
      </div>
    )}
  </div>

  <!-- Add Testimonial Modal -->
  <div id="add-testi-modal" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="bg-white rounded-3xl p-6 md:p-8 w-full max-w-lg shadow-2xl max-h-[90vh] overflow-y-auto relative">
      <h3 class="text-lg font-bold font-manrope text-[#0B1F3A] mb-1">Add Story Video / Testimonial</h3>
      <p class="text-xs text-gray-500 mb-4">Upload student reels and video feedback that appear on the homepage carousel.</p>
      
      <div id="add-error-box" class="hidden mb-4 p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs font-medium"></div>

      <form id="new-testi-form" class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Student Name *</label>
            <input type="text" id="testi-name" required placeholder="e.g. Pooja Deshmukh" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Program / Course *</label>
            <input type="text" id="testi-program" required placeholder="e.g. Data Analyst Program" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Video File (MP4, portrait 9:16 recommended)</label>
          <input type="file" id="testi-video-file" accept="video/mp4,video/webm,video/quicktime" class="w-full text-xs text-gray-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-[#0878E8] hover:file:bg-blue-100" />
          <p class="text-[11px] text-gray-400 mt-1">Or provide video URL below if already hosted.</p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Video URL (e.g. /videos/testimonials/...)</label>
          <input type="text" id="testi-video-url" placeholder="/videos/testimonials/session-review-final.mp4" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Poster Thumbnail Image (Guarantees visible card without black screen)</label>
          <input type="file" id="testi-poster-file" accept="image/jpeg,image/png,image/webp" class="w-full text-xs text-gray-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-[#0878E8] hover:file:bg-blue-100" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Poster URL (fallback if file not chosen)</label>
            <input type="text" id="testi-poster-url" placeholder="/videos/testimonials/posters/priya-sharma.jpg" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Display Order</label>
            <input type="number" id="testi-order" value={testimonials.length + 1} class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Caption / Testimonial Quote</label>
          <textarea id="testi-caption" rows="2" placeholder="Secured placement at MNC within 3 months..." class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]"></textarea>
        </div>

        <div class="flex items-center gap-2">
          <input type="checkbox" id="testi-published" checked class="w-4 h-4 text-[#0878E8] rounded border-gray-300" />
          <label for="testi-published" class="text-xs font-semibold text-[#0B1F3A]">Publish immediately (Live on public website)</label>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2 border-t border-gray-100">
          <button type="button" id="close-add-testi-modal" class="px-4 py-2 border border-gray-200 text-xs font-semibold rounded-xl hover:bg-gray-50">Cancel</button>
          <button type="submit" id="save-testi-btn" class="px-5 py-2 bg-[#0878E8] hover:bg-[#0764c2] text-white text-xs font-bold rounded-xl shadow-sm transition-all">Save & Publish</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Testimonial Modal with Isolated Per-Item State -->
  <div id="edit-testi-modal" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="bg-white rounded-3xl p-6 md:p-8 w-full max-w-lg shadow-2xl max-h-[90vh] overflow-y-auto relative">
      <h3 class="text-lg font-bold font-manrope text-[#0B1F3A] mb-1">Edit Story Video / Testimonial</h3>
      <p class="text-xs text-gray-500 mb-4">Modify student details, replace video or poster, change order or visibility.</p>
      
      <div id="edit-error-box" class="hidden mb-4 p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs font-medium"></div>

      <form id="edit-testi-form" class="space-y-4">
        <input type="hidden" id="edit-testi-id" />

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Student Name *</label>
            <input type="text" id="edit-testi-name" required class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Program / Course *</label>
            <input type="text" id="edit-testi-program" required class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Replace Video File (Optional)</label>
          <input type="file" id="edit-testi-video-file" accept="video/mp4,video/webm,video/quicktime" class="w-full text-xs text-gray-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-[#0878E8] hover:file:bg-blue-100" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Current Video URL</label>
          <input type="text" id="edit-testi-video-url" required class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
        </div>

        <!-- Thumbnail Preview Box for Selected Story -->
        <div class="p-3 bg-gray-50 border border-gray-200 rounded-2xl flex items-center gap-3">
          <div class="w-14 h-20 bg-slate-900 rounded-xl overflow-hidden shrink-0 border border-gray-200 shadow-sm relative">
            <img id="edit-modal-thumb-preview" src="/images/hero-students.jpg" alt="Preview" class="w-full h-full object-cover" />
          </div>
          <div class="flex-1 min-w-0">
            <span class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-0.5">Active Thumbnail</span>
            <p id="edit-modal-thumb-status" class="text-xs text-gray-700 truncate font-medium">Using current poster</p>
            <button type="button" id="edit-modal-clear-file" class="hidden mt-1 text-[11px] text-red-600 hover:underline font-semibold cursor-pointer">
              ✕ Cancel New Image Selection
            </button>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Replace Poster Image (Optional - Only for this story)</label>
          <input type="file" id="edit-testi-poster-file" accept="image/jpeg,image/png,image/webp" class="w-full text-xs text-gray-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-[#0878E8] hover:file:bg-blue-100" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Current Poster URL</label>
            <input type="text" id="edit-testi-poster-url" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Display Order</label>
            <input type="number" id="edit-testi-order" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#0B1F3A] mb-1">Caption / Testimonial Quote</label>
          <textarea id="edit-testi-caption" rows="2" class="w-full px-3 py-2 text-xs rounded-xl border border-gray-200 outline-none focus:border-[#0878E8]"></textarea>
        </div>

        <div class="flex items-center gap-2">
          <input type="checkbox" id="edit-testi-published" class="w-4 h-4 text-[#0878E8] rounded border-gray-300" />
          <label for="edit-testi-published" class="text-xs font-semibold text-[#0B1F3A]">Live on public website</label>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2 border-t border-gray-100">
          <button type="button" id="close-edit-testi-modal" class="px-4 py-2 border border-gray-200 text-xs font-semibold rounded-xl hover:bg-gray-50">Cancel</button>
          <button type="submit" id="update-testi-btn" class="px-5 py-2 bg-[#0878E8] hover:bg-[#0764c2] text-white text-xs font-bold rounded-xl shadow-sm transition-all">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const addModal = document.getElementById('add-testi-modal');
    const editModal = document.getElementById('edit-testi-modal');

    const openAddBtn = document.getElementById('open-add-testi-modal') || document.getElementById('open-add-testimonial-modal');
    
    // Function to safely clear file inputs to prevent stale reuse
    function resetEditFileInputs() {
      const pFile = document.getElementById('edit-testi-poster-file') as HTMLInputElement | null;
      if (pFile) pFile.value = '';
      const vFile = document.getElementById('edit-testi-video-file') as HTMLInputElement | null;
      if (vFile) vFile.value = '';
      const clearBtn = document.getElementById('edit-modal-clear-file');
      if (clearBtn) clearBtn.classList.add('hidden');
    }

    function resetAddFileInputs() {
      const pFile = document.getElementById('testi-poster-file') as HTMLInputElement | null;
      if (pFile) pFile.value = '';
      const vFile = document.getElementById('testi-video-file') as HTMLInputElement | null;
      if (vFile) vFile.value = '';
    }

    openAddBtn?.addEventListener('click', () => {
      resetAddFileInputs();
      document.getElementById('add-error-box')?.classList.add('hidden');
      addModal?.classList.remove('hidden');
    });

    document.getElementById('close-add-testi-modal')?.addEventListener('click', () => {
      resetAddFileInputs();
      addModal?.classList.add('hidden');
    });

    document.getElementById('close-edit-testi-modal')?.addEventListener('click', () => {
      resetEditFileInputs();
      editModal?.classList.add('hidden');
    });

    // -------------------------------------------------------------
    // 1. INDEPENDENT PER-CARD THUMBNAIL UPLOAD LISTENER
    // -------------------------------------------------------------
    document.querySelectorAll('.single-thumb-input').forEach(inputEl => {
      inputEl.addEventListener('change', async (e) => {
        const input = e.target as HTMLInputElement;
        const file = input.files?.[0];
        const storyId = input.dataset.storyId;
        const storyName = input.dataset.storyName || 'Story';
        if (!file || !storyId) return;

        const btnText = document.getElementById(`thumb-btn-text-${storyId}`);
        const cardImg = document.getElementById(`card-thumb-${storyId}`) as HTMLImageElement | null;
        if (btnText) btnText.textContent = 'Uploading...';

        const formData = new FormData();
        formData.append('id', storyId);
        formData.append('thumbnailFile', file);

        try {
          const res = await fetch('/api/admin/testimonials/thumbnail', {
            method: 'POST',
            body: formData
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok && data.success) {
            // Update preview immediately for ONLY this card with cache-busting
            if (cardImg) {
              cardImg.src = data.thumbnailUrl + '?v=' + Date.now();
            }
            if (btnText) btnText.textContent = 'Updated!';
            setTimeout(() => {
              if (btnText) btnText.textContent = 'Change Thumbnail';
            }, 2000);
          } else {
            alert(data.error || 'Failed to update thumbnail for this story.');
            if (btnText) btnText.textContent = 'Change Thumbnail';
          }
        } catch {
          alert('Network error updating thumbnail.');
          if (btnText) btnText.textContent = 'Change Thumbnail';
        } finally {
          input.value = ''; // Always reset file input immediately
        }
      });
    });

    // -------------------------------------------------------------
    // 2. SAVE NEW STORY
    // -------------------------------------------------------------
    document.getElementById('new-testi-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById('save-testi-btn') as HTMLButtonElement;
      const errorBox = document.getElementById('add-error-box') as HTMLElement;
      errorBox.classList.add('hidden');

      const studentName = (document.getElementById('testi-name') as HTMLInputElement).value.trim();
      const program = (document.getElementById('testi-program') as HTMLInputElement).value.trim();
      const videoUrl = (document.getElementById('testi-video-url') as HTMLInputElement).value.trim();
      const videoFile = (document.getElementById('testi-video-file') as HTMLInputElement).files?.[0];

      if (!videoFile && !videoUrl) {
        errorBox.textContent = 'Please choose an MP4 video file or enter a valid video URL.';
        errorBox.classList.remove('hidden');
        return;
      }

      saveBtn.disabled = true;
      saveBtn.textContent = 'Uploading Video & Saving...';

      const formData = new FormData();
      formData.append('studentName', studentName);
      formData.append('program', program);
      formData.append('caption', (document.getElementById('testi-caption') as HTMLTextAreaElement).value.trim());
      formData.append('videoUrl', videoUrl);
      formData.append('posterUrl', (document.getElementById('testi-poster-url') as HTMLInputElement).value.trim());
      formData.append('displayOrder', (document.getElementById('testi-order') as HTMLInputElement).value);
      formData.append('isPublished', (document.getElementById('testi-published') as HTMLInputElement).checked ? 'true' : 'false');

      if (videoFile) formData.append('videoFile', videoFile);
      const posterFile = (document.getElementById('testi-poster-file') as HTMLInputElement).files?.[0];
      if (posterFile) formData.append('posterFile', posterFile);

      try {
        const res = await fetch('/api/admin/testimonials', {
          method: 'POST',
          body: formData
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok && data.success) {
          resetAddFileInputs();
          window.location.reload();
        } else {
          errorBox.textContent = data.error || 'Failed to save testimonial.';
          errorBox.classList.remove('hidden');
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save & Publish';
        }
      } catch (err: any) {
        errorBox.textContent = 'Network error saving story. Please try again.';
        errorBox.classList.remove('hidden');
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save & Publish';
      }
    });

    // -------------------------------------------------------------
    // 3. OPEN EDIT MODAL (WITH STRICT PER-ITEM FILE INPUT RESET)
    // -------------------------------------------------------------
    let originalPosterForModal = '/images/hero-students.jpg';

    document.querySelectorAll('.edit-testi-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        // ALWAYS reset any file selection from previous modal opens
        resetEditFileInputs();

        const target = e.currentTarget as HTMLElement;
        const id = target.dataset.id || '';
        const name = target.dataset.name || '';
        const program = target.dataset.program || '';
        const caption = target.dataset.caption || '';
        const video = target.dataset.video || '';
        const poster = target.dataset.poster || '';
        const order = target.dataset.order || '1';
        const published = target.dataset.published === 'true';

        originalPosterForModal = poster || '/images/hero-students.jpg';

        (document.getElementById('edit-testi-id') as HTMLInputElement).value = id;
        (document.getElementById('edit-testi-name') as HTMLInputElement).value = name;
        (document.getElementById('edit-testi-program') as HTMLInputElement).value = program;
        (document.getElementById('edit-testi-caption') as HTMLTextAreaElement).value = caption;
        (document.getElementById('edit-testi-video-url') as HTMLInputElement).value = video;
        (document.getElementById('edit-testi-poster-url') as HTMLInputElement).value = poster;
        (document.getElementById('edit-testi-order') as HTMLInputElement).value = order;
        (document.getElementById('edit-testi-published') as HTMLInputElement).checked = published;

        // Set up isolated modal thumbnail preview
        const thumbPreview = document.getElementById('edit-modal-thumb-preview') as HTMLImageElement | null;
        if (thumbPreview) thumbPreview.src = originalPosterForModal;
        const thumbStatus = document.getElementById('edit-modal-thumb-status');
        if (thumbStatus) thumbStatus.textContent = 'Current thumbnail loaded for this story.';

        document.getElementById('edit-error-box')?.classList.add('hidden');
        editModal?.classList.remove('hidden');
      });
    });

    // Live preview when a new poster image is selected in the Edit Modal
    const editPosterFileInput = document.getElementById('edit-testi-poster-file') as HTMLInputElement | null;
    editPosterFileInput?.addEventListener('change', () => {
      const file = editPosterFileInput.files?.[0];
      const thumbPreview = document.getElementById('edit-modal-thumb-preview') as HTMLImageElement | null;
      const thumbStatus = document.getElementById('edit-modal-thumb-status');
      const clearBtn = document.getElementById('edit-modal-clear-file');

      if (file) {
        const objectUrl = URL.createObjectURL(file);
        if (thumbPreview) thumbPreview.src = objectUrl;
        if (thumbStatus) thumbStatus.textContent = `New file: ${file.name} (${(file.size / 1024).toFixed(0)} KB)`;
        if (clearBtn) clearBtn.classList.remove('hidden');
      } else {
        if (thumbPreview) thumbPreview.src = originalPosterForModal;
        if (thumbStatus) thumbStatus.textContent = 'Current thumbnail loaded for this story.';
        if (clearBtn) clearBtn.classList.add('hidden');
      }
    });

    // Button to cancel newly selected file in Edit Modal
    document.getElementById('edit-modal-clear-file')?.addEventListener('click', () => {
      if (editPosterFileInput) editPosterFileInput.value = '';
      const thumbPreview = document.getElementById('edit-modal-thumb-preview') as HTMLImageElement | null;
      if (thumbPreview) thumbPreview.src = originalPosterForModal;
      const thumbStatus = document.getElementById('edit-modal-thumb-status');
      if (thumbStatus) thumbStatus.textContent = 'Image replacement canceled.';
      document.getElementById('edit-modal-clear-file')?.classList.add('hidden');
    });

    // -------------------------------------------------------------
    // 4. SAVE EDITED STORY
    // -------------------------------------------------------------
    document.getElementById('edit-testi-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const updateBtn = document.getElementById('update-testi-btn') as HTMLButtonElement;
      const errorBox = document.getElementById('edit-error-box') as HTMLElement;
      errorBox.classList.add('hidden');

      updateBtn.disabled = true;
      updateBtn.textContent = 'Saving Changes...';

      const formData = new FormData();
      formData.append('id', (document.getElementById('edit-testi-id') as HTMLInputElement).value);
      formData.append('studentName', (document.getElementById('edit-testi-name') as HTMLInputElement).value.trim());
      formData.append('program', (document.getElementById('edit-testi-program') as HTMLInputElement).value.trim());
      formData.append('caption', (document.getElementById('edit-testi-caption') as HTMLTextAreaElement).value.trim());
      formData.append('videoUrl', (document.getElementById('edit-testi-video-url') as HTMLInputElement).value.trim());
      formData.append('posterUrl', (document.getElementById('edit-testi-poster-url') as HTMLInputElement).value.trim());
      formData.append('displayOrder', (document.getElementById('edit-testi-order') as HTMLInputElement).value);
      formData.append('isPublished', (document.getElementById('edit-testi-published') as HTMLInputElement).checked ? 'true' : 'false');

      const videoFile = (document.getElementById('edit-testi-video-file') as HTMLInputElement).files?.[0];
      if (videoFile) formData.append('videoFile', videoFile);

      const posterFile = (document.getElementById('edit-testi-poster-file') as HTMLInputElement).files?.[0];
      if (posterFile) formData.append('posterFile', posterFile);

      try {
        const res = await fetch('/api/admin/testimonials', {
          method: 'PATCH',
          body: formData
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok && data.success) {
          resetEditFileInputs();
          window.location.reload();
        } else {
          errorBox.textContent = data.error || 'Failed to update testimonial.';
          errorBox.classList.remove('hidden');
          updateBtn.disabled = false;
          updateBtn.textContent = 'Save Changes';
        }
      } catch {
        errorBox.textContent = 'Network error updating story.';
        errorBox.classList.remove('hidden');
        updateBtn.disabled = false;
        updateBtn.textContent = 'Save Changes';
      }
    });

    // -------------------------------------------------------------
    // 5. TOGGLE PUBLISH & DELETE ACTIONS
    // -------------------------------------------------------------
    document.querySelectorAll('.toggle-testi-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = (e.currentTarget as HTMLElement);
        const id = target.dataset.toggleTestiId;
        const currentPublished = target.dataset.currentPublished === 'true';

        try {
          const res = await fetch('/api/admin/testimonials', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, isPublished: !currentPublished })
          });
          if (res.ok) window.location.reload();
          else alert('Failed to update publication status.');
        } catch {
          alert('Network error updating status.');
        }
      });
    });

    document.querySelectorAll('.delete-testi-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.deleteTestiId;
        if (!confirm('Are you sure you want to delete this story reel?')) return;

        try {
          const res = await fetch(`/api/admin/testimonials?id=${id}`, { method: 'DELETE' });
          if (res.ok) window.location.reload();
          else alert('Failed to delete story reel.');
        } catch {
          alert('Network error deleting story.');
        }
      });
    });
  </script>

</AdminLayout>
