---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConsultationCTA from '../components/ConsultationCTA.astro';
---

<BaseLayout 
  title="Courses at Knowletive | IT, Data, Cloud, Banking & Digital Marketing" 
  description="Explore career-focused courses at Knowletive including Data Analysis, Data Science, MERN Stack, Java Full Stack, Cloud & DevOps, Banking and Digital Marketing."
>
  
  <!-- HERO SECTION -->
  <section class="relative page-header-spacing pb-16 md:pb-24 bg-[#0B1F3A] overflow-hidden text-white border-b border-white/10">
    <div class="absolute inset-0 z-0 opacity-20">
      <div class="absolute inset-0" style="background-image: radial-gradient(rgba(255,255,255,0.15) 1px, transparent 1px); background-size: 30px 30px; mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);"></div>
    </div>

    <div class="container-custom relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left Content -->
        <div>
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#0878E8]/20 border border-[#0878E8]/30 text-[#0878E8] font-bold text-xs tracking-widest uppercase mb-6 backdrop-blur-sm">
            Career-Focused Programs
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-manrope font-extrabold mb-6 leading-tight">
            Build Skills.<br/>
            <span class="text-gradient-orange">Create Projects.</span><br/>
            Launch Your Career.
          </h1>
          <p class="text-blue-100/90 text-lg md:text-xl max-w-xl mb-8 leading-relaxed">
            Industry-aligned training programs designed to help you learn practical skills, work on real projects and prepare for today's competitive job market.
          </p>
          <div class="flex flex-col sm:flex-row items-center gap-4">
            <a href="#featured-courses" class="btn-primary w-full sm:w-auto text-center">Explore Courses</a>
            <a href="/contact" class="btn-outline border-white/30 text-white hover:bg-white/10 w-full sm:w-auto text-center">Talk to a Career Advisor</a>
          </div>
        </div>
        
        <!-- Right Visual (Course Ecosystem) -->
        <div class="hidden lg:flex justify-end relative">
          <div class="relative w-full max-w-md h-[400px]">
            <!-- Center Core -->
            <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-32 h-32 rounded-full bg-gradient-to-br from-[#0878E8] to-[#072B6F] shadow-2xl flex items-center justify-center border-4 border-white/10 z-20">
              <span class="text-white font-manrope font-bold text-lg text-center leading-tight">Your<br/>Career</span>
            </div>
            
            <!-- Orbiting Cards -->
            <div class="absolute top-0 left-1/2 transform -translate-x-1/2 bg-white/10 backdrop-blur-md border border-white/20 px-6 py-3 rounded-2xl animate-[bounce_4s_ease-in-out_infinite]">
              <span class="text-[#F47A16] font-bold">Data</span>
            </div>
            
            <div class="absolute bottom-0 left-1/2 transform -translate-x-1/2 bg-white/10 backdrop-blur-md border border-white/20 px-6 py-3 rounded-2xl animate-[bounce_5s_ease-in-out_infinite]">
              <span class="text-[#10B981] font-bold">Code</span>
            </div>
            
            <div class="absolute top-1/2 left-0 transform -translate-y-1/2 bg-white/10 backdrop-blur-md border border-white/20 px-6 py-3 rounded-2xl animate-[bounce_6s_ease-in-out_infinite]">
              <span class="text-blue-300 font-bold">Cloud</span>
            </div>
            
            <div class="absolute top-1/4 right-0 transform translate-x-4 bg-white/10 backdrop-blur-md border border-white/20 px-6 py-3 rounded-2xl animate-[bounce_4.5s_ease-in-out_infinite]">
              <span class="text-purple-300 font-bold">Marketing</span>
            </div>
            
            <div class="absolute bottom-1/4 right-0 transform translate-x-4 bg-white/10 backdrop-blur-md border border-white/20 px-6 py-3 rounded-2xl animate-[bounce_5.5s_ease-in-out_infinite]">
              <span class="text-sky-300 font-bold">Business</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CATEGORY FILTER (Sticky) -->
  <div class="sticky top-[72px] z-30 bg-white border-b border-gray-200 shadow-sm overflow-x-auto scrollbar-hide">
    <div class="container-custom">
      <ul class="flex items-center gap-6 py-4 font-semibold text-sm text-[#64748B] min-w-max">
        <li><a href="#featured-courses" class="text-[#0878E8]">All Courses</a></li>
        <li><a href="#featured-courses" class="hover:text-[#0878E8]">Data</a></li>
        <li><a href="#featured-courses" class="hover:text-[#0878E8]">Development</a></li>
        <li><a href="#featured-courses" class="hover:text-[#0878E8]">Cloud</a></li>
        <li><a href="#featured-courses" class="hover:text-[#0878E8]">Finance</a></li>
        <li><a href="#featured-courses" class="hover:text-[#0878E8]">Marketing</a></li>
      </ul>
    </div>
  </div>

  <!-- FEATURED COURSES -->
  <section id="featured-courses" class="section-padding bg-gray-50">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-manrope font-bold text-[#0B1F3A] mb-4">Choose Your Career Path</h2>
        <p class="text-[#64748B] text-lg">Select a program based on the skills and career direction you want to build.</p>
      </div>

      <!-- Bento-style Course Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6">
        
        <!-- 1. Data Analysis -->
        <div class="bg-white rounded-[24px] p-4 md:p-5 border border-[#0878E8]/20 shadow-sm hover:shadow-lg transition-shadow md:col-span-2 lg:col-span-8 lg:row-span-2 h-full relative overflow-hidden group flex flex-col gap-6">
          <div class="absolute top-0 right-0 w-64 h-64 bg-[#0878E8]/5 rounded-bl-full -z-0 pointer-events-none"></div>
          
          <!-- Top: Large Image -->
          <div class="w-full aspect-[16/9] relative rounded-xl md:rounded-2xl overflow-hidden shadow-sm bg-[#F4F8FC] z-10">
            <img 
              src="/images/courses/data-analysis-clean.png" 
              alt="Data Analysis Course Banner" 
              width="2752"
              height="1536"
              class="w-full h-full object-contain object-center group-hover:scale-[1.02] transition-transform duration-500"
            />
          </div>

          <!-- Bottom: CTAs -->
          <div class="flex flex-col sm:flex-row items-center gap-6 sm:gap-8 z-10 px-2 md:px-4 pb-2 mt-auto">
            <a href="/courses/data-analysis" class="btn-primary py-3 px-8 w-full sm:w-auto text-center">Explore Course</a>
            <a href="/courses/data-analysis#inquiry-form" class="text-sm font-bold text-[#0B1F3A] hover:text-[#0878E8] transition-colors w-full sm:w-auto text-center flex items-center justify-center gap-1">Request Details <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></a>
          </div>
        </div>

        <!-- Right Column Group: Data Science & MERN Stack -->
        <div class="col-span-1 md:col-span-2 lg:col-span-4 lg:row-span-2 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-1 lg:grid-rows-2 gap-7 h-full">
          
          <!-- 2. Data Science -->
          <div class="w-full h-full bg-white rounded-[24px] p-4 md:p-5 border border-[#F47A16]/20 shadow-sm hover:shadow-lg transition-shadow relative overflow-hidden group flex flex-col gap-6">
            <div class="absolute top-0 right-0 w-24 h-24 bg-[#F47A16]/5 rounded-bl-full -z-0 pointer-events-none"></div>
            
            <!-- Top: Large Image -->
            <div class="w-full aspect-[16/9] relative rounded-xl md:rounded-[18px] overflow-hidden shadow-sm bg-[#FFF5F0] z-10">
              <img 
                src="/images/courses/data-science-aiml-clean.png" 
                alt="Data Science & AI/ML Course Banner" 
                loading="lazy"
                width="2752"
                height="1284"
                class="w-full h-full object-contain object-center group-hover:scale-[1.02] transition-transform duration-500 block"
              />
            </div>

            <!-- Bottom: CTAs -->
            <div class="flex items-center justify-between gap-4 z-10 px-2 mt-auto">
              <a href="/courses/data-science-ai-ml" class="btn-primary py-2 px-5 text-sm font-semibold whitespace-nowrap">Explore Course</a>
              <a href="/courses/data-science-ai-ml#inquiry-form" class="text-sm font-bold text-[#0B1F3A] hover:text-[#F47A16] transition-colors flex items-center gap-1 whitespace-nowrap">Request Details <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></a>
            </div>
          </div>

          <!-- 3. MERN Stack -->
          <div class="w-full h-full bg-white rounded-[24px] p-4 md:p-5 border border-[#10B981]/20 shadow-sm hover:shadow-lg transition-shadow relative overflow-hidden group flex flex-col gap-6">
            <div class="absolute top-0 right-0 w-24 h-24 bg-[#10B981]/5 rounded-bl-full -z-0 pointer-events-none"></div>
            
            <!-- Top: Large Image -->
            <div class="w-full aspect-[16/9] relative rounded-xl md:rounded-[18px] overflow-hidden shadow-sm bg-[#F0FDF4] z-10">
              <img 
                src="/images/courses/mern-stack-clean.png" 
                alt="MERN Stack Development Course Banner" 
                loading="lazy"
                width="2752"
                height="1264"
                class="w-full h-full object-contain object-center group-hover:scale-[1.02] transition-transform duration-500 block"
              />
            </div>

            <!-- Bottom: CTAs -->
            <div class="flex items-center justify-between gap-4 z-10 px-2 mt-auto">
              <a href="/courses/mern-stack" class="btn-primary py-2 px-5 text-sm font-semibold whitespace-nowrap">Explore Course</a>
              <a href="/courses/mern-stack#inquiry-form" class="text-sm font-bold text-[#0B1F3A] hover:text-[#10B981] transition-colors flex items-center gap-1 whitespace-nowrap">Request Details <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></a>
            </div>
          </div>
          
        </div>

        <!-- 4. Java Full Stack -->
        <div class="w-full h-full bg-white rounded-[24px] p-4 md:p-5 border border-red-500/20 shadow-sm hover:shadow-lg transition-shadow flex flex-col gap-6 md:col-span-1 lg:col-span-6 relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-32 h-32 bg-red-500/5 rounded-bl-full -z-0 pointer-events-none"></div>
          
          <!-- Promo Image -->
          <div class="w-full aspect-[16/9] relative rounded-xl md:rounded-[18px] overflow-hidden shadow-sm bg-[#FEF2F2] z-10">
            <img 
              src="/images/courses/java-full-stack-clean.png" 
              alt="Java Full Stack Development Course Banner" 
              loading="lazy"
              width="2752"
              height="1331"
              class="w-full h-full object-contain object-center group-hover:scale-[1.02] transition-transform duration-500 block"
            />
          </div>

          <!-- Bottom: CTAs -->
          <div class="flex items-center justify-between gap-4 z-10 px-2 mt-auto">
            <a href="/courses/java-full-stack" class="btn-primary py-2 px-5 text-sm font-semibold whitespace-nowrap">Explore Course</a>
            <a href="/courses/java-full-stack#inquiry-form" class="text-sm font-bold text-[#0B1F3A] hover:text-red-500 transition-colors flex items-center gap-1 whitespace-nowrap">Request Details <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></a>
          </div>
        </div>

        <!-- 5. Cloud & DevOps -->
        <div class="w-full h-full bg-white rounded-[24px] p-4 md:p-5 border border-sky-500/20 shadow-sm hover:shadow-lg transition-shadow flex flex-col gap-6 md:col-span-1 lg:col-span-6 relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-32 h-32 bg-sky-500/5 rounded-bl-full -z-0 pointer-events-none"></div>
          
          <!-- Promo Image -->
          <div class="w-full aspect-[16/9] relative rounded-xl md:rounded-[18px] overflow-hidden shadow-sm bg-[#F0F9FF] z-10">
            <img 
              src="/images/courses/cloud-devops-clean.png" 
              alt="Cloud & DevOps Course Banner" 
              loading="lazy"
              width="2752"
              height="1536"
              class="w-full h-full object-contain object-center group-hover:scale-[1.02] transition-transform duration-500 block"
            />
          </div>

          <!-- Bottom: CTAs -->
          <div class="flex items-center justify-between gap-4 z-10 px-2 mt-auto">
            <a href="/courses/cloud-devops" class="btn-primary py-2 px-5 text-sm font-semibold whitespace-nowrap">Explore Course</a>
            <a href="/courses/cloud-devops#inquiry-form" class="text-sm font-bold text-[#0B1F3A] hover:text-sky-500 transition-colors flex items-center gap-1 whitespace-nowrap">Request Details <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></a>
          </div>
        </div>
        
        <!-- 6. Banking -->
        <div class="w-full h-full bg-white rounded-[24px] p-4 md:p-5 border border-indigo-500/20 shadow-sm hover:shadow-lg transition-shadow flex flex-col gap-6 md:col-span-1 lg:col-span-6 relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-32 h-32 bg-indigo-500/5 rounded-bl-full -z-0 pointer-events-none"></div>
          
          <!-- Promo Image -->
          <div class="w-full aspect-[16/9] relative rounded-xl md:rounded-[18px] overflow-hidden shadow-sm bg-[#EEF2FF] z-10">
            <img 
              src="/images/courses/banking-clean.png" 
              alt="Banking Course Banner" 
              loading="lazy"
              width="2752"
              height="1536"
              class="w-full h-full object-contain object-center group-hover:scale-[1.02] transition-transform duration-500 block"
            />
          </div>

          <!-- Bottom: CTAs -->
          <div class="flex items-center justify-between gap-4 z-10 px-2 mt-auto">
            <a href="/courses/banking" class="btn-primary py-2 px-5 text-sm font-semibold whitespace-nowrap">Explore Course</a>
            <a href="/courses/banking#inquiry-form" class="text-sm font-bold text-[#0B1F3A] hover:text-indigo-500 transition-colors flex items-center gap-1 whitespace-nowrap">Request Details <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></a>
          </div>
        </div>

        <!-- 7. Digital Marketing -->
        <div class="w-full h-full bg-white rounded-[24px] p-4 md:p-5 border border-purple-500/20 shadow-sm hover:shadow-lg transition-shadow flex flex-col gap-6 md:col-span-1 lg:col-span-6 relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-32 h-32 bg-purple-500/5 rounded-bl-full -z-0 pointer-events-none"></div>
          
          <!-- Promo Image -->
          <div class="w-full aspect-[16/9] relative rounded-xl md:rounded-[18px] overflow-hidden shadow-sm bg-[#FAF5FF] z-10">
            <img 
              src="/images/courses/digital-marketing-clean.png" 
              alt="Digital Marketing Course Banner" 
              loading="lazy"
              width="2752"
              height="1536"
              class="w-full h-full object-contain object-center group-hover:scale-[1.02] transition-transform duration-500 block"
            />
          </div>

          <!-- Bottom: CTAs -->
          <div class="flex items-center justify-between gap-4 z-10 px-2 mt-auto">
            <a href="/courses/digital-marketing" class="btn-primary py-2 px-5 text-sm font-semibold whitespace-nowrap">Explore Course</a>
            <a href="/courses/digital-marketing#inquiry-form" class="text-sm font-bold text-[#0B1F3A] hover:text-purple-500 transition-colors flex items-center gap-1 whitespace-nowrap">Request Details <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- METHODOLOGY & PRACTICAL LEARNING -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-manrope font-bold text-[#0B1F3A] mb-4">How You Learn at Knowletive</h2>
        <p class="text-[#64748B] text-lg">Not just theory. Learn by doing through our structured practical approach.</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-16">
        <div class="bg-gray-50 p-4 rounded-xl text-center border border-gray-100">
          <div class="w-8 h-8 rounded-full bg-[#0878E8] text-white flex items-center justify-center font-bold mx-auto mb-3">1</div>
          <h4 class="font-bold text-[#0B1F3A] text-sm">Learn Fundamentals</h4>
        </div>
        <div class="bg-gray-50 p-4 rounded-xl text-center border border-gray-100">
          <div class="w-8 h-8 rounded-full bg-[#0878E8] text-white flex items-center justify-center font-bold mx-auto mb-3">2</div>
          <h4 class="font-bold text-[#0B1F3A] text-sm">Practice Concepts</h4>
        </div>
        <div class="bg-gray-50 p-4 rounded-xl text-center border border-gray-100">
          <div class="w-8 h-8 rounded-full bg-[#0878E8] text-white flex items-center justify-center font-bold mx-auto mb-3">3</div>
          <h4 class="font-bold text-[#0B1F3A] text-sm">Practical Assignments</h4>
        </div>
        <div class="bg-gray-50 p-4 rounded-xl text-center border border-gray-100">
          <div class="w-8 h-8 rounded-full bg-[#0878E8] text-white flex items-center justify-center font-bold mx-auto mb-3">4</div>
          <h4 class="font-bold text-[#0B1F3A] text-sm">Build Projects</h4>
        </div>
        <div class="bg-gray-50 p-4 rounded-xl text-center border border-gray-100">
          <div class="w-8 h-8 rounded-full bg-[#0878E8] text-white flex items-center justify-center font-bold mx-auto mb-3">5</div>
          <h4 class="font-bold text-[#0B1F3A] text-sm">Interview Prep</h4>
        </div>
        <div class="bg-gray-50 p-4 rounded-xl text-center border border-gray-100">
          <div class="w-8 h-8 rounded-full bg-[#F47A16] text-white flex items-center justify-center font-bold mx-auto mb-3">6</div>
          <h4 class="font-bold text-[#0B1F3A] text-sm">Career Ready</h4>
        </div>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-[#0878E8]/10 text-[#0878E8] flex items-center justify-center shrink-0 mt-1"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg></div>
          <div><h4 class="font-bold text-[#0B1F3A] mb-1">Hands-On Training</h4><p class="text-sm text-[#64748B]">Apply what you learn immediately through coding exercises and practical tasks.</p></div>
        </div>
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-[#0878E8]/10 text-[#0878E8] flex items-center justify-center shrink-0 mt-1"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg></div>
          <div><h4 class="font-bold text-[#0B1F3A] mb-1">Industry Case Studies</h4><p class="text-sm text-[#64748B]">Solve real business problems using modern technology stacks.</p></div>
        </div>
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-[#0878E8]/10 text-[#0878E8] flex items-center justify-center shrink-0 mt-1"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg></div>
          <div><h4 class="font-bold text-[#0B1F3A] mb-1">Mentor Support</h4><p class="text-sm text-[#64748B]">Get guidance from experienced professionals throughout your journey.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CAREER PATHS & SUPPORT -->
  <section class="section-padding bg-gray-50 border-t border-gray-200">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-16">
        
        <div>
          <h2 class="text-3xl font-manrope font-bold text-[#0B1F3A] mb-6">From Learning to Career Readiness</h2>
          <p class="text-[#64748B] mb-8">Our commitment goes beyond teaching. We prepare you for the job market.</p>
          
          <ul class="space-y-4">
            <li class="flex items-center gap-3"><div class="w-2 h-2 rounded-full bg-[#0878E8]"></div><span class="font-semibold text-[#0B1F3A]">Resume Building & LinkedIn Optimization</span></li>
            <li class="flex items-center gap-3"><div class="w-2 h-2 rounded-full bg-[#0878E8]"></div><span class="font-semibold text-[#0B1F3A]">Technical Interview Preparation</span></li>
            <li class="flex items-center gap-3"><div class="w-2 h-2 rounded-full bg-[#0878E8]"></div><span class="font-semibold text-[#0B1F3A]">HR Mock Interviews</span></li>
            <li class="flex items-center gap-3"><div class="w-2 h-2 rounded-full bg-[#0878E8]"></div><span class="font-semibold text-[#0B1F3A]">Portfolio Review</span></li>
            <li class="flex items-center gap-3"><div class="w-2 h-2 rounded-full bg-[#F47A16]"></div><span class="font-semibold text-[#0B1F3A]">Placement Assistance</span></li>
          </ul>
        </div>

        <div>
          <h2 class="text-3xl font-manrope font-bold text-[#0B1F3A] mb-6">Real-World Projects</h2>
          <p class="text-[#64748B] mb-8">Build a strong portfolio by working on projects that mimic industry requirements.</p>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
              <span class="text-xs text-[#0878E8] font-bold uppercase">Data Analysis</span>
